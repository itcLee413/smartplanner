<!-- ======================================================== -->
<!-- GLOBAL MINI FLOATING POMODORO TIMER & NOTION TEAM TOASTS -->
<!-- ======================================================== -->

<!-- 1. Floating Mini Pomodoro Bar (Top Right) -->
<div id="globalMiniTimer" class="global-mini-timer-wrapper" style="display: none;">
  <!-- Collapsed Bar Mode -->
  <div id="miniTimerCollapsed" class="mini-timer-bar">
    <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1" style="cursor: pointer;" onclick="toggleMiniTimerExpand(true)">
      <span id="miniTimerDot" class="mini-timer-dot running"></span>
      <span id="miniTimerTitleCollapsed" class="mini-timer-title-collapsed text-truncate" title="일반 집중 세션">일반 집중 세션</span>
      <span id="miniTimerDigitsCollapsed" class="mini-timer-digits-collapsed">25:00</span>
    </div>
    <div class="d-flex align-items-center gap-1 ms-2">
      <button type="button" class="mini-btn-icon" id="miniTimerToggleBtn" onclick="toggleMiniTimerPlayPause(event)" title="시작 / 일시정지">
        <i class="bi bi-pause-fill" id="miniTimerToggleIcon"></i>
      </button>
      <button type="button" class="mini-btn-icon" onclick="toggleMiniTimerExpand(true)" title="자세히 보기">
        <i class="bi bi-chevron-down"></i>
      </button>
    </div>
  </div>

  <!-- Expanded Card Mode -->
  <div id="miniTimerExpanded" class="mini-timer-card" style="display: none;">
    <div class="mini-timer-header">
      <div class="d-flex align-items-center gap-2 overflow-hidden">
        <i class="bi bi-stopwatch-fill text-primary"></i>
        <span id="miniTimerTitleExpanded" class="fw-semibold small text-truncate" style="max-width: 200px;">일반 집중 세션</span>
      </div>
      <button type="button" class="mini-btn-icon" onclick="toggleMiniTimerExpand(false)" title="축소하기">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>

    <div class="mini-timer-body text-center py-2">
      <div id="miniTimerDigitsExpanded" class="mini-timer-digits-expanded">25:00</div>
      <div class="mini-progress-track mb-2">
        <div id="miniTimerProgressBar" class="mini-progress-bar" style="width: 100%;"></div>
      </div>

      <!-- Quick Session Length Selection -->
      <div class="d-flex justify-content-center gap-1 mb-2">
        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 rounded" style="font-size: 11px;" onclick="resetMiniTimer(25)">25분</button>
        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 rounded" style="font-size: 11px;" onclick="resetMiniTimer(50)">50분</button>
        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 rounded" style="font-size: 11px;" onclick="resetMiniTimer(1)">1분(시연)</button>
      </div>

      <!-- Sound Selection -->
      <div class="d-flex align-items-center gap-1 justify-content-center mb-1">
        <label for="miniTimerSoundSelect" class="smaller text-muted"><i class="bi bi-volume-up"></i></label>
        <select id="miniTimerSoundSelect" class="form-select form-select-sm py-0 ps-1 pe-4" style="font-size: 11px; height: 24px; width: 140px;" onchange="updateMiniTimerSound(this.value)">
          <optgroup label="기본 알림음" id="miniTimerPresetGroup">
            <option value="chime">차임벨 (맑음)</option>
            <option value="alarm">디지털 알람</option>
            <option value="marimba">마림바 벨</option>
          </optgroup>
          <optgroup label="내 오디오 파일" id="miniTimerCustomGroup">
          </optgroup>
        </select>
        <button type="button" class="btn btn-sm btn-light border py-0 px-1" style="font-size: 11px; height: 24px;" onclick="previewMiniTimerSound()" title="미리듣기">🔊</button>
      </div>
    </div>

    <div class="mini-timer-footer d-flex align-items-center justify-content-between pt-2 border-top">
      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 12px; height: 28px;" onclick="resetMiniTimer()" title="초기화">
        <i class="bi bi-arrow-counterclockwise"></i> 초기화
      </button>
      <div class="d-flex gap-1">
        <button type="button" class="btn btn-sm btn-success py-0 px-2" style="font-size: 12px; height: 28px;" onclick="completeMiniTimerManually()">
          <i class="bi bi-check-lg me-1"></i>완료
        </button>
        <button type="button" class="btn btn-sm btn-primary py-0 px-3 fw-semibold" style="font-size: 12px; height: 28px;" id="miniTimerMainBtn" onclick="toggleMiniTimerPlayPause(event)">
          <i class="bi bi-pause-fill me-1" id="miniTimerMainIcon"></i><span id="miniTimerMainText">일시정지</span>
        </button>
      </div>
    </div>
  </div>
</div>

