<!-- ======================================================== -->
<!-- SCRIPTS: PERSISTENT POMODORO & TEAM ACTIVITY POLLING     -->
<!-- ======================================================== -->
<script>
(function() {
  // ----------------------------------------------------
  // A. Persistent Pomodoro Timer Engine
  // ----------------------------------------------------
  const STORAGE_KEY = 'pomodoroState';
  let timerInterval = null;
  let audioCtx = null;

  function getAudioContext() {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
      if (AudioCtxClass) {
        audioCtx = new AudioCtxClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // IndexedDB Custom Audio Storage Integration
  const AUDIO_DB_NAME = 'WebPlannerAudioDB';
  const AUDIO_STORE_NAME = 'custom_sounds';
  const AUDIO_DB_VERSION = 1;

  function openAudioDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(AUDIO_DB_NAME, AUDIO_DB_VERSION);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains(AUDIO_STORE_NAME)) {
          db.createObjectStore(AUDIO_STORE_NAME, { keyPath: 'id' });
        }
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function loadCustomSoundsIntoMiniTimer() {
    try {
      const db = await openAudioDB();
      const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
      const store = tx.objectStore(AUDIO_STORE_NAME);
      const req = store.getAll();

      req.onsuccess = () => {
        const sounds = req.result || [];
        const optgroup = document.getElementById('miniTimerCustomGroup');
        if (optgroup) {
          optgroup.innerHTML = '';
          sounds.forEach(sound => {
            const opt = document.createElement('option');
            opt.value = `custom_${sound.id}`;
            opt.textContent = `📁 ${sound.name}`;
            optgroup.appendChild(opt);
          });
        }

        // Restore saved selection
        const state = loadPomodoroState();
        let savedSound = (state && state.selectedSound) || localStorage.getItem('webplanner_pomodoro_sound');
        if (savedSound === 'chime1') savedSound = 'chime';
        if (savedSound === 'digital') savedSound = 'alarm';
        const sel = document.getElementById('miniTimerSoundSelect');
        if (sel && savedSound) {
          const hasOption = Array.from(sel.options).some(o => o.value === savedSound);
          if (hasOption) {
            sel.value = savedSound;
          }
        }
      };
    } catch (err) {
      console.warn('Failed to load custom sounds into mini timer:', err);
    }
  }
  window.loadCustomSoundsIntoMiniTimer = loadCustomSoundsIntoMiniTimer;

  // Web Audio API Preset Sounds
  function playPresetSound(type) {
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const now = ctx.currentTime;

      if (type === 'digital' || type === 'alarm') {
        // Digital Alarm Beep (3 quick beeps)
        for (let i = 0; i < 3; i++) {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(880, now + i * 0.15);
          gain.gain.setValueAtTime(0.2, now + i * 0.15);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.15 + 0.1);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + i * 0.15);
          osc.stop(now + i * 0.15 + 0.1);
        }
      } else if (type === 'marimba') {
        // Marimba Bell (warm wood chord)
        const freqs = [440, 554.37, 659.25];
        freqs.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          gain.gain.setValueAtTime(0.3, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.8);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.8);
        });
      } else {
        // Soft Chime (C5 -> E5 -> G5)
        const notes = [523.25, 659.25, 783.99];
        notes.forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + i * 0.18);
          gain.gain.setValueAtTime(0.25, now + i * 0.18);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.18 + 1.2);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + i * 0.18);
          osc.stop(now + i * 0.18 + 1.2);
        });
      }
    } catch (e) {
      console.warn('Audio playback error:', e);
    }
  }

  async function playCustomAudio(customId) {
    return new Promise(async (resolve) => {
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
        const req = tx.objectStore(AUDIO_STORE_NAME).get(customId);
        req.onsuccess = () => {
          const record = req.result;
          if (record && record.data) {
            const blob = new Blob([record.data], { type: record.type || 'audio/mpeg' });
            const url = URL.createObjectURL(blob);
            const audio = new Audio(url);
            audio.onended = () => {
              URL.revokeObjectURL(url);
              resolve();
            };
            audio.play().catch(e => {
              console.warn('Custom audio playback failed, fallback to preset chime:', e);
              playPresetSound('chime');
              resolve();
            });
          } else {
            playPresetSound('chime');
            resolve();
          }
        };
        req.onerror = () => {
          playPresetSound('chime');
          resolve();
        };
      } catch (e) {
        playPresetSound('chime');
        resolve();
      }
    });
  }

  async function playPomodoroSound(soundKey) {
    if (!soundKey) soundKey = 'chime';
    if (soundKey === 'chime1') soundKey = 'chime';
    if (soundKey === 'digital') soundKey = 'alarm';

    if (soundKey.startsWith('custom_')) {
      const id = parseInt(soundKey.replace('custom_', ''), 10);
      await playCustomAudio(id);
    } else {
      playPresetSound(soundKey);
    }
  }
  window.playPomodoroSound = playPomodoroSound;

  window.previewMiniTimerSound = async function() {
    getAudioContext();
    const sel = document.getElementById('miniTimerSoundSelect');
    const sound = sel ? sel.value : 'chime';
    await playPomodoroSound(sound);
  };

  // State Management
  function loadPomodoroState() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return null;
      return JSON.parse(saved);
    } catch (e) {
      return null;
    }
  }

  function savePomodoroState(state) {
    try {
      if (!state) {
        localStorage.removeItem(STORAGE_KEY);
      } else {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }
      window.dispatchEvent(new CustomEvent('pomodoroTick', {
        detail: state ? {
          remainingSeconds: (state.isRunning && state.endTime) ? Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000)) : state.remainingSeconds,
          isRunning: state.isRunning,
          state
        } : null
      }));
    } catch (e) {
      console.warn('Storage save error:', e);
    }
  }

  function formatTime(seconds) {
    const s = Math.max(0, Math.floor(seconds));
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
  }

  function renderTimerUI() {
    const state = loadPomodoroState();
    const wrapper = document.getElementById('globalMiniTimer');
    if (!wrapper) return;

    if (!state || (state.remainingSeconds <= 0 && !state.isRunning)) {
      wrapper.style.display = 'none';
      return;
    }

    wrapper.style.display = 'block';

    // Calculate current seconds
    let currentSeconds = state.remainingSeconds;
    if (state.isRunning && state.endTime) {
      currentSeconds = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
    }

    const timeStr = formatTime(currentSeconds);
    const title = state.scheduleTitle || '일반 집중 세션';

    // Titles
    const tColl = document.getElementById('miniTimerTitleCollapsed');
    if (tColl) {
      tColl.textContent = title;
      tColl.title = title;
    }
    const tExp = document.getElementById('miniTimerTitleExpanded');
    if (tExp) {
      tExp.textContent = title;
      tExp.title = title;
    }

    // Digits
    const dColl = document.getElementById('miniTimerDigitsCollapsed');
    if (dColl) dColl.textContent = timeStr;
    const dExp = document.getElementById('miniTimerDigitsExpanded');
    if (dExp) dExp.textContent = timeStr;

    // Status Dot
    const dot = document.getElementById('miniTimerDot');
    if (dot) {
      dot.className = 'mini-timer-dot ' + (state.isRunning ? 'running' : 'paused');
    }

    // Play/Pause Icons
    const toggleIcon = document.getElementById('miniTimerToggleIcon');
    if (toggleIcon) {
      toggleIcon.className = state.isRunning ? 'bi bi-pause-fill' : 'bi bi-play-fill';
    }
    const mainIcon = document.getElementById('miniTimerMainIcon');
    const mainText = document.getElementById('miniTimerMainText');
    if (mainIcon && mainText) {
      mainIcon.className = state.isRunning ? 'bi bi-pause-fill me-1' : 'bi bi-play-fill me-1';
      mainText.textContent = state.isRunning ? '일시정지' : '시작';
    }

    // Sound selection sync
    const sel = document.getElementById('miniTimerSoundSelect');
    if (sel && state.selectedSound) {
      sel.value = state.selectedSound;
    }

    // Progress Bar
    const totalSec = (state.durationMinutes || 25) * 60;
    const percent = Math.min(100, Math.max(0, Math.round((currentSeconds / totalSec) * 100)));
    const bar = document.getElementById('miniTimerProgressBar');
    if (bar) {
      bar.style.width = percent + '%';
    }

    // Expanded vs Collapsed view
    const collEl = document.getElementById('miniTimerCollapsed');
    const expEl = document.getElementById('miniTimerExpanded');
    if (collEl && expEl) {
      if (state.isExpanded) {
        collEl.style.display = 'none';
        expEl.style.display = 'block';
      } else {
        collEl.style.display = 'flex';
        expEl.style.display = 'none';
      }
    }
  }

  function tick() {
    const state = loadPomodoroState();
    if (!state) {
      clearInterval(timerInterval);
      timerInterval = null;
      renderTimerUI();
      window.dispatchEvent(new CustomEvent('pomodoroTick', { detail: null }));
      return;
    }

    if (state.isRunning && state.endTime) {
      const remaining = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
      if (remaining <= 0) {
        // Complete!
        onTimerComplete();
        return;
      }
      renderTimerUI();
      window.dispatchEvent(new CustomEvent('pomodoroTick', {
        detail: { remainingSeconds: remaining, isRunning: true, state }
      }));
    } else {
      renderTimerUI();
      window.dispatchEvent(new CustomEvent('pomodoroTick', {
        detail: { remainingSeconds: state.remainingSeconds, isRunning: false, state }
      }));
    }
  }

  function startTimerLoop() {
    if (!timerInterval) {
      tick();
      timerInterval = setInterval(tick, 500);
    }
  }

  function onTimerComplete() {
    clearInterval(timerInterval);
    timerInterval = null;

    const state = loadPomodoroState();
    const sound = (state && state.selectedSound) || localStorage.getItem('webplanner_pomodoro_sound') || 'chime';
    playPomodoroSound(sound);

    const schedId = state ? state.scheduleId : null;
    const schedTitle = state ? state.scheduleTitle : '일반 집중 세션';
    const duration = state ? (state.durationMinutes || 25) : 25;

    // Send API fetch
    if (schedId) {
      fetch('/schedules/' + schedId + '/focus', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ minutes: duration })
      }).catch(err => console.warn('Focus sync error:', err));
    } else {
      fetch('/focus/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ minutes: duration, title: schedTitle })
      }).catch(err => console.warn('Focus sync error:', err));
    }

    // Reset State
    savePomodoroState(null);
    renderTimerUI();

    window.dispatchEvent(new CustomEvent('pomodoroCompleted', {
      detail: { schedId, schedTitle, duration }
    }));

    // Alert
    alert('🎉 [' + schedTitle + '] 집중 세션이 완료되었습니다!\n잠시 휴식을 취하세요.');
  }

  window.pauseGlobalPomodoro = function() {
    const state = loadPomodoroState();
    if (!state || !state.isRunning) return;
    const remaining = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
    state.isRunning = false;
    state.remainingSeconds = remaining;
    state.endTime = null;
    savePomodoroState(state);
    renderTimerUI();
  };

  window.resumeGlobalPomodoro = function() {
    getAudioContext();
    const state = loadPomodoroState();
    if (!state || state.isRunning) return;
    state.isRunning = true;
    state.endTime = Date.now() + (state.remainingSeconds * 1000);
    savePomodoroState(state);
    renderTimerUI();
    startTimerLoop();
  };

  window.resetGlobalPomodoro = function(newMinutes) {
    if (!newMinutes) {
      clearInterval(timerInterval);
      timerInterval = null;
      savePomodoroState(null);
      renderTimerUI();
      return;
    }

    const state = loadPomodoroState();
    const duration = newMinutes || 25;
    const title = state ? state.scheduleTitle : '일반 집중 세션';
    const schedId = state ? state.scheduleId : null;
    const sound = state ? state.selectedSound : 'chime1';

    const newState = {
      scheduleId: schedId,
      scheduleTitle: title,
      durationMinutes: duration,
      endTime: Date.now() + (duration * 60 * 1000),
      remainingSeconds: duration * 60,
      isRunning: true,
      isExpanded: false,
      selectedSound: sound
    };

    savePomodoroState(newState);
    renderTimerUI();
    startTimerLoop();
  };

  window.getPomodoroState = loadPomodoroState;

  window.toggleMiniTimerPlayPause = function(event) {
    if (event) event.stopPropagation();
    getAudioContext();

    const state = loadPomodoroState();
    if (!state) return;

    if (state.isRunning) {
      window.pauseGlobalPomodoro();
    } else {
      window.resumeGlobalPomodoro();
    }
  };

  window.toggleMiniTimerExpand = function(expand) {
    const state = loadPomodoroState();
    if (!state) return;
    state.isExpanded = !!expand;
    savePomodoroState(state);
    renderTimerUI();
  };

  window.resetMiniTimer = function(newMinutes) {
    window.resetGlobalPomodoro(newMinutes);
  };

  window.completeMiniTimerManually = function() {
    if (confirm('현재 집중 세션을 완료 처리하시겠습니까? 누적 시간이 기록됩니다.')) {
      onTimerComplete();
    }
  };

  window.updateMiniTimerSound = function(soundVal) {
    const state = loadPomodoroState();
    if (state) {
      state.selectedSound = soundVal;
      savePomodoroState(state);
    }
    localStorage.setItem('webplanner_pomodoro_sound', soundVal);
    const sel = document.getElementById('miniTimerSoundSelect');
    if (sel && sel.value !== soundVal) {
      sel.value = soundVal;
    }
    const dashboardSel = document.getElementById('pomodoroSoundSelect');
    if (dashboardSel && dashboardSel.value !== soundVal) {
      dashboardSel.value = soundVal;
    }
  };

  // Global Start Trigger (can be invoked from index.ejs or any schedule button)
  window.startGlobalPomodoro = function(scheduleId, title, minutes) {
    getAudioContext();
    const dur = minutes || 25;
    const existing = loadPomodoroState();
    const sound = (existing && existing.selectedSound) || localStorage.getItem('webplanner_pomodoro_sound') || 'chime';
    const state = {
      scheduleId: scheduleId || null,
      scheduleTitle: title || '일반 집중 세션',
      durationMinutes: dur,
      endTime: Date.now() + (dur * 60 * 1000),
      remainingSeconds: dur * 60,
      isRunning: true,
      isExpanded: false,
      selectedSound: sound
    };
    savePomodoroState(state);
    renderTimerUI();
    startTimerLoop();
  };

  // ----------------------------------------------------
  // B. Real-time Team Activity Toast Engine (teamschedule.md)
  // ----------------------------------------------------
  const TOAST_SEEN_KEY = 'seenTeamUpdates_v1';

  function getSeenUpdateIds() {
    try {
      const data = sessionStorage.getItem(TOAST_SEEN_KEY);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      return [];
    }
  }

  function addSeenUpdateId(id) {
    try {
      const seen = getSeenUpdateIds();
      if (!seen.includes(id)) {
        seen.push(id);
        if (seen.length > 50) seen.shift();
        sessionStorage.setItem(TOAST_SEEN_KEY, JSON.stringify(seen));
      }
    } catch (e) {}
  }

  function showTeamToast(update) {
    const container = document.getElementById('teamToastContainer');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'team-toast-item ' + (update.type === 'NOTE' ? 'type-note' : 'type-schedule');

    // Header: Badge & Close Button
    const header = document.createElement('div');
    header.className = 'd-flex align-items-center justify-content-between mb-1';

    const leftBadge = document.createElement('div');
    leftBadge.className = 'd-flex align-items-center gap-1';
    leftBadge.innerHTML = '<span class="badge bg-light text-dark border py-0 px-1" style="font-size: 11px;">' +
      (update.teamName || '팀') + '</span>' +
      '<span class="badge ' + (update.type === 'NOTE' ? 'bg-warning-subtle text-dark' : 'bg-primary-subtle text-primary') + ' py-0 px-1" style="font-size: 11px;">' +
      (update.type === 'NOTE' ? '특이사항' : '새 일정') + '</span>';

    const closeBtnX = document.createElement('button');
    closeBtnX.type = 'button';
    closeBtnX.className = 'btn-close';
    closeBtnX.style.fontSize = '10px';
    closeBtnX.title = '닫기';
    closeBtnX.onclick = function() { removeToast(toast); };

    header.appendChild(leftBadge);
    header.appendChild(closeBtnX);

    // Message Body: Safe textContent
    const body = document.createElement('div');
    body.className = 'my-2';

    const authorLine = document.createElement('div');
    authorLine.className = 'small fw-bold text-dark';
    const actionDesc = update.type === 'NOTE' ? '님이 새 특이사항을 공유했습니다.' : '님이 새로운 일정을 등록했습니다.';
    authorLine.textContent = (update.authorName || '팀원') + '(' + (update.authorPosition || '팀원') + ')' + actionDesc;

    const titleLine = document.createElement('div');
    titleLine.className = 'small text-secondary text-truncate mt-1';
    titleLine.style.maxWidth = '320px';
    titleLine.textContent = '• ' + (update.title || '');

    body.appendChild(authorLine);
    body.appendChild(titleLine);

    // Footer Buttons (2 split buttons)
    const footer = document.createElement('div');
    footer.className = 'd-flex align-items-center justify-content-end gap-2 pt-2 border-top';

    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'team-toast-btn-close';
    closeBtn.textContent = '닫기';
    closeBtn.onclick = function() { removeToast(toast); };

    const moveBtn = document.createElement('a');
    moveBtn.href = '/teams?teamId=' + encodeURIComponent(update.teamId);
    moveBtn.className = 'team-toast-btn-action';
    moveBtn.innerHTML = '<i class="bi bi-arrow-right-short"></i> 팀 워크스페이스 이동';

    footer.appendChild(closeBtn);
    footer.appendChild(moveBtn);

    toast.appendChild(header);
    toast.appendChild(body);
    toast.appendChild(footer);

    container.appendChild(toast);

    // 8-second auto dismiss with hover pause
    let remainingTime = 8000;
    let dismissTimeout = null;
    let startTime = Date.now();

    function startDismissTimer() {
      startTime = Date.now();
      dismissTimeout = setTimeout(function() {
        removeToast(toast);
      }, remainingTime);
    }

    function pauseDismissTimer() {
      if (dismissTimeout) {
        clearTimeout(dismissTimeout);
        dismissTimeout = null;
        remainingTime -= (Date.now() - startTime);
      }
    }

    toast.addEventListener('mouseenter', pauseDismissTimer);
    toast.addEventListener('mouseleave', function() {
      if (remainingTime > 500) {
        startDismissTimer();
      } else {
        removeToast(toast);
      }
    });

    startDismissTimer();
  }

  function removeToast(toastEl) {
    if (!toastEl || !toastEl.parentNode) return;
    toastEl.style.opacity = '0';
    toastEl.style.transform = 'translateY(16px)';
    setTimeout(function() {
      if (toastEl.parentNode) {
        toastEl.parentNode.removeChild(toastEl);
      }
    }, 250);
  }

  function pollTeamUpdates() {
    fetch('/api/teams/recent-updates')
      .then(res => {
        if (!res.ok) return null;
        return res.json();
      })
      .then(data => {
        if (!data || !data.updates || data.updates.length === 0) return;
        const seen = getSeenUpdateIds();

        // If first visit, record all existing so we only show newly added ones going forward
        if (!sessionStorage.getItem('toastInitialized')) {
          sessionStorage.setItem('toastInitialized', 'true');
          data.updates.forEach(u => addSeenUpdateId(u.type + '_' + u.id));
          return;
        }

        // Show newest unseen updates (up to 2 at once)
        let shownCount = 0;
        data.updates.forEach(u => {
          const key = u.type + '_' + u.id;
          if (!seen.includes(key) && shownCount < 2) {
            addSeenUpdateId(key);
            showTeamToast(u);
            shownCount++;
          }
        });
      })
      .catch(err => {
        // silent fail on network glitch
      });
  }

  // ----------------------------------------------------
  // C. Notion-Style Custom Modal Engine (Alert & Confirm)
  // ----------------------------------------------------
  let modalResolve = null;

  window.showAlert = function(message, title) {
    return new Promise(resolve => {
      const modal = document.getElementById('notionCustomModal');
      const titleEl = document.getElementById('notionModalTitleText');
      const iconEl = document.getElementById('notionModalIcon');
      const msgEl = document.getElementById('notionModalMessage');
      const cancelBtn = document.getElementById('notionModalCancelBtn');
      const confirmBtn = document.getElementById('notionModalConfirmBtn');

      if (!modal) {
        window.alert(message);
        return resolve(true);
      }

      titleEl.textContent = title || '알림';
      iconEl.className = 'bi bi-info-circle-fill text-primary';
      msgEl.textContent = message;
      cancelBtn.style.display = 'none';
      confirmBtn.className = 'notion-dialog-btn confirm';
      confirmBtn.textContent = '확인';

      modalResolve = () => {
        modal.classList.remove('active');
        modalResolve = null;
        resolve(true);
      };

      modal.classList.add('active');
    });
  };

  window.showConfirm = function(message, title) {
    return new Promise(resolve => {
      const modal = document.getElementById('notionCustomModal');
      const titleEl = document.getElementById('notionModalTitleText');
      const iconEl = document.getElementById('notionModalIcon');
      const msgEl = document.getElementById('notionModalMessage');
      const cancelBtn = document.getElementById('notionModalCancelBtn');
      const confirmBtn = document.getElementById('notionModalConfirmBtn');

      if (!modal) {
        return resolve(window.confirm(message));
      }

      titleEl.textContent = title || '확인';
      iconEl.className = 'bi bi-exclamation-triangle-fill text-warning';
      msgEl.textContent = message;
      cancelBtn.style.display = 'inline-block';
      confirmBtn.className = 'notion-dialog-btn confirm';
      confirmBtn.textContent = '확인';

      const handleConfirm = () => {
        cleanup();
        resolve(true);
      };

      const handleCancel = () => {
        cleanup();
        resolve(false);
      };

      function cleanup() {
        modal.classList.remove('active');
        confirmBtn.removeEventListener('click', handleConfirm);
        cancelBtn.removeEventListener('click', handleCancel);
        modalResolve = null;
      }

      confirmBtn.addEventListener('click', handleConfirm);
      cancelBtn.addEventListener('click', handleCancel);

      modal.classList.add('active');
    });
  };

  // Wire Modal Confirm Button default click
  const defaultConfirmBtn = document.getElementById('notionModalConfirmBtn');
  if (defaultConfirmBtn) {
    defaultConfirmBtn.addEventListener('click', () => {
      if (modalResolve) modalResolve();
    });
  }

  // Override window.alert
  window.alert = function(msg) {
    showAlert(msg);
  };

  // Global onsubmit confirm interceptor for native forms
  document.addEventListener('submit', function(e) {
    const form = e.target;
    const onsubmitAttr = form.getAttribute('onsubmit');
    if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
      e.preventDefault();
      e.stopImmediatePropagation();

      // Extract confirm message
      const match = onsubmitAttr.match(/confirm\((['"])(.*?)\1\)/);
      const msg = match ? match[2] : '작업을 계속 진행하시겠습니까?';

      showConfirm(msg).then(confirmed => {
        if (confirmed) {
          form.removeAttribute('onsubmit');
          form.submit();
        }
      });
    }
  }, true);

  // Global click confirm interceptor for elements with onclick confirm
  document.addEventListener('click', function(e) {
    const target = e.target.closest('[onclick*="confirm("]');
    if (target) {
      const onclickAttr = target.getAttribute('onclick');
      if (onclickAttr && onclickAttr.includes('confirm(')) {
        e.preventDefault();
        e.stopImmediatePropagation();
        const match = onclickAttr.match(/confirm\((['"])(.*?)\1\)/);
        const msg = match ? match[2] : '작업을 계속 진행하시겠습니까?';
        showConfirm(msg).then(confirmed => {
          if (confirmed) {
            target.removeAttribute('onclick');
            target.click();
          }
        });
      }
    }
  }, true);

  // ----------------------------------------------------
  // D. Sidebar Collapse & Expand (Hamburger)
  // ----------------------------------------------------
  window.toggleSidebar = function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    if (sidebar && backdrop) {
      sidebar.classList.toggle('show');
      backdrop.classList.toggle('show');
    }
