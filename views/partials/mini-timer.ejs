  function applySavedSidebarState() {
    try {
      if (localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth >= 992) {
        const wrapper = document.querySelector('.app-wrapper');
        if (wrapper) wrapper.classList.add('sidebar-collapsed');
      }
    } catch (e) {}
  }

  // ----------------------------------------------------
  // E. Notion-Style Context Menu Engine
  // ----------------------------------------------------
  let currentCtxSchedule = null;

  window.openScheduleContextMenu = function(e, schedData) {
    e.preventDefault();
    e.stopPropagation();

    currentCtxSchedule = schedData;
    const menu = document.getElementById('notionContextMenu');
    if (!menu) return;

    const titleEl = document.getElementById('ctxScheduleTitle');
    if (titleEl) {
      titleEl.textContent = schedData.title ? (schedData.title.slice(0, 18) + (schedData.title.length > 18 ? '...' : '')) : '일정 관리';
    }

    // Position Menu
    menu.style.display = 'block';
    const menuWidth = 190;
    const menuHeight = 220;

    let posX = e.clientX;
    let posY = e.clientY;

    if (posX + menuWidth > window.innerWidth) {
      posX = window.innerWidth - menuWidth - 10;
    }
    if (posY + menuHeight > window.innerHeight) {
      posY = window.innerHeight - menuHeight - 10;
    }

    menu.style.left = posX + 'px';
    menu.style.top = posY + 'px';
  };

  function closeContextMenu() {
    const menu = document.getElementById('notionContextMenu');
    if (menu) menu.style.display = 'none';
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('#notionContextMenu')) {
      closeContextMenu();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeContextMenu();
    }
  });

  // Context Menu Actions
  document.addEventListener('DOMContentLoaded', function() {
    const editBtn = document.getElementById('ctxActionEdit');
    if (editBtn) {
      editBtn.addEventListener('click', function() {
        closeContextMenu();
        if (!currentCtxSchedule) return;
        if (typeof openEditModalForScheduleId === 'function') {
          openEditModalForScheduleId(currentCtxSchedule.id);
        } else {
          const modalEl = document.getElementById('editModal' + currentCtxSchedule.id);
          if (modalEl && typeof bootstrap !== 'undefined') {
            const m = new bootstrap.Modal(modalEl);
            m.show();
          } else {
            showAlert('수정 화면을 찾을 수 없습니다.');
          }
        }
      });
    }

    const shareBtn = document.getElementById('ctxActionShare');
    if (shareBtn) {
      shareBtn.addEventListener('click', function() {
        closeContextMenu();
        if (!currentCtxSchedule) return;
        openQuickShareModal(currentCtxSchedule.id, currentCtxSchedule.title);
      });
    }

    // Status Change in Context Menu (stastics.md 3번: 비동기 fetch 요청 및 캘린더 뷰 유지)
    ['TODO', 'IN_PROGRESS', 'DONE'].forEach(st => {
      const btn = document.getElementById('ctxStatus' + (st === 'IN_PROGRESS' ? 'InProgress' : (st === 'TODO' ? 'Todo' : 'Done')));
      if (btn) {
        btn.addEventListener('click', function() {
          closeContextMenu();
          if (!currentCtxSchedule) return;
          const scheduleId = currentCtxSchedule.id;

          fetch('/schedules/' + scheduleId + '/status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ status: st })
          })
          .then(res => res.json())
          .then(data => {
            if (data && data.success) {
              currentCtxSchedule.status = st;

              // 1. userSchedules 전역 데이터 갱신
              if (typeof userSchedules !== 'undefined') {
                const target = userSchedules.find(x => String(x.id) === String(scheduleId));
                if (target) target.status = st;
              }

              // 2. 캘린더 칩 실시간 갱신 (캘린더 탭 유지!)
              if (typeof renderCalendar === 'function') {
                renderCalendar();
              }

              // 3. 칸반 보드 백그라운드 동기화
              if (typeof syncScheduleStatusInKanban === 'function') {
                syncScheduleStatusInKanban(scheduleId, st);
              }

              // 4. 생산성 통계 도넛 차트 즉시 갱신 (stastics.md 1번)
              if (typeof refreshProductivityStats === 'function') {
                refreshProductivityStats(data.stats);
              }
            } else {
              if (typeof showAlert === 'function') {
                showAlert((data && data.error) || '상태 변경에 실패했습니다.');
              } else {
                alert((data && data.error) || '상태 변경에 실패했습니다.');
              }
            }
          })
          .catch(err => {
            console.error('Context menu status update error:', err);
            if (typeof showAlert === 'function') {
              showAlert('상태 변경 중 통신 오류가 발생했습니다.');
            }
          });
        });
      }
    });

    const delBtn = document.getElementById('ctxActionDelete');
    if (delBtn) {
      delBtn.addEventListener('click', function() {
        closeContextMenu();
        if (!currentCtxSchedule) return;
        showConfirm('정말로 이 일정을 삭제하시겠습니까?', '일정 삭제').then(ok => {
          if (ok) {
            const f = document.createElement('form');
            f.method = 'POST';
            f.action = '/schedules/' + currentCtxSchedule.id + '/delete';
            document.body.appendChild(f);
            f.submit();
          }
        });
      });
    }
  });

  window.openQuickShareModal = function(scheduleId, scheduleTitle) {
    const form = document.getElementById('quickShareTeamForm');
    const select = document.getElementById('quickShareTeamSelect');
    if (!form || !select) return;

    form.action = '/schedules/' + scheduleId + '/share-to-team';

    // Populate user's teams from global or DOM
    select.innerHTML = '<option value="">소속 팀을 선택하세요</option>';
    const teamOptions = document.querySelectorAll('select[name="target_workspace"] optgroup option');
    if (teamOptions.length > 0) {
      teamOptions.forEach(opt => {
        const teamId = opt.value.replace('team_', '');
        const optEl = document.createElement('option');
        optEl.value = teamId;
        optEl.textContent = opt.textContent;
        select.appendChild(optEl);
      });
    } else {
      // Fallback: check if myTeams in window
      if (window.USER_TEAMS && window.USER_TEAMS.length > 0) {
        window.USER_TEAMS.forEach(t => {
          const optEl = document.createElement('option');
          optEl.value = t.id;
          optEl.textContent = '[팀] ' + t.name;
          select.appendChild(optEl);
        });
      }
    }

    const modalEl = document.getElementById('quickShareTeamModal');
    if (modalEl && typeof bootstrap !== 'undefined') {
      const m = new bootstrap.Modal(modalEl);
      m.show();
    }
  };

  // ----------------------------------------------------
  // Initialization on DOM Ready
  // ----------------------------------------------------
  document.addEventListener('DOMContentLoaded', function() {
    applySavedSidebarState();

    // 0. Load Custom Sounds into Mini Timer
    loadCustomSoundsIntoMiniTimer();

    // 1. Init Pomodoro
    const state = loadPomodoroState();
    if (state) {
      if (state.isRunning && state.endTime) {
        const remaining = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
        if (remaining <= 0) {
          onTimerComplete();
        } else {
          renderTimerUI();
          startTimerLoop();
        }
      } else {
        renderTimerUI();
      }
    }

    // 2. Init Team Updates Polling (Every 6 seconds)
    pollTeamUpdates();
    setInterval(pollTeamUpdates, 6000);
  });
})();
</script>