<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>시스템 관리자 통합 관제 - WorkSmarter</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="app-wrapper">
    <!-- ========================================== -->
    <!-- 1. Notion-Style Left Fixed Sidebar         -->
    <!-- ========================================== -->
    <aside class="notion-sidebar" id="appSidebar">
      <!-- Sidebar Brand -->
      <div class="sidebar-brand-box d-flex align-items-center justify-content-between">
        <a href="/" class="navbar-brand-custom text-decoration-none">
          <i class="bi bi-calendar2-check-fill text-primary"></i>
          <span>WorkSmarter</span>
        </a>
        <button class="btn btn-sm btn-light" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- User Profile Box -->
      <div class="sidebar-user-box d-flex align-items-center gap-2">
        <div class="sidebar-avatar">
          <%= user.name.charAt(0) %>
        </div>
        <div class="overflow-hidden">
          <div class="fw-bold small text-truncate"><%= user.name %></div>
          <div class="text-muted smaller text-truncate">@<%= user.username %> · <span class="badge bg-danger text-white py-0 px-1"><%= user.role %></span></div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="p-2 flex-grow-1">
        <div class="sidebar-section-title">개인 워크스페이스</div>
        <a href="/" class="sidebar-link <%= activeMenu === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>내 대시보드</span>
        </a>
        <a href="/notes" class="sidebar-link <%= activeMenu === 'notes' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-text"></i>
          <span>세부사항 / 문서함</span>
        </a>
        <a href="/mypage" class="sidebar-link <%= activeMenu === 'mypage' ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span>마이페이지</span>
        </a>

        <div class="sidebar-section-title pt-3">팀 협업 공간</div>
        <a href="/teams" class="sidebar-link <%= activeMenu === 'teams' ? 'active' : '' %>">
          <i class="bi bi-people-fill text-primary"></i>
          <span>팀 워크스페이스</span>
          <span class="badge bg-primary text-white ms-auto rounded-pill px-2">Team</span>
        </a>

        <% if (user.role === 'ADMIN') { %>
          <div class="sidebar-section-title pt-3">시스템 관제</div>
          <a href="/admin" class="sidebar-link <%= activeMenu === 'admin' ? 'active' : '' %>">
            <i class="bi bi-shield-lock-fill text-warning"></i>
            <span>관리자 콘솔</span>
          </a>
        <% } %>
      </div>

      <!-- Sidebar Footer (Logout) -->
      <div class="sidebar-footer">
        <a href="/logout" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
          <i class="bi bi-box-arrow-right"></i>
          <span>로그아웃</span>
        </a>
      </div>
    </aside>

    <!-- Mobile Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarCollapse()"></div>

    <!-- ========================================== -->
    <!-- 2. Main Content Area                       -->
    <!-- ========================================== -->
    <div class="app-main-content">
      <!-- Top Mobile & Status Bar -->
      <header class="d-flex align-items-center justify-content-between px-4 py-2 border-bottom bg-white sticky-top">
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
            <i class="bi bi-list fs-5"></i>
          </button>
          <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock-fill text-warning"></i> 관리자 통합 관제 콘솔
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div id="headerMiniTimerSlot" class="d-flex align-items-center"></div>
          <%- include('partials/notification-dropdown') %>
          <!-- Realtime 24h Clock (third.md 1번) -->
          <%- include('partials/header-clock') %>
        </div>
      </header>

      <!-- Global Alerts -->
      <div class="container-fluid px-4 mt-3">
        <% if (errorMsg) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><%= errorMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <% if (successMsg) { %>
          <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><%= successMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      </div>

      <!-- Main Container -->
      <main class="container-fluid px-4 py-3 flex-grow-1">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
          <div>
            <h4 class="fw-bold mb-1">통합 시스템 관제 및 환경설정 대시보드</h4>
            <p class="text-muted small mb-0">서버 운영 KPI 모니터링, API 키 실시간 관리, 전체 공지 발송 및 회원 관리를 수행합니다.</p>
          </div>
          <span class="badge bg-secondary">EC2 Ubuntu Seoul / Asia/Seoul</span>
        </div>

        <!-- ======================================================== -->
        <!-- 1. KPI Summary 4 Cards                                   -->
        <!-- ======================================================== -->
        <div class="row g-3 mb-4">
          <!-- Card 1: Total Users -->
          <div class="col-xl-3 col-sm-6">
            <div class="card card-custom p-3 border-start border-primary border-4 shadow-sm">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold">총 등록 회원 수</span>
                  <h3 class="fw-bold text-dark mt-1 mb-0"><%= kpis.totalUsers %>명</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                  <i class="bi bi-people-fill fs-4"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Total Schedules -->
          <div class="col-xl-3 col-sm-6">
            <div class="card card-custom p-3 border-start border-success border-4 shadow-sm">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold">등록된 총 일정 수</span>
                  <h3 class="fw-bold text-dark mt-1 mb-0"><%= kpis.totalSchedules %>개</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                  <i class="bi bi-calendar2-check-fill fs-4"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3: Today's Notification Count -->
          <div class="col-xl-3 col-sm-6">
            <div class="card card-custom p-3 border-start border-warning border-4 shadow-sm">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold">오늘 발송된 알림 로그</span>
                  <h3 class="fw-bold text-dark mt-1 mb-0"><%= kpis.todayAlerts %>건</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                  <i class="bi bi-bell-fill fs-4"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 4: Telegram Connected Users -->
          <div class="col-xl-3 col-sm-6">
            <div class="card card-custom p-3 border-start border-info border-4 shadow-sm">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold">텔레그램 연동 회원 수</span>
                  <h3 class="fw-bold text-dark mt-1 mb-0"><%= kpis.connectedTelegramUsers %>명</h3>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-circle">
                  <i class="bi bi-telegram fs-4"></i>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- 2. System Settings & Global Broadcast Forms              -->
        <!-- ======================================================== -->
        <div class="row g-4 mb-4">
          
          <!-- Left: Real-time System Settings Card -->
          <div class="col-lg-6">
            <div class="card card-custom h-100">
              <div class="card-header-custom">
                <span><i class="bi bi-sliders text-primary me-2"></i>API 및 봇 시스템 실시간 환경설정</span>
                <span class="badge bg-light text-dark border">우선 순위: DB 설정 &gt; .env</span>
              </div>
              <div class="card-body p-4">
                <form action="/admin/settings" method="POST">
                  
                  <!-- Telegram Bot Token -->
                  <div class="mb-3">
                    <label for="tgToken" class="form-label small fw-semibold text-secondary">
                      텔레그램 봇 토큰 (Telegram Bot Token)
                    </label>
                    <input type="text" id="tgToken" name="telegram_bot_token" class="form-control font-monospace" value="<%= settings.telegram_bot_token %>" placeholder="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ">
                    <div class="form-text small">
                      * 보안을 위해 앞 6자리만 표시됩니다. 기존 값을 유지하려면 마스킹 상태 그대로 두거나 빈 칸으로 제출하세요.
                    </div>
                  </div>

                  <!-- Bot Enabled Switch -->
                  <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary d-block">텔레그램 봇 엔진 작동 여부</label>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="radio" name="bot_enabled" id="botEnabledTrue" value="true" <%= settings.bot_enabled ? 'checked' : '' %>>
                      <label class="form-check-label small" for="botEnabledTrue">활성화 (Polling 및 스케줄러 발송 켬)</label>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="radio" name="bot_enabled" id="botEnabledFalse" value="false" <%= !settings.bot_enabled ? 'checked' : '' %>>
                      <label class="form-check-label small" for="botEnabledFalse">비활성화 (정지)</label>
                    </div>
                  </div>

                  <!-- Gemini API Key -->
                  <div class="mb-4">
                    <label for="geminiKey" class="form-label small fw-semibold text-secondary">
                      Google Gemini API 키 (@google/genai)
                    </label>
                    <input type="text" id="geminiKey" name="gemini_api_key" class="form-control font-monospace" value="<%= settings.gemini_api_key %>" placeholder="AIzaSy...">
                    <div class="form-text small">
                      * 미입력 또는 호출 실패 시 내장 규칙 기반 분석기로 자동 폴백되어 정상 작동합니다.
                    </div>
                  </div>

                  <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                    <i class="bi bi-save me-1"></i> 환경설정 저장
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Right: Broadcast Message Card -->
          <div class="col-lg-6">
            <div class="card card-custom h-100">
              <div class="card-header-custom">
                <span><i class="bi bi-broadcast text-danger me-2"></i>전체 회원 긴급/정기 공지 일괄 발송</span>
                <span class="badge bg-danger-subtle text-danger">텔레그램 푸시</span>
              </div>
              <div class="card-body p-4">
                <p class="small text-secondary mb-3">
                  텔레그램을 연동한 모든 회원(<%= kpis.connectedTelegramUsers %>명)에게 실시간 텔레그램 알림으로 공지사항을 일괄 발송합니다.
                </p>
                <form action="/admin/broadcast" method="POST">
                  <div class="mb-3">
                    <label for="broadcastMsg" class="form-label small fw-semibold text-secondary">공지 내용</label>
                    <textarea id="broadcastMsg" name="broadcast_message" rows="5" class="form-control" placeholder="예: [시스템 점검 안내] 금일 23:00~23:30 서버 점검이 예정되어 있습니다. 이용에 참고 부탁드립니다." required></textarea>
                  </div>

                  <button type="submit" class="btn btn-danger btn-sm fw-semibold" onclick="return confirm('연동된 모든 회원에게 텔레그램 공지를 발송하시겠습니까?');">
                    <i class="bi bi-send-fill me-1"></i> 전체 회원에게 즉시 발송
                  </button>
                </form>
              </div>
            </div>
          </div>

        </div>

        <!-- ======================================================== -->
        <!-- 3. User Management Table                                 -->
        <!-- ======================================================== -->
        <div class="card card-custom mb-4">
          <div class="card-header-custom">
            <span><i class="bi bi-people text-primary me-2"></i>회원 관리 및 텔레그램 연동 제어</span>
            <span class="badge bg-light text-dark border">총 <%= users.length %>명</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4">ID</th>
                    <th>사용자명(ID)</th>
                    <th>이름</th>
                    <th>권한</th>
                    <th>텔레그램 연동 상태</th>
                    <th>연동 코드</th>
                    <th>등록 일정 수</th>
                    <th>가입일시</th>
                    <th class="text-end pe-4">작업</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr>
                      <td class="ps-4 fw-bold"><%= u.id %></td>
                      <td><%= u.username %></td>
                      <td><%= u.name %></td>
                      <td>
                        <span class="badge <%= u.role === 'ADMIN' ? 'bg-danger' : 'bg-secondary' %>">
                          <%= u.role %>
                        </span>
                      </td>
                      <td>
                        <% if (u.telegram_chat_id) { %>
                          <span class="badge bg-success">연동됨 (<%= u.telegram_chat_id %>)</span>
                        <% } else { %>
                          <span class="badge bg-light text-muted border">미연동</span>
                        <% } %>
                      </td>
                      <td><code><%= u.telegram_link_code || '-' %></code></td>
                      <td><span class="badge bg-info-subtle text-info fw-bold"><%= u.schedule_count %>개</span></td>
                      <td class="small text-muted"><%= u.created_at %></td>
                      <td class="text-end pe-4">
                        <div class="d-inline-flex gap-1">
                          <!-- Reset Telegram -->
                          <% if (u.telegram_chat_id) { %>
                            <form action="/admin/users/<%= u.id %>/reset-telegram" method="POST" class="m-0" onsubmit="return confirm('이 회원의 텔레그램 연동을 초기화하시겠습니까?');">
                              <button type="submit" class="btn btn-outline-warning btn-sm py-0 px-2" title="텔레그램 연동 초기화">
                                <i class="bi bi-arrow-repeat"></i> 연동 해제
                              </button>
                            </form>
                          <% } %>

                          <!-- Delete User -->
                          <% if (u.id !== user.id) { %>
                            <form action="/admin/users/<%= u.id %>/delete" method="POST" class="m-0" onsubmit="return confirm('이 회원을 영구 삭제하시겠습니까? 모든 일정이 함께 삭제됩니다.');">
                              <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="회원 삭제">
                                <i class="bi bi-trash"></i>
                              </button>
                            </form>
                          <% } else { %>
                            <span class="badge bg-light text-muted border py-1">본인</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- 4. Real-time Notification Logs Table                     -->
        <!-- ======================================================== -->
        <div class="card card-custom">
          <div class="card-header-custom">
            <span><i class="bi bi-clock-history text-secondary me-2"></i>실시간 알림 발송 및 감사 로그 (최근 25건)</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4">로그 ID</th>
                    <th>일시 (KST)</th>
                    <th>대상 회원</th>
                    <th>알림 유형</th>
                    <th>상태</th>
                    <th>메시지 내용 요약</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (logs.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center py-4 text-muted">기록된 알림 로그가 없습니다.</td>
                    </tr>
                  <% } else { %>
                    <% logs.forEach(log => { %>
                      <tr>
                        <td class="ps-4 fw-semibold text-secondary">#<%= log.id %></td>
                        <td class="small text-muted"><%= log.created_at %></td>
                        <td>
                          <% if (log.user_name) { %>
                            <%= log.user_name %> (<%= log.username %>)
                          <% } else { %>
                            <span class="text-muted">시스템</span>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge bg-light text-dark border"><%= log.type %></span>
                        </td>
                        <td>
                          <span class="badge <%= log.status === 'SUCCESS' ? 'bg-success' : 'bg-danger' %>">
                            <%= log.status %>
                          </span>
                        </td>
                        <td class="text-truncate text-secondary" style="max-width: 400px;" title="<%= log.message %>">
                          <%= log.message %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('appSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (sidebar && backdrop) {
        sidebar.classList.toggle('show');
        backdrop.classList.toggle('show');
      }
    }
  </script>
  <%- include('partials/mini-timer') %>
</body>
</html>