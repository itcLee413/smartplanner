<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>팀 워크스페이스 - WorkSmarter</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="app-wrapper">
    <!-- ========================================== -->
    <!-- 1. Notion-Style Left Fixed Sidebar         -->
    <!-- ========================================== -->
    <aside class="notion-sidebar" id="appSidebar">
      <!-- Sidebar Brand -->
      <div class="sidebar-brand-box d-flex align-items-center justify-content-between">
        <a href="/" class="navbar-brand-custom text-decoration-none">
          <i class="bi bi-calendar2-check-fill text-primary"></i>
          <span>WorkSmarter</span>
        </a>
        <button class="btn btn-sm btn-light" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- User Profile Box -->
      <div class="sidebar-user-box d-flex align-items-center gap-2">
        <div class="sidebar-avatar">
          <%= user.name.charAt(0) %>
        </div>
        <div class="overflow-hidden">
          <div class="fw-bold small text-truncate"><%= user.name %></div>
          <div class="text-muted smaller text-truncate">@<%= user.username %> · <span class="badge bg-light text-secondary border py-0 px-1"><%= user.role %></span></div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="p-2 flex-grow-1">
        <div class="sidebar-section-title">개인 워크스페이스</div>
        <a href="/" class="sidebar-link <%= activeMenu === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>내 대시보드</span>
        </a>
        <a href="/notes" class="sidebar-link <%= activeMenu === 'notes' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-text"></i>
          <span>세부사항 / 문서함</span>
        </a>
        <a href="/mypage" class="sidebar-link <%= activeMenu === 'mypage' ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span>마이페이지</span>
        </a>

        <div class="sidebar-section-title pt-3">팀 협업 공간</div>
        <a href="/teams" class="sidebar-link <%= activeMenu === 'teams' ? 'active' : '' %>">
          <i class="bi bi-people-fill text-primary"></i>
          <span>팀 워크스페이스</span>
          <span class="badge bg-primary text-white ms-auto rounded-pill px-2">Team</span>
        </a>

        <% if (user.role === 'ADMIN') { %>
          <div class="sidebar-section-title pt-3">시스템 관제</div>
          <a href="/admin" class="sidebar-link <%= activeMenu === 'admin' ? 'active' : '' %>">
            <i class="bi bi-shield-lock-fill text-warning"></i>
            <span>관리자 콘솔</span>
          </a>
        <% } %>
      </div>

      <!-- Sidebar Footer (Logout) -->
      <div class="sidebar-footer">
        <a href="/logout" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
          <i class="bi bi-box-arrow-right"></i>
          <span>로그아웃</span>
        </a>
      </div>
    </aside>

    <!-- Mobile Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarCollapse()"></div>

    <!-- ========================================== -->
    <!-- 2. Main Content Area                       -->
    <!-- ========================================== -->
    <div class="app-main-content">
      <!-- Top Mobile & Status Bar -->
      <header class="d-flex align-items-center justify-content-between px-4 py-2 border-bottom bg-white sticky-top">
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
            <i class="bi bi-list fs-5"></i>
          </button>
          <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
            <i class="bi bi-people-fill text-primary"></i> 팀 워크스페이스
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div id="headerMiniTimerSlot" class="d-flex align-items-center"></div>
          <%- include('partials/notification-dropdown') %>
          <% if (currentTeam && myMembership && (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER')) { %>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#teamAuditLogModal" title="팀 일정 수정 로그 (Audit Log)">
              <i class="bi bi-clock-history me-1"></i> 수정 로그
            </button>
          <% } %>
          <!-- Realtime 24h Clock (third.md 1번) -->
          <%- include('partials/header-clock') %>
        </div>
      </header>

      <!-- Global Alerts -->
      <div class="container-fluid px-4 mt-3">
        <% if (errorMsg) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><%= errorMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <% if (successMsg) { %>
          <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><%= successMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      </div>

      <!-- Main Container -->
      <main class="container-fluid px-4 py-3 flex-grow-1">

        <!-- ======================================================== -->
        <!-- TOP TOOLBAR: 드래그 앤 드롭 팀 탭 목록 + [새 팀 만들기] + [초대 코드로 참여] -->
        <!-- ======================================================== -->
        <div class="card card-custom p-3 mb-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            
            <!-- Left: 화살표 순서 변경 지원 팀 탭 목록 -->
            <div class="flex-grow-1 overflow-auto">
              <div class="d-flex align-items-center gap-2 flex-wrap" id="teamTabBar">
                <span class="fw-bold small text-secondary text-nowrap me-1">
                  <i class="bi bi-buildings text-primary me-1"></i>내 팀 목록:
                </span>
                <% if (myTeams && myTeams.length > 0) { %>
                  <% myTeams.forEach((t, index) => { %>
                    <div class="team-tab-chip <%= currentTeam && currentTeam.id === t.id ? 'active' : '' %>" 
                         data-team-id="<%= t.id %>">
                      <div class="team-tab-move-btns me-1">
                        <button type="button" 
                                class="btn-team-move" 
                                onclick="moveTeamOrder(event, <%= t.id %>, 'left')" 
                                title="이전 순서로 이동" 
                                <%= index === 0 ? 'disabled' : '' %>>
                          <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" 
                                class="btn-team-move" 
                                onclick="moveTeamOrder(event, <%= t.id %>, 'right')" 
                                title="다음 순서로 이동" 
                                <%= index === myTeams.length - 1 ? 'disabled' : '' %>>
                          <i class="bi bi-chevron-right"></i>
                        </button>
                      </div>
                      <a href="/teams?teamId=<%= t.id %>" class="team-tab-link text-decoration-none d-inline-flex align-items-center">
                        <span class="team-tab-title"><%= t.name %></span>
                        <span class="badge bg-light text-secondary border ms-1 py-0 px-1" style="font-size: 0.7rem;"><%= t.member_count %>명</span>
                      </a>
                    </div>
                  <% }); %>
                <% } else { %>
                  <span class="text-muted small">참여 중인 팀이 없습니다.</span>
                <% } %>
              </div>
            </div>

            <!-- Right: [초대 코드로 참여] 폼 + [새 팀 만들기] 모달 버튼 -->
            <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
              <!-- 초대 코드로 참여 인라인 폼 -->
              <form action="/teams/join" method="POST" class="d-flex align-items-center gap-1 m-0">
                <div class="input-group input-group-sm" style="max-width: 250px;">
                  <span class="input-group-text bg-light text-muted"><i class="bi bi-key-fill"></i></span>
                  <input type="text" name="invite_code" class="form-control font-monospace text-uppercase" placeholder="초대 코드 8자리" required style="letter-spacing: 1px;">
                  <button type="submit" class="btn btn-outline-primary fw-semibold">
                    참여
                  </button>
                </div>
              </form>

              <!-- 새 팀 만들기 모달 버튼 -->
              <button type="button" class="btn btn-primary btn-sm fw-semibold text-nowrap" data-bs-toggle="modal" data-bs-target="#createTeamModal">
                <i class="bi bi-plus-lg me-1"></i> 새 팀 만들기
              </button>
            </div>

          </div>
        </div>

        <% if (!currentTeam) { %>
          <!-- ======================================================== -->
          <!-- EMPTY STATE: 가입된 팀이 없는 경우                       -->
          <!-- ======================================================== -->
          <div class="card card-custom p-5 text-center my-4">
            <div class="py-5">
              <i class="bi bi-people fs-1 text-primary opacity-50 mb-3 d-block"></i>
              <h5 class="fw-bold mb-2">아직 참여 중인 프로젝트 팀이 없습니다.</h5>
              <p class="text-muted small mb-4">새로운 프로젝트 팀을 직접 생성하거나, 팀장에게 전달받은 8자리 초대 코드를 입력하여 팀에 합류하세요!</p>
              <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createTeamModal">
                  <i class="bi bi-plus-circle me-1"></i> 새 프로젝트 팀 만들기
                </button>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- ======================================================== -->
          <!-- TEAM HEADER CARD                                         -->
          <!-- ======================================================== -->
          <div class="team-header-box mb-4">
            <div class="row align-items-center g-3">
              <!-- Left: Team Info -->
              <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                  <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-building text-primary me-2"></i><%= currentTeam.name %></h4>
                  <span class="badge badge-role-<%= myMembership.role %> px-2 py-1">
                    내 권한: <%= myMembership.position %> (<%= myMembership.role %>)
                  </span>
                  <% if (myMembership.role === 'LEADER') { %>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#teamSettingsModal" title="팀 정보 수정 및 팀 삭제 (팀장 전용)">
                      <i class="bi bi-gear-fill me-1"></i>팀 설정
                    </button>
                  <% } %>
                  <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-semibold" onclick="handleLeaveTeam('<%= currentTeam.id %>', '<%= currentTeam.name %>')" title="팀 나가기 (탈퇴)">
                    <i class="bi bi-box-arrow-right me-1"></i>팀 나가기
                  </button>
                  <form id="leaveTeamForm" action="/teams/<%= currentTeam.id %>/leave" method="POST" class="d-none"></form>
                </div>
                <p class="text-muted small mb-2 preserve-lines"><%= currentTeam.description || '팀 설명이 등록되지 않았습니다.' %></p>
                <div class="d-flex align-items-center gap-3 small text-muted flex-wrap">
                  <span><i class="bi bi-person-fill text-secondary me-1"></i>팀 생성자: <strong><%= currentTeam.owner_name %></strong></span>
                  <span><i class="bi bi-people-fill text-secondary me-1"></i>총 팀원: <strong><%= members.length %>명</strong></span>
                  <span><i class="bi bi-clock-history text-secondary me-1"></i>생성일: <%= currentTeam.created_at.slice(0, 10) %></span>
                </div>
              </div>

              <!-- Right: Invite Code & Actions -->
              <div class="col-lg-5 text-lg-end">
                <div class="p-3 bg-white rounded-3 border d-inline-block text-start w-100" style="max-width: 420px;">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-secondary">
                      <i class="bi bi-shield-check text-success me-1"></i>팀 초대 코드
                    </span>
                    <% if (myMembership.role === 'LEADER') { %>
                      <form action="/teams/<%= currentTeam.id %>/regenerate-code" method="POST" class="m-0" onsubmit="return confirm('초대 코드를 재발급하시겠습니까? 기존 코드는 즉시 무효화됩니다.');">
                        <button type="submit" class="btn btn-outline-warning btn-sm py-0 px-2 text-dark" title="초대 코드 재발급 (팀장 전용)">
                          <i class="bi bi-arrow-repeat me-1"></i> 코드 재발급
                        </button>
                      </form>
                    <% } %>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="invite-code-pill flex-grow-1 text-center" id="teamInviteCodeDisplay">••••••</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="teamInviteToggleBtn" onclick="toggleInviteCodeMask('teamInviteCodeDisplay', 'teamInviteToggleBtn', '<%= currentTeam.invite_code %>')" title="초대 코드 보기">
                      <i class="bi bi-eye"></i>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" onclick="copyInviteCode('<%= currentTeam.invite_code %>')" title="초대 코드 클립보드 복사">
                      <i class="bi bi-clipboard me-1"></i> 복사
                    </button>
                  </div>
                  <div class="smaller text-muted mt-1">
                    팀원에게 코드를 공유하여 팀에 참여하도록 안내하세요.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ======================================================== -->
          <!-- 2-COLUMN WORKSPACE: 좌측(7컬럼) 일정+특이사항 / 우측(5컬럼) 팀원 -->
          <!-- ======================================================== -->
          <div class="row g-4">

            <!-- ======================================================== -->
            <!-- LEFT (7 Cols): 팀 공유 일정 보드 & 팀 특이사항 피드     -->
            <!-- ======================================================== -->
            <div class="col-lg-7">
              
              <!-- 1) 팀 공유 일정 보드 -->
              <div class="card card-custom mb-4">
                <div class="card-header-custom d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-check text-primary fs-5"></i>
                    <span class="fs-6 fw-bold">팀 공유 일정 보드</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill"><%= schedules.length %>개</span>
                  </div>

                  <!-- 뷰 전환 탭 ([칸반 뷰] / [팀 캘린더 뷰] second.md 1번) -->
                  <ul class="nav nav-pills nav-pills-sm card-header-pills" id="teamScheduleViewTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button class="nav-link active py-1 px-3 small fw-semibold" id="tab-team-kanban-btn" data-bs-toggle="pill" data-bs-target="#team-kanban-view" type="button" role="tab">
                        <i class="bi bi-kanban me-1"></i>칸반 뷰
                      </button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button class="nav-link py-1 px-3 small fw-semibold" id="tab-team-calendar-btn" data-bs-toggle="pill" data-bs-target="#team-calendar-view" type="button" role="tab" onclick="renderTeamCalendar()">
                        <i class="bi bi-calendar3 me-1"></i>팀 캘린더 뷰
                      </button>
                    </li>
                  </ul>

                  <div class="d-flex align-items-center gap-1">
                    <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER') { %>
                      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#teamAuditLogModal" title="수정 로그 보기 (LEADER/MANAGER 전용)">
                        <i class="bi bi-clock-history me-1"></i> 수정 로그
                      </button>
                      <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newTeamScheduleCollapse">
                        <i class="bi bi-plus-lg me-1"></i> 일정 등록
                      </button>
                    <% } %>
                  </div>
                </div>

                <!-- 팀 일정 등록 Collapse 폼 (LEADER / MANAGER 전용) -->
                <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER') { %>
                  <div class="collapse border-bottom bg-light" id="newTeamScheduleCollapse">
                    <div class="p-3">
                      <form action="/teams/<%= currentTeam.id %>/schedules" method="POST">
                        <div class="row g-2 mb-2">
                          <div class="col-md-7">
                            <label class="form-label small fw-semibold text-secondary mb-1">일정 제목 *</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="예: 스프린트 배포 및 통합 테스트" required>
                          </div>
                          <div class="col-md-5">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                              <label class="form-label small fw-semibold text-secondary mb-0">마감 일시</label>
                              <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" id="team_no_deadline" name="no_deadline" onchange="toggleDueInput(this, 'team_due_datetime')">
                                <label class="form-check-label smaller text-secondary cursor-pointer" for="team_no_deadline">기한 없음 (상시 일정)</label>
                              </div>
                            </div>
                            <input type="datetime-local" id="team_due_datetime" name="due_datetime" class="form-control form-control-sm" required value="<%= currentKSTDate %>T18:00">
                          </div>
                        </div>
                        <div class="mb-2">
                          <label class="form-label small fw-semibold text-secondary mb-1">세부 진행 내용 / 메모</label>
                          <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="일정 세부 사항, 담당 업무, 점검 체크리스트 등"></textarea>
                        </div>
                        <div class="text-end">
                          <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                            <i class="bi bi-check2 me-1"></i> 팀 일정 저장
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                <% } %>

                <!-- 탭 컨텐츠 영역 -->
                <div class="card-body p-3">
                  <div class="tab-content" id="teamScheduleTabContent">
                    <!-- 1. 칸반/목록 뷰 -->
                    <div class="tab-pane fade show active" id="team-kanban-view" role="tabpanel">
                      <% if (schedules.length === 0) { %>
                        <div class="text-center py-4 text-muted">
                          <i class="bi bi-calendar-x fs-2 opacity-50 mb-1 d-block"></i>
                          <p class="small mb-0">등록된 팀 공유 일정이 없습니다.</p>
                          <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER') { %>
                            <p class="smaller text-secondary">상단의 [+ 일정 등록] 버튼을 눌러 새 팀 일정을 추가해 보세요.</p>
                          <% } %>
                        </div>
                      <% } else { %>
                        <div class="d-flex flex-column gap-2">
                          <% schedules.forEach(sched => { %>
                            <div class="team-schedule-item <%= sched.status === 'DONE' ? 'status-done' : '' %>"
                                 oncontextmenu="openTeamScheduleContextMenu(event, '<%= sched.id %>')">
                              <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                  <span class="fw-bold text-dark fs-6 <%= sched.status === 'DONE' ? 'text-decoration-line-through text-muted' : '' %>">
                                    <%= sched.title %>
                                  </span>
                                  <span class="badge bg-light text-secondary border small">
                                    <i class="bi bi-person me-1"></i><%= sched.author_name %> (<%= sched.author_position || '팀원' %>)
                                  </span>
                                </div>

                                <div class="d-flex align-items-center gap-1">
                                  <!-- 상태 변경 드롭다운 (MEMBER 포함 모든 팀원 변경 가능) -->
                                  <form action="/teams/<%= currentTeam.id %>/schedules/<%= sched.id %>/status" method="POST" class="d-inline m-0">
                                    <select name="status" class="form-select form-select-sm py-0 ps-2 pe-4" onchange="this.form.submit()" style="font-size: 0.78rem;">
                                      <option value="TODO" <%= sched.status === 'TODO' ? 'selected' : '' %>>대기 (TODO)</option>
                                      <option value="IN_PROGRESS" <%= sched.status === 'IN_PROGRESS' ? 'selected' : '' %>>진행 중 (IN_PROGRESS)</option>
                                      <option value="DONE" <%= sched.status === 'DONE' ? 'selected' : '' %>>완료 (DONE)</option>
                                    </select>
                                  </form>

                                  <!-- 수정 버튼 (LEADER/MANAGER 또는 본인 작성자) -->
                                  <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER' || sched.author_id === user.id) { %>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#editTeamScheduleModal<%= sched.id %>" title="일정 수정">
                                      <i class="bi bi-pencil"></i>
                                    </button>
                                  <% } %>

                                  <!-- 삭제 버튼 (LEADER/MANAGER 또는 본인 작성자) -->
                                  <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER' || sched.author_id === user.id) { %>
                                    <form action="/teams/<%= currentTeam.id %>/schedules/<%= sched.id %>/delete" method="POST" class="d-inline m-0" onsubmit="return confirm('이 팀 일정을 삭제하시겠습니까?');">
                                      <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="일정 삭제">
                                        <i class="bi bi-trash"></i>
                                      </button>
                                    </form>
                                  <% } %>
                                </div>
                              </div>

                              <div class="small text-muted mb-2">
                                <% if (sched.due_datetime) { %>
                                  <i class="bi bi-clock me-1 text-primary"></i>마감: <strong><%= sched.due_datetime %></strong>
                                <% } else { %>
                                  <span class="badge bg-secondary text-white"><i class="bi bi-infinity me-1"></i>상시 일정</span>
                                <% } %>
                              </div>

                              <% if (sched.linked_notes && sched.linked_notes.length > 0) { %>
                                <div class="mb-2 d-flex flex-wrap gap-1">
                                  <% sched.linked_notes.forEach(note => { %>
                                    <a href="/notes?noteId=<%= note.id %>" class="badge bg-white text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="연결된 문서: <%= note.title %>">
                                      <i class="bi bi-file-earmark-text"></i> <%= note.title %>
                                    </a>
                                  <% }) %>
                                </div>
                              <% } %>

                              <% if (sched.description && sched.description.trim()) { %>
                                <div class="p-2 bg-light rounded small preserve-lines text-secondary">
                                  <%= sched.description.trim() %>
                                </div>
                              <% } %>
                            </div>
                          <% }); %>
                        </div>
                      <% } %>
                    </div>

                    <!-- 2. 팀 캘린더 뷰 (second.md 1번) -->
                    <div class="tab-pane fade" id="team-calendar-view" role="tabpanel">
                      <!-- Calendar Month Navigation -->
                      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="prevTeamCalMonth()"><i class="bi bi-chevron-left"></i></button>
                          <h6 class="fw-bold mb-0 text-dark fs-6" id="teamCalMonthYearTitle">2026년 11월</h6>
                          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nextTeamCalMonth()"><i class="bi bi-chevron-right"></i></button>
                          <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="todayTeamCalMonth()">오늘</button>
                        </div>
                        <div class="d-flex align-items-center gap-2 small">
                          <span class="badge cal-status-TODO border">대기 (TODO)</span>
                          <span class="badge cal-status-IN_PROGRESS border">진행 중 (IN_PROGRESS)</span>
                          <span class="badge cal-status-DONE border">완료 (DONE)</span>
                        </div>
                      </div>

                      <!-- 요일 헤더 (일 ~ 토) -->
                      <div class="d-grid text-center small fw-bold text-secondary mb-1" style="grid-template-columns: repeat(7, 1fr);">
                        <div class="text-danger py-1">일</div>
                        <div class="py-1">월</div>
                        <div class="py-1">화</div>
                        <div class="py-1">수</div>
                        <div class="py-1">목</div>
                        <div class="py-1">금</div>
                        <div class="text-primary py-1">토</div>
                      </div>

                      <!-- 7열 월간 캘린더 그리드 -->
                      <div class="calendar-grid mt-0" id="teamCalendarCellsContainer"></div>

                      <!-- 기한 미지정 팀 일정 보관함 (양방향 드롭존) -->
                      <div class="card mt-3" id="teamUndatedDropzone" ondragover="allowTeamDrop(event)" ondrop="handleTeamUndatedDrop(event)" style="border: 2px dashed #CBD5E1; background-color: #F8FAFC;">
                        <div class="card-body p-2">
                          <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-bold text-secondary">
                              <i class="bi bi-inbox me-1"></i>기한 미지정 팀 일정 (상시 일정 드롭존)
                            </span>
                            <span class="badge bg-secondary rounded-pill" id="teamUndatedCount">0개</span>
                          </div>
                          <div class="d-flex flex-wrap gap-1 min-h-30" id="teamUndatedListContainer">
                            <!-- 자바스크립트로 동적 렌더링 -->
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 2) 팀 특이사항 & 공유 메모 (공지/이슈) 피드 -->
              <div class="card card-custom">
                <div class="card-header-custom">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-chat-left-quote-fill text-warning fs-5"></i>
                    <span class="fs-6 fw-bold">팀 특이사항 & 공유 메모</span>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill">공지 / 이슈 / 회의록</span>
                  </div>

                  <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#newTeamNoteCollapse">
                    <i class="bi bi-pencil-square me-1"></i> 특이사항 작성
                  </button>
                </div>

                <!-- 특이사항 작성 폼 (모든 팀원 작성 가능) -->
                <div class="collapse border-bottom bg-light" id="newTeamNoteCollapse">
                  <div class="p-3">
                    <form action="/teams/<%= currentTeam.id %>/notes" method="POST">
                      <div class="row g-2 mb-2">
                        <div class="col-md-3">
                          <label class="form-label small fw-semibold text-secondary mb-1">카테고리</label>
                          <select name="category" class="form-select form-select-sm">
                            <option value="특이사항" selected>특이사항</option>
                            <option value="공지">공지</option>
                            <option value="회의록">회의록</option>
                            <option value="이슈">이슈</option>
                          </select>
                        </div>
                        <div class="col-md-9">
                          <label class="form-label small fw-semibold text-secondary mb-1">제목 *</label>
                          <input type="text" name="title" class="form-control form-control-sm" placeholder="예: [회의록] 2차 스프린트 백로그 리뷰" required>
                        </div>
                      </div>
                      <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">공유 내용 *</label>
                        <textarea name="content" class="form-control form-control-sm" rows="3" placeholder="특이사항, 결정 사항, 장애 원인 및 조치 내용 등을 자유롭게 작성하세요." required></textarea>
                      </div>
                      <div class="text-end">
                        <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                          <i class="bi bi-send me-1"></i> 특이사항 등록
                        </button>
                      </div>
                    </form>
                  </div>
                </div>

                <!-- 특이사항 피드 목록 -->
                <div class="card-body p-3">
                  <% if (notes.length === 0) { %>
                    <div class="text-center py-4 text-muted">
                      <i class="bi bi-journal-x fs-2 opacity-50 mb-1 d-block"></i>
                      <p class="small mb-0">공유된 팀 특이사항이나 공지가 없습니다.</p>
                      <p class="smaller text-secondary">상단의 [특이사항 작성] 버튼을 눌러 팀원들에게 공유할 내용을 작성해 보세요.</p>
                    </div>
                  <% } else { %>
                    <div class="d-flex flex-column gap-3">
                      <% notes.forEach(note => { %>
                        <div class="card border rounded-3 p-3 <%= note.is_pinned ? 'note-pinned-card' : 'bg-white' %>">
                          <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <div>
                              <div class="d-flex align-items-center gap-1 mb-1 flex-wrap">
                                <% if (note.is_pinned) { %>
                                  <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle-fill me-1"></i>상단 고정</span>
                                <% } %>
                                <span class="badge badge-cat-<%= note.category %>"><%= note.category %></span>
                                <span class="fw-bold fs-6 text-dark"><%= note.title %></span>
                              </div>
                              <div class="small text-muted">
                                <i class="bi bi-person me-1"></i><%= note.author_name %> (<%= note.author_position || '팀원' %>) · <%= note.created_at.slice(0, 16) %>
                              </div>
                            </div>

                            <div class="d-flex align-items-center gap-1">
                              <!-- 상단 고정 토글 (LEADER / MANAGER 전용) -->
                              <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER') { %>
                                <form action="/teams/<%= currentTeam.id %>/notes/<%= note.id %>/pin" method="POST" class="d-inline m-0">
                                  <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="<%= note.is_pinned ? '고정 해제' : '상단 고정' %>">
                                    <i class="bi bi-pin-angle<%= note.is_pinned ? '-fill text-warning' : '' %>"></i>
                                  </button>
                                </form>
                              <% } %>

                              <!-- 삭제 버튼 (LEADER/MANAGER 또는 본인 작성자) -->
                              <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER' || note.author_id === user.id) { %>
                                <form action="/teams/<%= currentTeam.id %>/notes/<%= note.id %>/delete" method="POST" class="d-inline m-0" onsubmit="return confirm('이 특이사항을 삭제하시겠습니까?');">
                                  <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="특이사항 삭제">
                                    <i class="bi bi-trash"></i>
                                  </button>
                                </form>
                              <% } %>
                            </div>
                          </div>

                          <div class="preserve-lines small text-secondary bg-white-50 p-2 rounded">
                            <%= note.content %>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </div>

            </div>

            <!-- ======================================================== -->
            <!-- RIGHT (5 Cols): 팀원 및 직책·권한 관리 패널              -->
            <!-- ======================================================== -->
            <div class="col-lg-5">
              <div class="card card-custom sticky-top" style="top: 80px;">
                <div class="card-header-custom d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary fs-5"></i>
                    <span class="fs-6 fw-bold">팀원 및 직책·권한 관리</span>
                    <span class="badge bg-light text-secondary border"><%= members.length %>명</span>
                  </div>
                  <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#inviteUserModal" title="@아이디로 팀원 초대">
                    <i class="bi bi-person-plus-fill me-1"></i>@초대
                  </button>
                </div>

                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                      <thead class="table-light">
                        <tr>
                          <th class="ps-3 py-2">팀원</th>
                          <th class="py-2">직책</th>
                          <th class="py-2">권한</th>
                          <% if (myMembership.role === 'LEADER') { %>
                            <th class="pe-3 py-2 text-end">관리</th>
                          <% } %>
                        </tr>
                      </thead>
                      <tbody>
                        <% members.forEach(m => { %>
                          <tr>
                            <td class="ps-3 py-3">
                              <div class="d-flex align-items-center gap-2">
                                <div class="avatar-sm bg-light text-primary border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                  <%= m.name.charAt(0) %>
                                </div>
                                <div>
                                  <div class="fw-semibold text-dark">
                                    <%= m.name %>
                                    <% if (m.user_id === user.id) { %>
                                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">나</span>
                                    <% } %>
                                  </div>
                                  <div class="text-muted smaller">@<%= m.username %></div>
                                </div>
                              </div>
                            </td>

                            <td class="py-3">
                              <span class="badge bg-light text-dark border px-2 py-1">
                                <%= m.position %>
                              </span>
                            </td>

                            <td class="py-3">
                              <span class="badge badge-role-<%= m.role %>">
                                <%= m.role %>
                              </span>
                            </td>

                            <% if (myMembership.role === 'LEADER') { %>
                              <td class="pe-3 py-3 text-end text-nowrap">
                                <!-- 팀장 위임 버튼 (타 팀원 대상) -->
                                <% if (m.user_id !== user.id) { %>
                                  <form action="/teams/<%= currentTeam.id %>/transfer-leader" method="POST" class="d-inline m-0" onsubmit="return confirm('<%= m.name %>님에게 팀장 권한을 위임하시겠습니까? 위임 후 본인은 일반 멤버(MEMBER)로 전환됩니다.');">
                                    <input type="hidden" name="target_member_id" value="<%= m.id %>">
                                    <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2 text-dark me-1" title="팀장 권한 위임">
                                      <i class="bi bi-person-fill-up me-1"></i>팀장 위임
                                    </button>
                                  </form>
                                <% } %>

                                <!-- 직책/권한 수정 모달 트리거 -->
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-bs-toggle="modal" data-bs-target="#editMemberModal<%= m.id %>" title="직책 및 권한 수정">
                                  <i class="bi bi-gear"></i>
                                </button>

                                <!-- 팀원 내보내기 버튼 (본인 제외) -->
                                <% if (m.user_id !== user.id) { %>
                                  <form action="/teams/<%= currentTeam.id %>/members/<%= m.id %>/remove" method="POST" class="d-inline m-0" onsubmit="return confirm('정말로 <%= m.name %> 님을 팀에서 내보내시겠습니까?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" title="팀원 내보내기">
                                      <i class="bi bi-person-x"></i>
                                    </button>
                                  </form>
                                <% } %>
                              </td>
                            <% } %>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>

                  <!-- Footer Guide -->
                  <div class="p-3 bg-light border-top smaller text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>권한 안내:</strong><br>
                    • <strong>LEADER:</strong> 초대 코드 재발급, 팀원 직책/권한 관리, 팀원 내보내기, 전체 일정 및 특이사항 관리<br>
                    • <strong>MANAGER:</strong> 팀 일정 생성/삭제, 특이사항 상단 고정 관리<br>
                    • <strong>MEMBER:</strong> 팀 일정 상태 변경, 본인 작성 특이사항 등록 및 삭제
                  </div>
                </div>
              </div>
            </div>

          </div>
        <% } %>

      </main>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: 새 프로젝트 팀 만들기                             -->
  <!-- ======================================================== -->
  <div class="modal fade" id="createTeamModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle-fill text-primary me-2"></i>새 프로젝트 팀 만들기</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/teams/create" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label for="newTeamName" class="form-label small fw-semibold text-secondary">팀명 *</label>
              <input type="text" id="newTeamName" name="name" class="form-control" placeholder="예: 스마트팩토리 네트워크 구축팀" required>
            </div>
            <div class="mb-3">
              <label for="newTeamDesc" class="form-label small fw-semibold text-secondary">팀 설명 및 목표</label>
              <textarea id="newTeamDesc" name="description" class="form-control" rows="3" placeholder="팀의 프로젝트 목표, 주요 협업 규칙 등을 자유롭게 적어주세요."></textarea>
            </div>
            <div class="alert alert-info py-2 px-3 small mb-0">
              <i class="bi bi-lightbulb me-1"></i>팀 생성자는 자동으로 <strong>팀장(LEADER)</strong> 권한을 부여받으며 고유 초대 코드가 자동 생성됩니다.
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">취소</button>
            <button type="submit" class="btn btn-primary btn-sm fw-semibold">
              <i class="bi bi-check-lg me-1"></i> 팀 생성 완료
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: 팀 설정 및 정보 수정 / 팀 삭제 (LEADER 전용)       -->
  <!-- ======================================================== -->
  <% if (currentTeam && myMembership && myMembership.role === 'LEADER') { %>
    <div class="modal fade text-start" id="teamSettingsModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h6 class="modal-title fw-bold">
              <i class="bi bi-gear-fill text-primary me-2"></i>팀 설정 및 정보 수정
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form action="/teams/<%= currentTeam.id %>/update" method="POST">
            <div class="modal-body p-3">
              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">팀명 *</label>
                <input type="text" name="name" class="form-control" value="<%= currentTeam.name %>" placeholder="팀명을 입력하세요" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">팀 설명 및 목표</label>
                <textarea name="description" class="form-control" rows="3" placeholder="팀 설명, 목표 및 협업 규칙 등을 입력하세요"><%= currentTeam.description || '' %></textarea>
              </div>

              <!-- Danger Zone: 팀 삭제 -->
              <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-3 mt-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div>
                    <div class="fw-bold text-danger small"><i class="bi bi-exclamation-triangle-fill me-1"></i>위험 구역: 팀 삭제</div>
                    <div class="smaller text-danger opacity-75">팀 삭제 시 모든 팀 일정, 특이사항 및 멤버 정보가 영구 삭제됩니다.</div>
                  </div>
                  <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="submitDeleteTeam()">
                    <i class="bi bi-trash3-fill me-1"></i>팀 삭제
                  </button>
                </div>
              </div>
            </div>
            <div class="modal-footer py-2">
              <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">취소</button>
              <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                <i class="bi bi-check-lg me-1"></i>수정 저장
              </button>
            </div>
          </form>

          <!-- Hidden Form for Team Delete -->
          <form id="deleteTeamHiddenForm" action="/teams/<%= currentTeam.id %>/delete" method="POST" style="display: none;"></form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- ======================================================== -->
  <!-- MODALS: 팀원 직책 및 권한 수정 모달들 (Body 직전 최하단 배치) -->
  <!-- ======================================================== -->
  <% if (currentTeam && myMembership && myMembership.role === 'LEADER' && members && members.length > 0) { %>
    <% members.forEach(m => { %>
      <div class="modal fade text-start" id="editMemberModal<%= m.id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content">
            <div class="modal-header py-2">
              <h6 class="modal-title fw-bold">팀원 정보 수정: <%= m.name %></h6>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teams/<%= currentTeam.id %>/members/<%= m.id %>/update" method="POST">
              <div class="modal-body p-3">
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-secondary">직책명 (자유 텍스트)</label>
                  <input type="text" name="position" class="form-control form-control-sm" value="<%= m.position %>" placeholder="예: 팀장, 백엔드, 프론트엔드, 기획 등" required>
                </div>
                <div class="mb-2">
                  <label class="form-label small fw-semibold text-secondary">권한 레벨</label>
                  <% if (m.role === 'LEADER') { %>
                    <input type="text" class="form-control form-control-sm" value="LEADER (팀장)" disabled>
                    <span class="smaller text-muted d-block mt-1">
                      <i class="bi bi-info-circle me-1"></i>팀장 변경은 테이블의 [팀장 위임] 기능을 이용해 주세요.
                    </span>
                  <% } else { %>
                    <select name="role" class="form-select form-select-sm">
                      <option value="MEMBER" <%= m.role === 'MEMBER' ? 'selected' : '' %>>MEMBER (일반팀원)</option>
                      <option value="MANAGER" <%= m.role === 'MANAGER' ? 'selected' : '' %>>MANAGER (운영진/일정관리)</option>
                    </select>
                  <% } %>
                </div>
              </div>
              <div class="modal-footer py-2">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">취소</button>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">수정 저장</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- ======================================================== -->
  <!-- MODALS: 팀 일정 수정 모달들 (작성자 본인 또는 LEADER/MANAGER 전용) -->
  <!-- ======================================================== -->
  <% if (currentTeam && myMembership && schedules && schedules.length > 0) { %>
    <% schedules.forEach(sched => { %>
      <% if (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER' || sched.author_id === user.id) { %>
        <div class="modal fade text-start" id="editTeamScheduleModal<%= sched.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header py-2">
                <h6 class="modal-title fw-bold">
                  <i class="bi bi-pencil-square text-primary me-2"></i>팀 일정 수정
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <form action="/teams/<%= currentTeam.id %>/schedules/<%= sched.id %>/update" method="POST">
                <div class="modal-body p-3">
                  <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">일정 제목 *</label>
                    <input type="text" name="title" class="form-control form-control-sm" value="<%= sched.title %>" required>
                  </div>
                  <div class="row g-2 mb-3">
                    <div class="col-md-7">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-secondary mb-0">마감 일시</label>
                        <div class="form-check form-check-inline m-0">
                          <input class="form-check-input" type="checkbox" id="edit_team_no_deadline_<%= sched.id %>" name="no_deadline" <%= !sched.due_datetime ? 'checked' : '' %> onchange="toggleDueInput(this, 'edit_team_due_<%= sched.id %>')">
                          <label class="form-check-label smaller text-secondary cursor-pointer" for="edit_team_no_deadline_<%= sched.id %>">기한 없음</label>
                        </div>
                      </div>
                      <input type="datetime-local" id="edit_team_due_<%= sched.id %>" name="due_datetime" class="form-control form-control-sm" value="<%= (sched.due_datetime || '').replace(' ', 'T').slice(0, 16) %>" <%= !sched.due_datetime ? 'disabled' : 'required' %>>
                    </div>
                    <div class="col-md-5">
                      <label class="form-label small fw-semibold text-secondary">진행 상태</label>
                      <select name="status" class="form-select form-select-sm">
                        <option value="TODO" <%= sched.status === 'TODO' ? 'selected' : '' %>>대기 (TODO)</option>
                        <option value="IN_PROGRESS" <%= sched.status === 'IN_PROGRESS' ? 'selected' : '' %>>진행 중 (IN_PROGRESS)</option>
                        <option value="DONE" <%= sched.status === 'DONE' ? 'selected' : '' %>>완료 (DONE)</option>
                      </select>
                    </div>
                  </div>
                  <div class="mb-2">
                    <label class="form-label small fw-semibold text-secondary">세부 진행 내용 / 메모</label>
                    <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="일정 세부 사항, 담당 업무, 점검 체크리스트 등"><%= sched.description || '' %></textarea>
                  </div>
                  <div class="smaller text-muted">
                    <i class="bi bi-info-circle me-1"></i>일정 수정 내역은 관리자 감사 로그(Audit Log)에 자동 기록됩니다.
                  </div>
                </div>
                <div class="modal-footer py-2">
                  <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">취소</button>
                  <button type="submit" class="btn btn-primary btn-sm fw-semibold">수정 완료</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    <% }); %>
  <% } %>

  <!-- ======================================================== -->
  <!-- MODAL: 팀 일정 수정 감사 로그 (Audit Log, LEADER/MANAGER 전용) -->
  <!-- ======================================================== -->
  <% if (currentTeam && myMembership && (myMembership.role === 'LEADER' || myMembership.role === 'MANAGER')) { %>
    <div class="modal fade text-start" id="teamAuditLogModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header py-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-shield-check text-primary fs-5"></i>
              <h6 class="modal-title fw-bold mb-0">팀 일정 수정 로그 (Audit Log)</h6>
              <span class="badge bg-light text-secondary border smaller">최근 50건</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-3">
            <% if (!scheduleLogs || scheduleLogs.length === 0) { %>
              <div class="text-center py-4 text-muted">
                <i class="bi bi-journal-check fs-2 opacity-50 mb-1 d-block"></i>
                <p class="small mb-0">기록된 팀 일정 수정 또는 변경 이력이 없습니다.</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.83rem;">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-2 py-2" style="width: 130px;">일시</th>
                      <th class="py-2" style="width: 90px;">구분</th>
                      <th class="py-2" style="width: 110px;">작업자</th>
                      <th class="py-2" style="width: 140px;">대상 일정</th>
                      <th class="pe-2 py-2">변경 내역 / 상세</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% scheduleLogs.forEach(log => { %>
                      <tr>
                        <td class="ps-2 py-2 text-muted text-nowrap font-monospace smaller">
                          <%= log.created_at ? log.created_at.slice(0, 16) : '' %>
                        </td>
                        <td class="py-2">
                          <% if (log.action_type === 'CREATED') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1">생성</span>
                          <% } else if (log.action_type === 'UPDATED') { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-1">수정</span>
                          <% } else if (log.action_type === 'STATUS_CHANGED') { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1">상태변경</span>
                          <% } else if (log.action_type === 'DELETED') { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1">삭제</span>
                          <% } else { %>
                            <span class="badge bg-light text-secondary border py-1"><%= log.action_type %></span>
                          <% } %>
                        </td>
                        <td class="py-2 text-nowrap">
                          <strong class="text-dark"><%= log.editor_name %></strong>
                          <span class="text-muted smaller">(<%= log.editor_position || '팀원' %>)</span>
                        </td>
                        <td class="py-2 text-truncate" style="max-width: 140px;" title="<%= log.schedule_title %>">
                          <span class="fw-semibold text-secondary"><%= log.schedule_title %></span>
                        </td>
                        <td class="pe-2 py-2 text-secondary preserve-lines smaller">
                          <%= log.detail || '-' %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
          <div class="modal-footer py-2">
            <span class="smaller text-muted me-auto">
              <i class="bi bi-info-circle me-1"></i>팀장(LEADER) 및 운영진(MANAGER)에게만 조회 권한이 부여됩니다.
            </span>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">닫기</button>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Modal: @아이디로 팀원 초대 (second.md 3번) -->
  <div class="modal fade" id="inviteUserModal" tabindex="-1" aria-labelledby="inviteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/teams/<%= currentTeam ? currentTeam.id : '' %>/invite" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="inviteUserModalLabel">
              <i class="bi bi-person-plus-fill text-primary me-2"></i>@아이디로 팀원 초대
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="text-secondary small mb-3">
              초대하려는 사용자의 아이디를 <code>@아이디</code> 형식(또는 아이디만)으로 입력해 주세요.<br>
              초대장이 발송되면 해당 사용자 상단 헤더의 <strong>종 모양 알림함</strong>에 즉시 도착합니다.
            </p>
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">사용자 아이디 (Username) *</label>
              <div class="input-group">
                <span class="input-group-text bg-light fw-bold text-secondary">@</span>
                <input type="text" name="username" class="form-control" placeholder="예: test" required autofocus autocomplete="off">
              </div>
              <div class="form-text smaller text-muted">@ 기호는 자동으로 처리됩니다.</div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">취소</button>
            <button type="submit" class="btn btn-primary btn-sm fw-semibold">
              <i class="bi bi-send-fill me-1"></i>초대장 발송
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    async function handleLeaveTeam(teamId, teamName) {
      let ok = false;
      const msg = `"${teamName}" 팀에서 정말 나가시겠습니까?\n\n※ 팀장(LEADER)이 탈퇴할 경우 가장 먼저 가입한 팀원에게 팀장 권한이 자동 위임되며, 마지막 남은 1인이면 팀과 관련 데이터가 모두 삭제됩니다.`;
      if (typeof showConfirm === 'function') {
        ok = await showConfirm(msg, '팀 나가기 확인');
      } else {
        ok = confirm(msg);
      }
      if (ok) {
        const form = document.getElementById('leaveTeamForm');
        if (form) form.submit();
      }
    }
    window.handleLeaveTeam = handleLeaveTeam;

    function toggleDueInput(checkbox, inputId) {
      const input = document.getElementById(inputId);
      if (!input) return;
      if (checkbox.checked) {
        input.dataset.oldValue = input.value;
        input.value = '';
        input.disabled = true;
        input.required = false;
      } else {
        input.disabled = false;
        input.required = true;
        if (input.dataset.oldValue) {
          input.value = input.dataset.oldValue;
        }
      }
    }
    window.toggleDueInput = toggleDueInput;

    // Sidebar Toggle for Mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('appSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (sidebar && backdrop) {
        sidebar.classList.toggle('show');
        backdrop.classList.toggle('show');
      }
    }

    // Toggle Invite Code Masking
    function toggleInviteCodeMask(displayId, btnId, realCode) {
      const displayEl = document.getElementById(displayId);
      const btnEl = document.getElementById(btnId);
      if (!displayEl || !btnEl) return;
      const isMasked = displayEl.textContent.trim() === '••••••';
      if (isMasked) {
        displayEl.textContent = realCode;
        btnEl.innerHTML = '<i class="bi bi-eye-slash"></i>';
        btnEl.title = '초대 코드 숨기기';
      } else {
        displayEl.textContent = '••••••';
        btnEl.innerHTML = '<i class="bi bi-eye"></i>';
        btnEl.title = '초대 코드 보기';
      }
    }

    // Copy Invite Code
    function copyInviteCode(code) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(() => {
          showAlert('초대 코드(' + code + ')가 클립보드에 복사되었습니다!');
        }).catch(() => {
          prompt('초대 코드를 복사하세요:', code);
        });
      } else {
        prompt('초대 코드를 복사하세요:', code);
      }
    }

    // Submit Delete Team with Notion-Style showConfirm
    window.submitDeleteTeam = function() {
      showConfirm('정말 이 팀을 삭제하시겠습니까? 모든 팀 일정, 특이사항, 멤버 정보가 영구 삭제됩니다.', '팀 삭제 확인').then(confirmed => {
        if (confirmed) {
          const form = document.getElementById('deleteTeamHiddenForm');
          if (form) form.submit();
        }
      });
    };

    // 화살표 버튼 기반 팀 순서 이동 (이벤트 버블링 차단 및 API 호출 후 새로고침)
    window.moveTeamOrder = function(event, teamId, direction) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }
      const targetBtn = event ? event.currentTarget : null;
      if (targetBtn) targetBtn.disabled = true;

      fetch('/api/teams/move', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamId: parseInt(teamId, 10), direction: direction })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          const currentParams = new URLSearchParams(window.location.search);
          <% if (currentTeam) { %>
            if (!currentParams.has('teamId')) {
              currentParams.set('teamId', '<%= currentTeam.id %>');
              window.location.href = window.location.pathname + '?' + currentParams.toString();
              return;
            }
          <% } %>
          window.location.reload();
        } else {
          if (typeof showAlert === 'function') {
            showAlert(data.error || '팀 순서 변경에 실패했습니다.');
          } else {
            alert(data.error || '팀 순서 변경에 실패했습니다.');
          }
          if (targetBtn) targetBtn.disabled = false;
        }
      })
      .catch(err => {
        console.error('Failed to move team order:', err);
        if (typeof showAlert === 'function') {
          showAlert('팀 순서 변경 중 네트워크 오류가 발생했습니다.');
        } else {
          alert('팀 순서 변경 중 네트워크 오류가 발생했습니다.');
        }
        if (targetBtn) targetBtn.disabled = false;
      });
    };

    // ==========================================
    // Team Schedule Calendar Logic (second.md 1번)
    // ==========================================
    window.teamSchedules = <%- JSON.stringify(schedules || []) %>;
    window.currentTeamId = <%= currentTeam ? currentTeam.id : 'null' %>;

    let currentTeamCalYear = new Date().getFullYear();
    let currentTeamCalMonth = new Date().getMonth(); // 0-indexed

    function prevTeamCalMonth() {
      currentTeamCalMonth--;
      if (currentTeamCalMonth < 0) {
        currentTeamCalMonth = 11;
        currentTeamCalYear--;
      }
      renderTeamCalendar();
    }
    window.prevTeamCalMonth = prevTeamCalMonth;

    function nextTeamCalMonth() {
      currentTeamCalMonth++;
      if (currentTeamCalMonth > 11) {
        currentTeamCalMonth = 0;
        currentTeamCalYear++;
      }
      renderTeamCalendar();
    }
    window.nextTeamCalMonth = nextTeamCalMonth;

    function todayTeamCalMonth() {
      const now = new Date();
      currentTeamCalYear = now.getFullYear();
      currentTeamCalMonth = now.getMonth();
      renderTeamCalendar();
    }
    window.todayTeamCalMonth = todayTeamCalMonth;

    function renderTeamCalendar() {
      const container = document.getElementById('teamCalendarCellsContainer');
      if (!container) return;
      container.innerHTML = '';

      const titleEl = document.getElementById('teamCalMonthYearTitle');
      if (titleEl) {
        titleEl.textContent = `${currentTeamCalYear}년 ${currentTeamCalMonth + 1}월`;
      }

      const firstDay = new Date(currentTeamCalYear, currentTeamCalMonth, 1).getDay();
      const lastDate = new Date(currentTeamCalYear, currentTeamCalMonth + 1, 0).getDate();
      const prevLastDate = new Date(currentTeamCalYear, currentTeamCalMonth, 0).getDate();

      const today = new Date();
      const todayYear = today.getFullYear();
      const todayMonth = today.getMonth();
      const todayDate = today.getDate();

      // 1. Previous month trailing days
      for (let i = firstDay - 1; i >= 0; i--) {
        const d = prevLastDate - i;
        const cell = document.createElement('div');
        cell.className = 'calendar-cell other-month';
        cell.innerHTML = `<div class="d-flex justify-content-between mb-1"><span class="day-number text-muted">${d}</span></div>`;
        container.appendChild(cell);
      }

      // 2. Current month days
      const pad = n => String(n).padStart(2, '0');
      for (let d = 1; d <= lastDate; d++) {
        const dateStr = `${currentTeamCalYear}-${pad(currentTeamCalMonth + 1)}-${pad(d)}`;
        const isToday = (currentTeamCalYear === todayYear && currentTeamCalMonth === todayMonth && d === todayDate);

        const cell = document.createElement('div');
        cell.className = 'calendar-cell' + (isToday ? ' today' : '');
        cell.dataset.date = dateStr;

        // Dragover & Drop
        cell.ondragover = function(ev) {
          ev.preventDefault();
          ev.dataTransfer.dropEffect = 'move';
          cell.classList.add('bg-primary-subtle');
        };
        cell.ondragleave = function() {
          cell.classList.remove('bg-primary-subtle');
        };
        cell.ondrop = function(ev) {
          cell.classList.remove('bg-primary-subtle');
          handleTeamCalendarCellDrop(ev, dateStr);
        };

        const headerDiv = document.createElement('div');
        headerDiv.className = 'd-flex justify-content-between align-items-center mb-1';
        headerDiv.innerHTML = `<span class="day-number ${isToday ? 'fw-bold text-primary' : ''}">${d}</span>`;
        cell.appendChild(headerDiv);

        const eventsContainer = document.createElement('div');
        eventsContainer.className = 'calendar-events d-flex flex-column gap-1';

        // Filter schedules for this date
        const dayScheds = (window.teamSchedules || []).filter(s => s.due_datetime && s.due_datetime.startsWith(dateStr));
        dayScheds.forEach(s => {
          const badge = document.createElement('div');
          badge.className = `calendar-event-badge cal-status-${s.status}`;
          badge.setAttribute('draggable', 'true');
          badge.title = `${s.title} (${s.author_name} - ${s.status})`;
          badge.innerHTML = `<span class="badge-title text-truncate">${escapeHtml(s.title)}</span>`;

          badge.ondragstart = function(ev) {
            ev.dataTransfer.setData('text/plain', JSON.stringify({ id: s.id, type: 'TEAM', teamId: window.currentTeamId }));
            ev.dataTransfer.effectAllowed = 'move';
          };

          badge.oncontextmenu = function(ev) {
            ev.preventDefault();
            ev.stopPropagation();
            if (typeof openScheduleContextMenu === 'function') {
              openScheduleContextMenu(ev, { ...s, team_id: window.currentTeamId });
            }
          };

          badge.onclick = function(ev) {
            ev.stopPropagation();
            if (typeof openScheduleDetailPopover === 'function') {
              openScheduleDetailPopover(s, { clientX: ev.clientX, clientY: ev.clientY });
            }
          };

          eventsContainer.appendChild(badge);
        });

        cell.appendChild(eventsContainer);
        container.appendChild(cell);
      }

      // 3. Next month leading days
      const totalCells = firstDay + lastDate;
      const remaining = (7 - (totalCells % 7)) % 7;
      for (let i = 1; i <= remaining; i++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-cell other-month';
        cell.innerHTML = `<div class="d-flex justify-content-between mb-1"><span class="day-number text-muted">${i}</span></div>`;
        container.appendChild(cell);
      }

      // Render undated schedules
      renderTeamUndatedSchedules();
    }
    window.renderTeamCalendar = renderTeamCalendar;

    function renderTeamUndatedSchedules() {
      const container = document.getElementById('teamUndatedListContainer');
      const countEl = document.getElementById('teamUndatedCount');
      if (!container) return;
      container.innerHTML = '';

      const undated = (window.teamSchedules || []).filter(s => !s.due_datetime || s.due_datetime === '');
      if (countEl) countEl.textContent = `${undated.length}개`;

      if (undated.length === 0) {
        container.innerHTML = '<span class="text-muted smaller p-1">기한 미지정 일정이 없습니다. 일정을 드래그하여 상시 일정으로 전환할 수 있습니다.</span>';
        return;
      }

      undated.forEach(s => {
        const badge = document.createElement('div');
        badge.className = `calendar-event-badge cal-status-${s.status} cursor-pointer`;
        badge.setAttribute('draggable', 'true');
        badge.style.display = 'inline-block';
        badge.style.maxWidth = '200px';
        badge.title = `${s.title} (상시 일정)`;
        badge.innerHTML = `<i class="bi bi-infinity me-1"></i><span class="badge-title text-truncate">${escapeHtml(s.title)}</span>`;

        badge.ondragstart = function(ev) {
          ev.dataTransfer.setData('text/plain', JSON.stringify({ id: s.id, type: 'TEAM', teamId: window.currentTeamId }));
          ev.dataTransfer.effectAllowed = 'move';
        };

        badge.oncontextmenu = function(ev) {
          ev.preventDefault();
          ev.stopPropagation();
          if (typeof openScheduleContextMenu === 'function') {
            openScheduleContextMenu(ev, { ...s, team_id: window.currentTeamId });
          }
        };

        badge.onclick = function(ev) {
          ev.stopPropagation();
          if (typeof openScheduleDetailPopover === 'function') {
            openScheduleDetailPopover(s, { clientX: ev.clientX, clientY: ev.clientY });
          }
        };

        container.appendChild(badge);
      });
    }

    function allowTeamDrop(ev) {
      ev.preventDefault();
      ev.dataTransfer.dropEffect = 'move';
    }
    window.allowTeamDrop = allowTeamDrop;

    async function handleTeamCalendarCellDrop(ev, targetDateStr) {
      ev.preventDefault();
      const raw = ev.dataTransfer.getData('text/plain');
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        const schedId = data.id;
        const target = (window.teamSchedules || []).find(x => String(x.id) === String(schedId));
        if (!target) return;

        const newDue = `${targetDateStr} 18:00`;
        const res = await fetch(`/teams/${window.currentTeamId}/schedules/${schedId}/update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            due_datetime: newDue,
            title: target.title,
            status: target.status
          })
        });
        const result = await res.json();
        if (result && result.success) {
          target.due_datetime = newDue;
          renderTeamCalendar();
          if (typeof showAlert === 'function') showAlert(`팀 일정 마감일이 ${targetDateStr}로 변경되었습니다.`);
        } else {
          if (typeof showAlert === 'function') showAlert((result && result.error) || '일정 이동 실패');
          else alert((result && result.error) || '일정 이동 실패');
        }
      } catch (e) {
        console.error('Team cal drop error:', e);
      }
    }
    window.handleTeamCalendarCellDrop = handleTeamCalendarCellDrop;

    async function handleTeamUndatedDrop(ev) {
      ev.preventDefault();
      const raw = ev.dataTransfer.getData('text/plain');
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        const schedId = data.id;
        const target = (window.teamSchedules || []).find(x => String(x.id) === String(schedId));
        if (!target) return;

        const res = await fetch(`/teams/${window.currentTeamId}/schedules/${schedId}/update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            no_deadline: true,
            due_datetime: '',
            title: target.title,
            status: target.status
          })
        });
        const result = await res.json();
        if (result && result.success) {
          target.due_datetime = null;
          renderTeamCalendar();
          if (typeof showAlert === 'function') showAlert(`팀 일정이 [기한 미지정(상시)] 상태로 변경되었습니다.`);
        } else {
          if (typeof showAlert === 'function') showAlert((result && result.error) || '일정 이동 실패');
          else alert((result && result.error) || '일정 이동 실패');
        }
      } catch (e) {
        console.error('Team undated drop error:', e);
      }
    }
    window.handleTeamUndatedDrop = handleTeamUndatedDrop;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  </script>
  <%- include('partials/mini-timer') %>
</body>
</html>
