    async function submitBulkStatus(status) {
      const ids = getSelectedScheduleIds();
      if (ids.length === 0) return;
      const ok = await showConfirm(`선택한 ${ids.length}개의 일정 상태를 [${status}] 상태로 변경하시겠습니까?`);
      if (!ok) return;

      try {
        const res = await fetch('/schedules/bulk-status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ ids, status })
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          showAlert(data.error || '상태 일괄 변경에 실패했습니다.');
        }
      } catch (err) {
        showAlert('오류가 발생했습니다: ' + err.message);
      }
    }

    async function submitBulkDelete() {
      const ids = getSelectedScheduleIds();
      if (ids.length === 0) return;
      const ok = await showConfirm(`선택한 ${ids.length}개의 일정을 정말로 모두 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.`);
      if (!ok) return;

      try {
        const res = await fetch('/schedules/bulk-delete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ ids })
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          showAlert(data.error || '일괄 삭제에 실패했습니다.');
        }
      } catch (err) {
        showAlert('오류가 발생했습니다: ' + err.message);
      }
    }

