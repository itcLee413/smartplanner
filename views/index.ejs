                    <span class="badge bg-success rounded-pill"><%= teamSchedules.filter(s => s.status === 'DONE').length %></span>
                  </div>
                  <div class="kanban-cards">
                    <% teamSchedules.filter(s => s.status === 'DONE').forEach(s => { %>
                      <div class="kanban-card done-card" 
                           draggable="true" 
                           data-drag-source="WORKSPACE" 
                           data-drag-type="TEAM" 
                           data-drag-id="<%= s.id %>"
                           data-team-id="<%= s.team_id %>"
                           data-current-status="<%= s.status %>">
                        <div class="team-schedule-card-header mb-1">
                          <span class="badge bg-light text-muted border font-monospace team-schedule-badge-team" style="font-size: 0.72rem;">
