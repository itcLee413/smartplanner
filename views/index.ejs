      <!-- 7. Custom Widgets (moduleplus.md) -->
      <% if (typeof customWidgets !== 'undefined' && Array.isArray(customWidgets)) { %>
        <% customWidgets.forEach(cw => { 
             const customConf = layoutMap['custom_' + cw.id] || { id: 'custom_' + cw.id, x: 0, y: 15, w: cw.default_w || 4, h: cw.default_h || 3, enabled: true };
             if (customConf.enabled !== false) {
        %>
        <div class="grid-stack-item" gs-id="custom_<%= cw.id %>" gs-x="<%= customConf.x %>" gs-y="<%= customConf.y %>" gs-w="<%= customConf.w %>" gs-h="<%= customConf.h %>" data-title="<%= cw.title %>">
