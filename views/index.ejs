    function initGridStackDashboard() {
      const gridEl = document.getElementById('dashboardGrid');
      if (!gridEl || typeof GridStack === 'undefined') return;

      dashboardGrid = GridStack.init({
        column: 12,
        cellHeight: 85,
        animate: true,
