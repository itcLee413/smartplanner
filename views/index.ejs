                  <button type="button" class="btn btn-sm btn-outline-secondary btn-pip-toggle" onclick="event.stopPropagation(); togglePipWidget('custom_<%= cw.id %>')" title="팝업(PIP) 모드로 분리">
                    <i class="bi bi-pip"></i> <span class="d-none d-sm-inline ms-1 smaller">팝업 띄우기</span>
                  </button>
