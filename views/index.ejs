            <div class="card card-custom h-100 d-flex flex-column custom-widget-card" id="widget-card-custom_<%= cw.id %>">
              <!-- Drag Handle Bar -->
              <div class="widget-drag-handle">
                <div class="handle-title">
                  <i class="bi bi-grip-horizontal text-secondary"></i>
