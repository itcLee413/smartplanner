    function getSelectedScheduleIds() {
      const checkedBoxes = document.querySelectorAll('.schedule-select-checkbox:checked');
      return Array.from(checkedBoxes).map(cb => cb.value);
    }

    function onScheduleCheckboxChange() {
      const selectedIds = getSelectedScheduleIds();
      const bar = document.getElementById('bulkActionBar');
      const countSpan = document.getElementById('bulkSelectedCount');
      if (!bar || !countSpan) return;

      if (selectedIds.length > 0) {
        countSpan.textContent = selectedIds.length;
        bar.classList.remove('d-none');
      } else {
        bar.classList.add('d-none');
      }
    }

    function clearBulkSelection() {
      document.querySelectorAll('.schedule-select-checkbox:checked').forEach(cb => {
        cb.checked = false;
      });
      onScheduleCheckboxChange();
