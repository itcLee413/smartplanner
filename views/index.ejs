  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Schedules Data for Client JavaScript -->
  <script>
    // Embedded safe JSON of user teams and schedules
    window.USER_TEAMS = <%- JSON.stringify(myTeams || []) %>;
    const userSchedules = [
      <% schedules.forEach((s, idx) => { %>
        {
          id: <%= s.id %>,
          title: "<%= s.title.replace(/"/g, '\\"') %>",
          due_datetime: "<%= s.due_datetime || '' %>",
          category: "<%= s.category %>",
          status: "<%= s.status %>",
          is_top3: <%= s.is_top3 %>,
          is_important: <%= s.is_important %>
        }<%= idx < schedules.length - 1 ? ',' : '' %>
      <% }) %>
    ];

    // ==========================================
    // 1. Chart.js Category Donut Chart & Refresh (stastics.md)
    // ==========================================
    const ctx = document.getElementById('categoryChart');
    if (ctx) {
      window.productivityChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['업무', '개인', '팀프로젝트', '자기계발'],
          datasets: [{
            data: [
              <%= stats.categoryStats['업무'] || 0 %>,
              <%= stats.categoryStats['개인'] || 0 %>,
              <%= stats.categoryStats['팀프로젝트'] || 0 %>,
              <%= stats.categoryStats['자기계발'] || 0 %>
            ],
            backgroundColor: ['#4f46e5', '#3b82f6', '#f59e0b', '#10b981'],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { boxWidth: 12, font: { size: 11 } }
            }
          },
          cutout: '65%'
        }
      });
    }

    function refreshProductivityStats(serverStats) {
      let stats = serverStats;
      if (!stats && typeof userSchedules !== 'undefined') {
        const total = userSchedules.length;
        const done = userSchedules.filter(s => s.status === 'DONE').length;
        const todo = userSchedules.filter(s => s.status === 'TODO').length;
        const inProg = userSchedules.filter(s => s.status === 'IN_PROGRESS').length;
        const cats = { '업무': 0, '개인': 0, '팀프로젝트': 0, '자기계발': 0 };
        userSchedules.forEach(s => {
          if (cats[s.category] !== undefined) cats[s.category]++;
        });
        stats = {
          totalCount: total,
          doneCount: done,
          todoCount: todo,
          inProgressCount: inProg,
          categoryStats: cats
        };
      }

      if (!stats) return;

      // 1. 통계 수치 텍스트 실시간 갱신 (stastics.md 1번)
      const totalEl = document.getElementById('statTotalCount');
      if (totalEl) totalEl.textContent = `${stats.totalCount || 0}개`;

      const compEl = document.getElementById('statCompletionRate');
      if (compEl) {
        const rate = (stats.totalCount && stats.totalCount > 0)
          ? Math.round(((stats.doneCount || 0) / stats.totalCount) * 100)
          : 0;
        compEl.textContent = `${rate}%`;
      }

      if (stats.totalFocusMinutes !== undefined) {
        const focusEl = document.getElementById('statFocusMinutes');
        if (focusEl) focusEl.textContent = `${stats.totalFocusMinutes}분`;
      }

      // 2. Chart.js 도넛 차트 그래픽 즉시 부드럽게 갱신 (stastics.md 1번)
