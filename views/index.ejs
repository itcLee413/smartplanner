                            <select name="status" 
                                    class="form-select form-select-sm py-0 ps-1 pe-3 team-schedule-status-select" 
                                    data-team-id="<%= s.team_id %>"
                                    data-schedule-id="<%= s.id %>"
                                    data-current-status="TODO"
