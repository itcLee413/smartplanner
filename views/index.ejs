    let currentCalYear = new Date().getFullYear();
    let currentCalMonth = new Date().getMonth(); // 0-indexed

    function renderCalendar() {
      const container = document.getElementById('calendarCellsContainer');
      if (!container) return;
      container.innerHTML = '';

      const firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
      const lastDate = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const prevLastDate = new Date(currentCalYear, currentCalMonth, 0).getDate();

      const titleEl = document.getElementById('calendarMonthYearTitle');
      if (titleEl) {
        titleEl.textContent = `${currentCalYear}년 ${currentCalMonth + 1}월`;
      }

      const todayStr = '<%= currentKSTDate %>'; // YYYY-MM-DD

      // Get selected country holiday keys
      const checkedCountries = Array.from(document.querySelectorAll('.holiday-country-check:checked')).map(cb => cb.value);

      // Previous month filler days
      for (let i = firstDay - 1; i >= 0; i--) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'calendar-cell other-month';
        dayDiv.innerHTML = `<span class="day-num">${prevLastDate - i}</span>`;
        container.appendChild(dayDiv);
      }

      // Current month days
      for (let d = 1; d <= lastDate; d++) {
        const dateStr = `${currentCalYear}-${String(currentCalMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const dayDiv = document.createElement('div');
        dayDiv.className = 'calendar-cell' + (dateStr === todayStr ? ' today' : '');

        const dayOfWeek = (firstDay + d - 1) % 7;
        const colorClass = dayOfWeek === 0 ? ' text-danger' : (dayOfWeek === 6 ? ' text-primary' : '');

        let inner = `<span class="day-num${colorClass}">${d}</span>`;

        // Render Holidays for checked countries
        checkedCountries.forEach(cKey => {
          const cData = HOLIDAYS[cKey];
          if (cData && cData.dates && cData.dates[dateStr]) {
            const hName = cData.dates[dateStr];
            inner += `<span class="calendar-holiday-badge ${cData.badgeClass}" title="[${cData.name}] ${hName}">
              [${cData.prefix}] ${hName}
            </span>`;
          }
        });

        dayDiv.innerHTML = inner;

        // Match schedules for this day
        const matched = userSchedules.filter(s => s.due_datetime && s.due_datetime.startsWith(dateStr));
        const eventsWrapper = document.createElement('div');
        eventsWrapper.className = 'd-flex flex-column gap-1 mt-1';

        matched.forEach(s => {
          const badge = document.createElement('span');
          badge.className = `calendar-event-badge cal-status-${s.status || 'TODO'}`;
          badge.setAttribute('data-status', s.status || 'TODO');
          badge.setAttribute('data-schedule-id', s.id);
          badge.draggable = true;
          badge.setAttribute('data-drag-source', 'WORKSPACE');
          badge.setAttribute('data-drag-type', 'PERSONAL');
          badge.setAttribute('data-drag-id', s.id);
          badge.setAttribute('data-current-status', s.status || 'TODO');
          badge.title = `${s.title} (${s.status || 'TODO'}) (드래그하여 날짜 이동 / Top 3 등록 / 우클릭 관리)`;
          badge.textContent = `${s.status === 'DONE' ? '✓ ' : ''}${s.title}`;
          badge.style.cursor = 'grab';

          badge.ondragstart = function(ev) {
            currentDragItem = { source: 'WORKSPACE', type: 'PERSONAL', id: s.id, currentStatus: s.status, element: badge };
            ev.dataTransfer.setData('text/plain', JSON.stringify({ id: s.id, due: s.due_datetime, source: 'WORKSPACE', type: 'PERSONAL', currentStatus: s.status }));
            ev.dataTransfer.setData('application/json', JSON.stringify({ id: s.id, type: 'PERSONAL', source: 'WORKSPACE', currentStatus: s.status }));
            ev.dataTransfer.effectAllowed = 'copyMove';
          };

          badge.oncontextmenu = function(ev) {
            openScheduleContextMenu(ev, { id: s.id, title: s.title, status: s.status });
          };

          eventsWrapper.appendChild(badge);
        });

        dayDiv.appendChild(eventsWrapper);

        // Drag & Drop handlers for date rescheduling
        dayDiv.ondragover = function(ev) {
          ev.preventDefault();
          dayDiv.style.backgroundColor = '#e0e7ff';
        };
        dayDiv.ondragleave = function(ev) {
          dayDiv.style.backgroundColor = '';
        };
        dayDiv.ondrop = async function(ev) {
          ev.preventDefault();
          dayDiv.style.backgroundColor = '';
          const dataStr = ev.dataTransfer.getData('text/plain');
          if (!dataStr) return;
          try {
            const parsed = JSON.parse(dataStr);
            const id = parsed.id;
            const due = parsed.due || '';
            const existingTime = (due && due.includes(' ')) ? due.split(' ')[1] : '18:00';
            const newDueDateTime = `${dateStr} ${existingTime}`;

            const res = await fetch(`/schedules/${id}/reschedule`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ due_datetime: newDueDateTime })
            });
            if (res.ok) {
              const target = userSchedules.find(x => String(x.id) === String(id));
              if (target) target.due_datetime = newDueDateTime;
              renderCalendar();
              showAlert(`일정 마감일이 ${dateStr}로 변경되었습니다.`);
            } else {
              showAlert('날짜 변경에 실패했습니다.');
            }
          } catch (err) {
            console.error('Drag drop reschedule error:', err);
          }
        };

        container.appendChild(dayDiv);
      }

      // Next month filler days to complete grid
      const totalCells = firstDay + lastDate;
      const nextDays = (7 - (totalCells % 7)) % 7;
      for (let n = 1; n <= nextDays; n++) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'calendar-cell other-month';
        dayDiv.innerHTML = `<span class="day-num">${n}</span>`;
        container.appendChild(dayDiv);
      }
    }

    function changeMonth(delta) {
      currentCalMonth += delta;
      if (currentCalMonth < 0) {
        currentCalMonth = 11;
        currentCalYear--;
      } else if (currentCalMonth > 11) {
        currentCalMonth = 0;
        currentCalYear++;
      }
      renderCalendar();
    }

    function resetToCurrentMonth() {
      currentCalYear = new Date().getFullYear();
      currentCalMonth = new Date().getMonth();
      renderCalendar();
    }

    // ==========================================
    // Top 3 Two-Way Drag & Drop & Async Controls (top3.md)
    // ==========================================
    let currentDragItem = null;

    // Global dragstart listener for any cards or badges marked with data-drag-source
    document.addEventListener('dragstart', (e) => {
      const card = e.target.closest('[data-drag-source]');
      if (!card) return;

      const source = card.getAttribute('data-drag-source');
      const type = card.getAttribute('data-drag-type');
      const id = parseInt(card.getAttribute('data-drag-id'), 10);
      const currentStatus = card.getAttribute('data-current-status');
      const teamId = card.getAttribute('data-team-id');

      currentDragItem = { source, type, id, currentStatus, teamId, element: card };
      try {
        e.dataTransfer.setData('application/json', JSON.stringify({ source, type, id, currentStatus, teamId }));
        e.dataTransfer.setData('text/plain', JSON.stringify({ source, type, id, currentStatus, teamId }));
      } catch (err) {}
      e.dataTransfer.effectAllowed = source === 'TOP3' ? 'move' : 'copyMove';
    });

    document.addEventListener('dragend', () => {
      currentDragItem = null;
      const dropzone = document.getElementById('top3-dropzone');
      if (dropzone) dropzone.classList.remove('top3-drag-highlight');
      document.querySelectorAll('.kanban-column, .kanban-col').forEach(col => {
        col.classList.remove('kanban-drag-highlight');
      });
    });

    // 1. Dropzone: Drag into Top 3 to ADD
    document.addEventListener('DOMContentLoaded', () => {
      const top3Dropzone = document.getElementById('top3-dropzone');
      if (top3Dropzone) {
        top3Dropzone.addEventListener('dragover', (e) => {
          if (currentDragItem && currentDragItem.source === 'WORKSPACE') {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'copy';
            top3Dropzone.classList.add('top3-drag-highlight');
          }
        });

        top3Dropzone.addEventListener('dragleave', (e) => {
          if (!top3Dropzone.contains(e.relatedTarget)) {
            top3Dropzone.classList.remove('top3-drag-highlight');
          }
        });

        top3Dropzone.addEventListener('drop', (e) => {
          if (currentDragItem && currentDragItem.source === 'WORKSPACE') {
            e.preventDefault();
            top3Dropzone.classList.remove('top3-drag-highlight');
            const item = currentDragItem;
            currentDragItem = null;
            addTop3Schedule(item.type, item.id);
          }
        });
      }

      // 2. Drag outside of Top 3 to REMOVE (anywhere on body)
      document.body.addEventListener('dragover', (e) => {
        if (currentDragItem && currentDragItem.source === 'TOP3') {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
        }
      });

      document.body.addEventListener('drop', (e) => {
        if (currentDragItem && currentDragItem.source === 'TOP3') {
          const dropzone = document.getElementById('top3-dropzone');
          if (dropzone && dropzone.contains(e.target)) {
            return; // Dropped back inside dropzone
          }
          e.preventDefault();
          const item = currentDragItem;
          currentDragItem = null;
          removeTop3Schedule(null, item.type, item.id);
        }
      });

      // 3. 3-Column Kanban Board Drag & Drop Status Change (todos1.md)
      const kanbanColumns = document.querySelectorAll('.kanban-column, .kanban-col');
      kanbanColumns.forEach(col => {
        col.addEventListener('dragover', (e) => {
          // [충돌 방지 규칙 1]: Top 3 카드(data-drag-source="TOP3")는 칸반 컬럼 위라도 무시하여 body로 전파되게 함
          if (!currentDragItem || currentDragItem.source !== 'WORKSPACE') {
            return;
          }

          // 해당 보드 영역 검증 (개인 일정은 #kanbanView, 팀 일정은 #teamScopeView)
          const isPersonal = currentDragItem.type === 'PERSONAL';
          const isTeam = currentDragItem.type === 'TEAM';
          const inPersonalView = !!col.closest('#kanbanView');
          const inTeamView = !!col.closest('#teamScopeView');

          if ((isPersonal && !inPersonalView) || (isTeam && !inTeamView)) {
            return;
          }

          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          col.classList.add('kanban-drag-highlight');
        });

        col.addEventListener('dragleave', (e) => {
          if (!col.contains(e.relatedTarget)) {
            col.classList.remove('kanban-drag-highlight');
          }
        });

        col.addEventListener('drop', (e) => {
          // [충돌 방지 규칙 1]: Top 3 카드는 칸반 컬럼 드롭 무시 (body로 전파)
          if (!currentDragItem || currentDragItem.source !== 'WORKSPACE') {
            return;
          }

          const isPersonal = currentDragItem.type === 'PERSONAL';
          const isTeam = currentDragItem.type === 'TEAM';
          const inPersonalView = !!col.closest('#kanbanView');
          const inTeamView = !!col.closest('#teamScopeView');

          if ((isPersonal && !inPersonalView) || (isTeam && !inTeamView)) {
            return;
          }

          e.preventDefault();
          col.classList.remove('kanban-drag-highlight');

          const targetStatus = col.getAttribute('data-status');
          if (!targetStatus) return;

          const { type, id, currentStatus, teamId, element } = currentDragItem;
          currentDragItem = null;

          // 원래 자신이 속해 있던 컬럼과 동일한 컬럼에 놓으면 아무 API 호출 없이 종료
          if (currentStatus === targetStatus) {
            return;
          }

          // [충돌 방지 규칙 2]: 다른 상태 컬럼에 드롭한 경우 실제 상태 변경
          if (type === 'PERSONAL') {
            updatePersonalScheduleStatus(id, targetStatus, element, col);
          } else if (type === 'TEAM') {
            updateTeamScheduleStatusByDrag(teamId, id, targetStatus, element, col);
          }
        });
      });
    });

    function addTop3Schedule(type, id) {
      fetch('/api/top3/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ type, id: parseInt(id, 10) })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          window.location.reload();
        } else {
          if (typeof showAlert === 'function') {
            showAlert((data && data.error) || 'Top 3 목표 등록에 실패했습니다.');
          } else {
            alert((data && data.error) || 'Top 3 목표 등록에 실패했습니다.');
          }
        }
      })
      .catch(err => {
        console.error('Failed to add Top 3 schedule:', err);
        if (typeof showAlert === 'function') {
          showAlert('Top 3 등록 중 네트워크 오류가 발생했습니다.');
        } else {
          alert('네트워크 오류가 발생했습니다.');
        }
      });
    }

    function removeTop3Schedule(event, type, id) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }
      fetch('/api/top3/remove', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ type, id: parseInt(id, 10) })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          window.location.reload();
        } else {
          if (typeof showAlert === 'function') {
            showAlert((data && data.error) || 'Top 3 목표 해제에 실패했습니다.');
          } else {
            alert((data && data.error) || 'Top 3 목표 해제에 실패했습니다.');
          }
        }
      })
      .catch(err => {
        console.error('Failed to remove Top 3 schedule:', err);
        if (typeof showAlert === 'function') {
          showAlert('Top 3 해제 중 네트워크 오류가 발생했습니다.');
        } else {
          alert('네트워크 오류가 발생했습니다.');
        }
      });
    }

    // ==========================================
    // Team Schedule Async Status Update (testui4.md)
    // ==========================================
    function updateTeamScheduleStatus(event, teamId, scheduleId, selectEl) {
      if (event) {
        event.preventDefault();
      }
      const newStatus = selectEl.value;
      const previousStatus = selectEl.getAttribute('data-current-status') || newStatus;

      fetch(`/teams/${teamId}/schedules/${scheduleId}/status`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ status: newStatus })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          selectEl.setAttribute('data-current-status', newStatus);
          const card = selectEl.closest('.kanban-card');
          if (card) {
            card.setAttribute('data-current-status', newStatus);
            const destCol = document.querySelector(`#teamScopeView .kanban-col[data-status="${newStatus}"]`);
            if (destCol) {
              const destCardsContainer = destCol.querySelector('.kanban-cards');
              if (destCardsContainer && card.parentElement !== destCardsContainer) {
                destCardsContainer.appendChild(card);
              }
            }
            const titleEl = card.querySelector('h6');
            if (titleEl) {
              if (newStatus === 'DONE') {
                card.classList.add('done-card');
                card.classList.remove('border-primary', 'border-opacity-25');
                titleEl.classList.add('text-decoration-line-through', 'text-muted');
                titleEl.classList.remove('text-dark');
              } else if (newStatus === 'IN_PROGRESS') {
                card.classList.remove('done-card');
                card.classList.add('border-primary', 'border-opacity-25');
                titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                titleEl.classList.add('text-dark');
              } else {
                card.classList.remove('done-card', 'border-primary', 'border-opacity-25');
                titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                titleEl.classList.add('text-dark');
              }
            }
            updateTeamKanbanCounts();
          }
        } else {
          if (typeof showAlert === 'function') {
            showAlert((data && data.error) || '상태 변경에 실패했습니다.');
          } else {
            alert((data && data.error) || '상태 변경에 실패했습니다.');
          }
          selectEl.value = previousStatus;
        }
      })
      .catch(err => {
        console.error('Failed to update team schedule status:', err);
        if (typeof showAlert === 'function') {
          showAlert('팀 일정 상태 변경 중 통신 오류가 발생했습니다.');
        } else {
          alert('통신 오류가 발생했습니다.');
        }
        selectEl.value = previousStatus;
      });
    }

    function updateTeamKanbanCounts() {
      const teamCols = document.querySelectorAll('#teamScopeView .kanban-col');
      teamCols.forEach(col => {
        const badge = col.querySelector('.kanban-col-header .badge');
        const cards = col.querySelectorAll('.kanban-cards .kanban-card');
        if (badge) {
          badge.textContent = cards.length;
        }
      });
    }

    // ==========================================
    // Kanban Drag & Drop Status Update Helpers (todos1.md)
    // ==========================================
    function updateTeamScheduleStatusByDrag(teamId, scheduleId, targetStatus, cardEl, targetCol) {
      const card = cardEl || document.querySelector(`#teamScopeView .kanban-card[data-drag-id="${scheduleId}"]`);
      const selectEl = card ? card.querySelector('.team-schedule-status-select') : null;
      if (selectEl) {
        selectEl.value = targetStatus;
        updateTeamScheduleStatus(null, teamId, scheduleId, selectEl);
      } else {
        fetch(`/teams/${teamId}/schedules/${scheduleId}/status`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ status: targetStatus })
        })
        .then(res => res.json())
        .then(data => {
          if (data && data.success) {
            if (card) {
              card.setAttribute('data-current-status', targetStatus);
              const destCardsContainer = targetCol.querySelector('.kanban-cards');
              if (destCardsContainer && card.parentElement !== destCardsContainer) {
                destCardsContainer.appendChild(card);
              }
              const titleEl = card.querySelector('h6');
              if (titleEl) {
                if (targetStatus === 'DONE') {
                  card.classList.add('done-card');
                  card.classList.remove('border-primary', 'border-opacity-25');
                  titleEl.classList.add('text-decoration-line-through', 'text-muted');
                  titleEl.classList.remove('text-dark');
                } else if (targetStatus === 'IN_PROGRESS') {
                  card.classList.remove('done-card');
                  card.classList.add('border-primary', 'border-opacity-25');
                  titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                  titleEl.classList.add('text-dark');
                } else {
                  card.classList.remove('done-card', 'border-primary', 'border-opacity-25');
                  titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                  titleEl.classList.add('text-dark');
                }
              }
              updateTeamKanbanCounts();
            }
          } else {
            if (typeof showAlert === 'function') {
              showAlert((data && data.error) || '팀 일정 상태 변경에 실패했습니다.');
            } else {
              alert((data && data.error) || '팀 일정 상태 변경에 실패했습니다.');
            }
          }
        })
        .catch(err => {
          console.error('Failed to update team schedule status via drag:', err);
          if (typeof showAlert === 'function') {
            showAlert('팀 일정 상태 변경 중 통신 오류가 발생했습니다.');
          } else {
            alert('통신 오류가 발생했습니다.');
          }
        });
      }
    }

    function updatePersonalScheduleStatus(scheduleId, newStatus, cardEl, targetCol) {
      const card = cardEl || document.querySelector(`#kanbanView .kanban-card[data-drag-id="${scheduleId}"]`);

      fetch(`/schedules/${scheduleId}/status`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ status: newStatus })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          if (card) {
            card.setAttribute('data-current-status', newStatus);
            const destCardsContainer = targetCol.querySelector('.kanban-cards');
            if (destCardsContainer && card.parentElement !== destCardsContainer) {
              destCardsContainer.appendChild(card);
            }

            const titleEl = card.querySelector('h6');
            if (titleEl) {
              if (newStatus === 'DONE') {
                card.classList.add('done-card');
                card.classList.remove('border-primary', 'border-opacity-25');
                titleEl.classList.add('text-decoration-line-through', 'text-muted');
                titleEl.classList.remove('text-dark');
              } else if (newStatus === 'IN_PROGRESS') {
                card.classList.remove('done-card');
                card.classList.add('border-primary', 'border-opacity-25');
                titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                titleEl.classList.add('text-dark');
              } else {
                card.classList.remove('done-card', 'border-primary', 'border-opacity-25');
                titleEl.classList.remove('text-decoration-line-through', 'text-muted');
                titleEl.classList.add('text-dark');
              }
            }

            updatePersonalCardActionButtons(card, scheduleId, newStatus);
            updatePersonalKanbanCounts();
          }

          // 1. userSchedules 전역 데이터 갱신
          if (typeof userSchedules !== 'undefined') {
            const target = userSchedules.find(x => String(x.id) === String(scheduleId));
            if (target) target.status = newStatus;
          }

          // 2. 캘린더 칩 실시간 동기화
          if (typeof renderCalendar === 'function') {
            renderCalendar();
          }

          // 3. 생산성 통계 도넛 차트 즉시 갱신 (stastics.md 1번)
          if (typeof refreshProductivityStats === 'function') {
            refreshProductivityStats(data.stats);
          }
        } else {
          if (typeof showAlert === 'function') {
            showAlert((data && data.error) || '일정 상태 변경에 실패했습니다.');
          } else {
            alert((data && data.error) || '일정 상태 변경에 실패했습니다.');
          }
        }
      })
      .catch(err => {
        console.error('Failed to update personal schedule status:', err);
        if (typeof showAlert === 'function') {
          showAlert('일정 상태 변경 중 통신 오류가 발생했습니다.');
        } else {
          alert('통신 오류가 발생했습니다.');
        }
      });
    }

    function updatePersonalCardActionButtons(cardEl, scheduleId, status) {
      const titleEl = cardEl.querySelector('h6');
      const rawTitle = titleEl ? titleEl.textContent.trim() : '';
      const escapedTitle = rawTitle.replace(/'/g, "\\'");

      // 우클릭 컨텍스트 메뉴 속성 동기화
      cardEl.setAttribute('oncontextmenu', `openScheduleContextMenu(event, { id: '${scheduleId}', title: '${escapedTitle}', status: '${status}' })`);

      // 카드의 마지막 액션 컨트롤 영역 찾기
      const actionContainers = cardEl.querySelectorAll('form[action*="/status"], div.d-flex.gap-1');
      if (actionContainers.length > 0) {
        const lastAction = actionContainers[actionContainers.length - 1];
        let newHtml = '';
        if (status === 'TODO') {
          newHtml = `
            <form action="/schedules/${scheduleId}/status" method="POST" class="m-0">
              <input type="hidden" name="status" value="IN_PROGRESS">
              <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                진행 시작 <i class="bi bi-arrow-right"></i>
              </button>
            </form>
          `;
        } else if (status === 'IN_PROGRESS') {
          newHtml = `
            <div class="d-flex gap-1">
              <button type="button" class="btn btn-outline-primary btn-sm flex-fill" onclick="selectPomodoroSchedule('${scheduleId}', '${escapedTitle}')">
                <i class="bi bi-stopwatch"></i> 집중
              </button>
              <form action="/schedules/${scheduleId}/status" method="POST" class="m-0 flex-fill">
                <input type="hidden" name="status" value="DONE">
                <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">
                  <i class="bi bi-check-lg"></i> 완료
                </button>
              </form>
            </div>
          `;
        } else if (status === 'DONE') {
          newHtml = `
            <form action="/schedules/${scheduleId}/status" method="POST" class="m-0">
              <input type="hidden" name="status" value="TODO">
              <button type="submit" class="btn btn-outline-secondary btn-sm w-100 py-0" style="font-size: 0.75rem;">
                <i class="bi bi-arrow-counterclockwise"></i> TODO로 되돌리기
              </button>
            </form>
          `;
        }

        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = newHtml.trim();
        if (tempDiv.firstElementChild) {
          lastAction.replaceWith(tempDiv.firstElementChild);
        }
      }
    }

    function updatePersonalKanbanCounts() {
      const personalCols = document.querySelectorAll('#kanbanView .kanban-column, #kanbanView .kanban-col');
      personalCols.forEach(col => {
        const badge = col.querySelector('.kanban-col-header .badge');
        const cards = col.querySelectorAll('.kanban-cards .kanban-card');
        if (badge) {
          badge.textContent = cards.length;
        }
      });
    }

    // ==========================================
    // Synchronize Kanban Board DOM when Status changed outside Kanban (stastics.md 3번)
    // ==========================================
    function syncScheduleStatusInKanban(scheduleId, newStatus) {
      const card = document.querySelector(`#kanbanView .kanban-card[data-drag-id="${scheduleId}"]`);
      if (!card) return;

      const destCol = document.querySelector(`#kanbanView .kanban-col[data-status="${newStatus}"]`);
      if (destCol) {
        const destCardsContainer = destCol.querySelector('.kanban-cards');
        if (destCardsContainer && card.parentElement !== destCardsContainer) {
          destCardsContainer.appendChild(card);
        }
      }

      card.setAttribute('data-current-status', newStatus);

      const titleEl = card.querySelector('h6');
      if (titleEl) {
        if (newStatus === 'DONE') {
          card.classList.add('done-card');
          card.classList.remove('border-primary', 'border-opacity-25');
          titleEl.classList.add('text-decoration-line-through', 'text-muted');
          titleEl.classList.remove('text-dark');
        } else if (newStatus === 'IN_PROGRESS') {
          card.classList.remove('done-card');
          card.classList.add('border-primary', 'border-opacity-25');
          titleEl.classList.remove('text-decoration-line-through', 'text-muted');
          titleEl.classList.add('text-dark');
        } else {
          card.classList.remove('done-card', 'border-primary', 'border-opacity-25');
          titleEl.classList.remove('text-decoration-line-through', 'text-muted');
          titleEl.classList.add('text-dark');
        }
      }

      if (typeof updatePersonalCardActionButtons === 'function') {
        updatePersonalCardActionButtons(card, scheduleId, newStatus);
      }
      if (typeof updatePersonalKanbanCounts === 'function') {
        updatePersonalKanbanCounts();
      }
    }
    window.syncScheduleStatusInKanban = syncScheduleStatusInKanban;

    // ==========================================
    // Subtask Async Handlers (checklist.md 2번)
    // ==========================================
    async function addSubtaskAsync(event, scheduleId, formEl) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const input = formEl.querySelector('input[name="title"]');
      if (!input || !input.value.trim()) return;
      const title = input.value.trim();

      try {
        const res = await fetch(`/schedules/${scheduleId}/subtasks`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ title })
        });
        const data = await res.json();
        if (data && data.success) {
          input.value = '';
          updateSubtasksDOM(scheduleId, data);
        } else {
          if (typeof showAlert === 'function') showAlert((data && data.error) || '하위 할 일 추가에 실패했습니다.');
          else alert((data && data.error) || '하위 할 일 추가에 실패했습니다.');
        }
      } catch (err) {
        console.error('addSubtaskAsync error:', err);
        if (typeof showAlert === 'function') showAlert('통신 오류가 발생했습니다.');
      }
    }
    window.addSubtaskAsync = addSubtaskAsync;

    async function toggleSubtaskAsync(event, subtaskId, scheduleId) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      try {
        const res = await fetch(`/subtasks/${subtaskId}/toggle`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });
        const data = await res.json();
        if (data && data.success) {
          updateSubtasksDOM(scheduleId, data, subtaskId, 'toggle');
        } else {
          if (typeof showAlert === 'function') showAlert((data && data.error) || '상태 변경에 실패했습니다.');
        }
      } catch (err) {
        console.error('toggleSubtaskAsync error:', err);
        if (typeof showAlert === 'function') showAlert('통신 오류가 발생했습니다.');
      }
    }
    window.toggleSubtaskAsync = toggleSubtaskAsync;

    async function deleteSubtaskAsync(event, subtaskId, scheduleId) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      try {
        const res = await fetch(`/subtasks/${subtaskId}/delete`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });
        const data = await res.json();
        if (data && data.success) {
          updateSubtasksDOM(scheduleId, data, subtaskId, 'delete');
        } else {
          if (typeof showAlert === 'function') showAlert((data && data.error) || '삭제에 실패했습니다.');
        }
      } catch (err) {
        console.error('deleteSubtaskAsync error:', err);
        if (typeof showAlert === 'function') showAlert('통신 오류가 발생했습니다.');
      }
    }
    window.deleteSubtaskAsync = deleteSubtaskAsync;

    function splitSubtasksAi(scheduleId) {
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = `/schedules/${scheduleId}/subtasks/ai-split`;
      document.body.appendChild(f);
      f.submit();
    }
    window.splitSubtasksAi = splitSubtasksAi;

    function updateSubtasksDOM(scheduleId, data, subtaskId, action) {
      const containers = document.querySelectorAll(`.subtasks-container[data-schedule-id="${scheduleId}"]`);
      containers.forEach(container => {
        // 1. 진행률 텍스트 및 프로그레스 바 갱신
        const percentText = container.querySelector('.subtask-percent-text');
        if (percentText) percentText.textContent = `${data.progressPercent}%`;

        const countText = container.querySelector('.subtask-count-text');
        if (countText) {
          countText.textContent = `${data.completedSubtasks}/${data.totalSubtasks} (${data.progressPercent}%)`;
        }

        const bar = container.querySelector('.subtask-progress-bar');
        if (bar) bar.style.width = `${data.progressPercent}%`;

        const list = container.querySelector('.subtask-list');
        if (!list) return;

        // 2. 항목 추가인 경우
        if (data.subtask && !action) {
          const st = data.subtask;
          const li = document.createElement('li');
          li.className = `subtask-item ${st.is_done ? 'done' : ''}`;
          li.setAttribute('data-subtask-id', st.id);
          li.innerHTML = `
            <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-1 text-start flex-grow-1" style="font-size: 0.8rem;" onclick="toggleSubtaskAsync(event, ${st.id}, ${scheduleId})">
              <i class="bi ${st.is_done ? 'bi-check-square-fill text-success' : 'bi-square text-secondary'}"></i>
              <span class="text-truncate" style="max-width: 140px;">${escapeHtml(st.title)}</span>
            </button>
            <button type="button" class="subtask-delete-btn" onclick="deleteSubtaskAsync(event, ${st.id}, ${scheduleId})" title="하위 할 일 삭제">
              <i class="bi bi-x"></i>
            </button>
          `;
          list.appendChild(li);
        }

        // 3. 토글인 경우
        if (action === 'toggle' && subtaskId) {
          const li = list.querySelector(`li[data-subtask-id="${subtaskId}"]`);
          if (li) {
            if (data.is_done === 1) {
              li.classList.add('done');
              const icon = li.querySelector('i.bi');
              if (icon) {
                icon.className = 'bi bi-check-square-fill text-success';
              }
            } else {
              li.classList.remove('done');
              const icon = li.querySelector('i.bi');
              if (icon) {
                icon.className = 'bi bi-square text-secondary';
              }
            }
          }
        }

        // 4. 삭제인 경우
        if (action === 'delete' && subtaskId) {
          const li = list.querySelector(`li[data-subtask-id="${subtaskId}"]`);
          if (li) {
            li.remove();
          }
        }
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // ==========================================
    // Calendar Mode Async Form Handler (stastics.md 3번)
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      const editForm = document.getElementById('editScheduleForm');
      if (editForm) {
        editForm.addEventListener('submit', async function(e) {
          const calTab = document.getElementById('calendar-tab');
          const isCalendarActive = calTab && calTab.classList.contains('active');

          if (isCalendarActive) {
            e.preventDefault();
            const formData = new FormData(editForm);
            const bodyObj = {
              title: formData.get('title'),
              due_datetime: formData.get('due_datetime'),
              category: formData.get('category'),
              description: formData.get('description'),
              status: formData.get('status'),
              is_top3: formData.get('is_top3') ? '1' : '0',
              is_important: formData.get('is_important') ? '1' : '0'
            };
            const scheduleId = editForm.getAttribute('data-schedule-id');

            try {
              const res = await fetch(editForm.action, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify(bodyObj)
              });
              const data = await res.json();
              if (data && data.success) {
                // 1. 모달 닫기
                const modalEl = document.getElementById('editScheduleModal');
                const m = bootstrap.Modal.getInstance(modalEl);
                if (m) m.hide();

                // 2. userSchedules 전역 데이터 갱신
                if (typeof userSchedules !== 'undefined' && data.schedule) {
                  const target = userSchedules.find(x => String(x.id) === String(scheduleId));
                  if (target) {
                    Object.assign(target, data.schedule);
                  }
                }

                // 3. 캘린더 실시간 갱신 (탭 유지!)
                if (typeof renderCalendar === 'function') {
                  renderCalendar();
                }

                // 4. 칸반 보드 백그라운드 동기화
                if (bodyObj.status && typeof syncScheduleStatusInKanban === 'function') {
                  syncScheduleStatusInKanban(scheduleId, bodyObj.status);
                }

                // 5. 생산성 통계 도넛 차트 갱신
                if (typeof refreshProductivityStats === 'function') {
                  refreshProductivityStats(data.stats);
                }

                if (typeof showAlert === 'function') {
                  showAlert('일정이 수정되었습니다.');
                }
              } else {
                if (typeof showAlert === 'function') {
                  showAlert((data && data.error) || '일정 수정에 실패했습니다.');
                }
              }
            } catch (err) {
              console.error('Edit schedule async error:', err);
              if (typeof showAlert === 'function') {
                showAlert('일정 수정 중 통신 오류가 발생했습니다.');
              }
            }
          }
        });
      }
    });
  </script>
  <%- include('partials/mini-timer') %>
