                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace team-schedule-badge-team" style="font-size: 0.72rem;">
                            <%= s.team_name %>
                          </span>
                          <span class="badge bg-light text-secondary border small team-schedule-badge-author">
                            <i class="bi bi-person me-1"></i><%= s.author_name %> (<%= s.author_position || '팀원' %>)
                          </span>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark"><%= s.title %></h6>
                        <div class="small text-muted mb-2">
                          <% if (s.due_datetime) { %>
                            <i class="bi bi-clock me-1"></i><%= s.due_datetime %>
                          <% } else { %>
                            <span class="badge bg-secondary text-white"><i class="bi bi-infinity me-1"></i>상시 일정</span>
                          <% } %>
                        </div>
                        <% if (s.linked_notes && s.linked_notes.length > 0) { %>
                          <div class="mb-2 d-flex flex-wrap gap-1">
                            <% s.linked_notes.forEach(note => { %>
                              <a href="/notes?noteId=<%= note.id %>" class="badge bg-light text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="연결된 문서: <%= note.title %>">
                                <i class="bi bi-file-earmark-text"></i> <%= note.title %>
                              </a>
                            <% }) %>
                          </div>
                        <% } %>
                        <% if (s.description) { %>
                          <p class="small text-secondary preserve-lines bg-light p-2 rounded mb-2"><%= s.description %></p>
                        <% } %>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
