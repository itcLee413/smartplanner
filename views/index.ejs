    let layoutSaveDebounce = null;
    function saveDashboardLayoutChange() {
      clearTimeout(layoutSaveDebounce);
      layoutSaveDebounce = setTimeout(async () => {
        if (!dashboardGrid) return;
        try {
          const serialized = dashboardGrid.save(false);
          const layoutData = serialized.map(item => ({
            id: item.id,
            x: item.x,
            y: item.y,
            w: item.w,
            h: item.h
          }));
          await fetch('/api/dashboard/layout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ layout: layoutData })
          });
        } catch (err) {
          console.error('Failed to auto-save dashboard layout:', err);
        }
      }, 400);
    }

    // Clock Widget Logic
    function initClockWidget() {
      function updateClock() {
        const timeEl = document.getElementById('realtimeClockDisplay');
        const dateEl = document.getElementById('realtimeDateDisplay');
        if (!timeEl || !dateEl) return;
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        timeEl.textContent = `${h}:${m}:${s}`;

        const days = ['일요일', '월요일', '화요일', '수요일', '목요일', '금요일', '토요일'];
        dateEl.textContent = `${now.getFullYear()}년 ${now.getMonth() + 1}월 ${now.getDate()}일 ${days[now.getDay()]}`;
      }
      setInterval(updateClock, 1000);
      updateClock();
    }

    function startClockPomodoro() {
