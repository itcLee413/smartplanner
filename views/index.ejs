    // ==========================================
    // 2. Pomodoro Timer Logic & Sound System
    // ==========================================
    let isDemoMode = false;
    let timerTotalSeconds = 25 * 60;
    let timerRemainingSeconds = 25 * 60;
    let timerInterval = null;
    let isRunning = false;

    // Web Audio API AudioContext
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // Default Sound 1: 부드러운 차임벨 (Soft Chime)
    function playSoftChime() {
      try {
        const ctx = getAudioContext();
        const chord = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        chord.forEach((freq, idx) => {
          const startTime = ctx.currentTime + idx * 0.12;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, startTime);

          gain.gain.setValueAtTime(0, startTime);
          gain.gain.linearRampToValueAtTime(0.25, startTime + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 1.6);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(startTime);
          osc.stop(startTime + 1.7);
        });
      } catch (err) {
        console.warn('차임벨 재생 실패:', err);
      }
    }

    // Default Sound 2: 경쾌한 디지털 알람 (Lively Digital Alarm)
    function playDigitalAlarm() {
      try {
        const ctx = getAudioContext();
        const beeps = [
          { freq: 880, start: 0, dur: 0.12 },
          { freq: 1174.66, start: 0.15, dur: 0.12 },
          { freq: 880, start: 0.35, dur: 0.12 },
          { freq: 1174.66, start: 0.50, dur: 0.18 },
          { freq: 1396.91, start: 0.72, dur: 0.28 }
        ];
        beeps.forEach(b => {
          const startTime = ctx.currentTime + b.start;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(b.freq, startTime);

          gain.gain.setValueAtTime(0.22, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + b.dur);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(startTime);
          osc.stop(startTime + b.dur + 0.05);
        });
      } catch (err) {
        console.warn('디지털 알람 재생 실패:', err);
      }
    }

    // Default Sound 3: 맑은 마림바 벨 (Clear Marimba Bell)
    function playMarimbaBell() {
      try {
        const ctx = getAudioContext();
        const notes = [440, 554.37, 659.25, 880]; // A4, C#5, E5, A5
        notes.forEach((freq, idx) => {
          const startTime = ctx.currentTime + idx * 0.09;
          
          // Fundamental
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, startTime);

          gain.gain.setValueAtTime(0, startTime);
          gain.gain.linearRampToValueAtTime(0.28, startTime + 0.008);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.85);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(startTime);
          osc.stop(startTime + 0.9);

          // Wood resonance overtone
          const overtone = ctx.createOscillator();
          const overtoneGain = ctx.createGain();
          overtone.type = 'sine';
          overtone.frequency.setValueAtTime(freq * 3, startTime);

          overtoneGain.gain.setValueAtTime(0, startTime);
          overtoneGain.gain.linearRampToValueAtTime(0.09, startTime + 0.004);
          overtoneGain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.22);

          overtone.connect(overtoneGain);
          overtoneGain.connect(ctx.destination);
          overtone.start(startTime);
          overtone.stop(startTime + 0.25);
        });
      } catch (err) {
        console.warn('마림바 벨 재생 실패:', err);
      }
    }

    // ------------------------------------------
    // IndexedDB Custom Audio Storage (Max 3 files)
    // ------------------------------------------
    const AUDIO_DB_NAME = 'WebPlannerAudioDB';
    const AUDIO_STORE_NAME = 'custom_sounds';
    const AUDIO_DB_VERSION = 1;

    function openAudioDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(AUDIO_DB_NAME, AUDIO_DB_VERSION);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(AUDIO_STORE_NAME)) {
            db.createObjectStore(AUDIO_STORE_NAME, { keyPath: 'id' });
          }
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }

    async function loadCustomSounds() {
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
        const store = tx.objectStore(AUDIO_STORE_NAME);
        const req = store.getAll();

        req.onsuccess = () => {
          const sounds = req.result || [];
          const optgroup = document.getElementById('customSoundOptgroup');
          const countBadge = document.getElementById('customSoundCountBadge');
          const listContainer = document.getElementById('customSoundList');

          if (countBadge) countBadge.textContent = `${sounds.length} / 3`;
          if (optgroup) optgroup.innerHTML = '';
          if (listContainer) listContainer.innerHTML = '';

          sounds.forEach(sound => {
            // Add to dropdown
            if (optgroup) {
              const opt = document.createElement('option');
              opt.value = `custom_${sound.id}`;
              opt.textContent = `📁 ${sound.name}`;
              optgroup.appendChild(opt);
            }

            // Add to manage list
            if (listContainer) {
              const itemDiv = document.createElement('div');
              itemDiv.className = 'custom-sound-item';
              itemDiv.innerHTML = `
                <span class="text-truncate me-2 text-white" style="max-width: 170px;" title="${sound.name}">
                  <i class="bi bi-file-earmark-music me-1"></i>${sound.name}
                </span>
                <div class="d-flex align-items-center gap-1">
                  <button type="button" class="btn btn-sm btn-link text-white p-0" onclick="playCustomSoundById(${sound.id})" title="미리듣기">
                    <i class="bi bi-play-circle"></i>
                  </button>
                  <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="deleteCustomAudio(${sound.id})" title="삭제">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              `;
              listContainer.appendChild(itemDiv);
            }
          });

          // Restore saved selection
          const savedSound = localStorage.getItem('webplanner_pomodoro_sound');
          const select = document.getElementById('pomodoroSoundSelect');
          if (select && savedSound) {
            const hasOption = Array.from(select.options).some(o => o.value === savedSound);
            if (hasOption) {
              select.value = savedSound;
            } else {
              select.value = 'chime';
            }
          }
        };
      } catch (err) {
        console.error('커스텀 오디오 목록 로드 실패:', err);
      }
    }

    function onSoundSelectionChange() {
      const select = document.getElementById('pomodoroSoundSelect');
      if (select) {
        localStorage.setItem('webplanner_pomodoro_sound', select.value);
        if (typeof window.updateMiniTimerSound === 'function') {
          window.updateMiniTimerSound(select.value);
        }
      }
    }

    function toggleCustomSoundManager() {
      const area = document.getElementById('customSoundManagerArea');
      if (area) {
        area.classList.toggle('d-none');
      }
    }

    async function uploadCustomAudio() {
      const fileInput = document.getElementById('customAudioFileInput');
      if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        alert('업로드할 오디오 파일(.mp3, .wav)을 선택해 주세요.');
        return;
      }
      const file = fileInput.files[0];
      const validTypes = ['audio/mpeg', 'audio/mp3', 'audio/wav', 'audio/x-wav'];
      const ext = file.name.split('.').pop().toLowerCase();
      if (!validTypes.includes(file.type) && ext !== 'mp3' && ext !== 'wav') {
        alert('.mp3 또는 .wav 파일만 등록 가능합니다.');
        return;
      }

      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
        const countReq = tx.objectStore(AUDIO_STORE_NAME).count();

        countReq.onsuccess = () => {
          if (countReq.result >= 3) {
            alert('커스텀 오디오 파일은 최대 3개까지만 등록할 수 있습니다.\n기존 등록된 파일을 삭제한 후 다시 시도해 주세요.');
            return;
          }

          const reader = new FileReader();
          reader.onload = async (e) => {
            const arrayBuffer = e.target.result;
            const newSound = {
              id: Date.now(),
              name: file.name,
              type: file.type || (ext === 'wav' ? 'audio/wav' : 'audio/mpeg'),
              data: arrayBuffer,
              createdAt: Date.now()
            };

            const writeTx = db.transaction(AUDIO_STORE_NAME, 'readwrite');
            writeTx.objectStore(AUDIO_STORE_NAME).add(newSound);
            writeTx.oncomplete = () => {
              fileInput.value = '';
              loadCustomSounds().then(() => {
                const select = document.getElementById('pomodoroSoundSelect');
                if (select) {
                  select.value = `custom_${newSound.id}`;
                  onSoundSelectionChange();
                }
                if (typeof window.loadCustomSoundsIntoMiniTimer === 'function') {
                  window.loadCustomSoundsIntoMiniTimer();
                }
                alert(`오디오 파일 "${file.name}"이(가) 등록되었습니다.`);
              });
            };
          };
          reader.readAsArrayBuffer(file);
        };
      } catch (err) {
        alert('오디오 파일 저장 중 오류가 발생했습니다: ' + err.message);
      }
    }

    async function deleteCustomAudio(id) {
      const ok = await showConfirm('이 커스텀 알림음을 삭제하시겠습니까?');
      if (!ok) return;
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readwrite');
        tx.objectStore(AUDIO_STORE_NAME).delete(id);
        tx.oncomplete = () => {
          const select = document.getElementById('pomodoroSoundSelect');
          if (select && select.value === `custom_${id}`) {
            select.value = 'chime';
            onSoundSelectionChange();
          }
          loadCustomSounds();
          if (typeof window.loadCustomSoundsIntoMiniTimer === 'function') {
            window.loadCustomSoundsIntoMiniTimer();
          }
        };
      } catch (err) {
        alert('삭제 중 오류가 발생했습니다: ' + err.message);
      }
    }

    async function playCustomSoundById(id) {
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
        const req = tx.objectStore(AUDIO_STORE_NAME).get(id);
        req.onsuccess = () => {
          const record = req.result;
          if (record && record.data) {
            const blob = new Blob([record.data], { type: record.type || 'audio/mpeg' });
            const url = URL.createObjectURL(blob);
            const audio = new Audio(url);
            audio.play().catch(e => {
              console.warn('커스텀 오디오 재생 실패, 기본 알림음으로 대체:', e);
              playSoftChime();
            });
          } else {
            playSoftChime();
          }
        };
      } catch (err) {
        playSoftChime();
      }
    }

    async function playCurrentPomodoroSound() {
      const select = document.getElementById('pomodoroSoundSelect');
      const soundVal = select ? select.value : 'chime';

      if (soundVal === 'chime') {
        playSoftChime();
      } else if (soundVal === 'alarm') {
        playDigitalAlarm();
      } else if (soundVal === 'marimba') {
        playMarimbaBell();
      } else if (soundVal && soundVal.startsWith('custom_')) {
        const customId = parseInt(soundVal.replace('custom_', ''), 10);
        await playCustomSoundById(customId);
      } else {
        playSoftChime();
      }
    }

    function previewCurrentSound() {
      getAudioContext(); // Ensure context is active on click
      playCurrentPomodoroSound();
