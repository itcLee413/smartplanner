      <!-- 5. Realtime Clock & Date Widget -->
      <% if (clockConf && clockConf.enabled !== false) { %>
      <div class="grid-stack-item" gs-id="clock" gs-x="<%= clockConf.x %>" gs-y="<%= clockConf.y %>" gs-w="<%= clockConf.w %>" gs-h="<%= clockConf.h %>" data-title="실시간 디지털 시계 & 오늘의 날짜">
        <div class="grid-stack-item-content">
          <div class="card card-custom h-100 d-flex flex-column" id="widget-card-clock">
            <!-- Drag Handle Bar -->
            <div class="widget-drag-handle">
              <div class="handle-title">
                <i class="bi bi-grip-horizontal text-secondary"></i>
                <i class="bi bi-clock-fill text-danger ms-1"></i>
                <span>실시간 시계 & 집중</span>
              </div>
              <div class="handle-actions d-flex align-items-center gap-2">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle smaller">Live</span>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-pip-toggle" onclick="event.stopPropagation(); togglePipWidget('clock')" title="팝업(PIP) 모드로 분리">
                  <i class="bi bi-pip"></i> <span class="d-none d-sm-inline ms-1 smaller">팝업 띄우기</span>
                </button>
              </div>
            </div>
            <div class="card-body p-3 clock-widget-body flex-grow-1">
