    // ==========================================
    // Custom Widget Read-Only Data Bridge (WS_CONTEXT) (moduleplus.md)
    // ==========================================
    const wsContextData = {
      username: <%- JSON.stringify(user.name || user.username) %>,
      todoCount: <%= schedules.filter(s => s.status === 'TODO').length %>,
      inProgressCount: <%= schedules.filter(s => s.status === 'IN_PROGRESS').length %>,
      doneCount: <%= schedules.filter(s => s.status === 'DONE').length %>,
      top3Titles: <%- JSON.stringify((curTop3 || []).map(s => s.title)) %>
    };

    function sendWsContextToIframe(iframe) {
      if (!iframe) return;
      try {
        const targetWindow = iframe.contentWindow;
        if (targetWindow) {
          targetWindow.postMessage({
            type: 'WS_CONTEXT',
            data: wsContextData
          }, '*');
        }
      } catch (err) {
        console.error('Failed to send WS_CONTEXT to iframe:', err);
      }
    }

    // Allow custom widget iframes to request context on demand
    window.addEventListener('message', (event) => {
      if (event.data && event.data.type === 'REQUEST_WS_CONTEXT') {
        const iframes = document.querySelectorAll('iframe.custom-widget-iframe');
        iframes.forEach(iframe => sendWsContextToIframe(iframe));
      }
    });

    // ==========================================
    // Floating PIP (Picture-in-Picture) Logic (ploat.md)
    // ==========================================
    const PIP_STORAGE_KEY = 'worksmarter_pip_states';

    function getPipStorage() {
      try {
        const raw = localStorage.getItem(PIP_STORAGE_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch (e) {
        return {};
      }
    }

    function setPipStorage(data) {
      try {
        localStorage.setItem(PIP_STORAGE_KEY, JSON.stringify(data));
      } catch (e) {}
    }

    function savePipState(widgetId) {
      const pipWin = document.getElementById('pip-win-' + widgetId);
      if (!pipWin) return;
      const storage = getPipStorage();
      const rect = pipWin.getBoundingClientRect();
      const isPinned = pipWin.classList.contains('pip-pinned');
      storage[widgetId] = {
        isPip: true,
        top: Math.round(rect.top),
        left: Math.round(rect.left),
        width: Math.round(rect.width),
        height: Math.round(rect.height),
        pinned: isPinned
      };
      setPipStorage(storage);
    }

    let pipStateDebounce = null;
    function debouncedSavePipState(widgetId) {
      clearTimeout(pipStateDebounce);
      pipStateDebounce = setTimeout(() => savePipState(widgetId), 200);
    }

    function togglePipWidget(widgetId) {
      const existingPip = document.getElementById('pip-win-' + widgetId);
      if (existingPip) {
        restorePipWidget(widgetId);
      } else {
        openPipWidget(widgetId);
      }
    }

    function openPipWidget(widgetId, savedState = null) {
      const gridItem = document.querySelector(`.grid-stack-item[gs-id="${widgetId}"]`);
      if (!gridItem) return;

      const itemContent = gridItem.querySelector('.grid-stack-item-content');
      if (!itemContent) return;

      const widgetCard = document.getElementById('widget-card-' + widgetId) || 
                         (widgetId === 'top3' ? document.getElementById('top3-dropzone') : null) || 
                         itemContent.querySelector('.card-custom');
      if (!widgetCard) return;

      // Check if already in PIP
      if (document.getElementById('pip-win-' + widgetId)) return;

      // 1. Get widget title
      const titleAttr = gridItem.getAttribute('data-title');
      const handleTitleSpan = widgetCard.querySelector('.handle-title span');
      const widgetTitle = titleAttr || (handleTitleSpan ? handleTitleSpan.textContent.trim() : '위젯');

      // 2. Insert placeholder in grid cell (preserve original position and size)
      const placeholder = document.createElement('div');
      placeholder.id = 'pip-placeholder-' + widgetId;
      placeholder.className = 'pip-grid-placeholder';
      placeholder.innerHTML = `
        <i class="bi bi-pip"></i>
        <div class="fw-semibold small mb-2">팝업(PIP) 모드로 표시 중</div>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-1" onclick="restorePipWidget('${widgetId}')">
          <i class="bi bi-box-arrow-in-down-left me-1"></i>원래 위치로 복귀
        </button>
      `;
      itemContent.appendChild(placeholder);

      // 3. Create floating PIP window element
      const pipContainer = document.getElementById('pipFloatingContainer') || document.body;
      const pipWin = document.createElement('div');
      pipWin.id = 'pip-win-' + widgetId;
      pipWin.className = 'pip-floating-window';
      pipWin.setAttribute('data-widget-id', widgetId);

      // Restore coordinates and sizes
      const storage = getPipStorage();
      const state = savedState || storage[widgetId] || {};
      const isPinned = Boolean(state.pinned);

      // Default cascade positioning
      const existingWins = document.querySelectorAll('.pip-floating-window');
      const winCount = existingWins.length;
      let top = typeof state.top === 'number' ? state.top : (80 + (winCount * 30));
      let left = typeof state.left === 'number' ? state.left : (window.innerWidth - 480 - (winCount * 25));
      let width = typeof state.width === 'number' ? state.width : 440;
      let height = typeof state.height === 'number' ? state.height : 360;

      // Viewport safety bounds
      top = Math.max(10, Math.min(top, window.innerHeight - 100));
      left = Math.max(10, Math.min(left, window.innerWidth - 150));
      width = Math.max(260, Math.min(width, window.innerWidth - 20));
      height = Math.max(180, Math.min(height, window.innerHeight - 40));

      pipWin.style.top = `${top}px`;
      pipWin.style.left = `${left}px`;
      pipWin.style.width = `${width}px`;
      pipWin.style.height = `${height}px`;

      if (isPinned) {
        pipWin.classList.add('pip-pinned');
        pipWin.style.zIndex = '1070';
      } else {
        pipWin.style.zIndex = '1030';
      }

      pipWin.innerHTML = `
        <div class="pip-header" id="pip-header-${widgetId}">
          <div class="pip-header-left">
            <i class="bi bi-grip-vertical"></i>
            <span class="pip-title-text" title="${widgetTitle}">${widgetTitle}</span>
          </div>
          <div class="pip-header-controls">
            <button type="button" class="pip-btn pip-pin-btn ${isPinned ? 'pip-pin-active' : ''}" id="pip-pin-btn-${widgetId}" onclick="togglePipPin('${widgetId}')" title="${isPinned ? '상단 고정 해제' : '상단 고정하기'}">
              <i class="bi ${isPinned ? 'bi-pin-angle-fill' : 'bi-pin-angle'}"></i>
            </button>
            <button type="button" class="pip-btn pip-close-btn" onclick="restorePipWidget('${widgetId}')" title="팝업 해제하기 (원래 위치로 복귀)">
              <i class="bi bi-box-arrow-in-down-left"></i>
            </button>
          </div>
        </div>
        <div class="pip-body" id="pip-body-${widgetId}"></div>
      `;

      pipContainer.appendChild(pipWin);

      // 4. Move actual widget DOM node into PIP body (preserves all states and events)
      const pipBody = pipWin.querySelector('.pip-body');
      pipBody.appendChild(widgetCard);

      // If iframe inside, re-send WS_CONTEXT
      const iframe = widgetCard.querySelector('iframe.custom-widget-iframe');
      if (iframe) {
        sendWsContextToIframe(iframe);
      }

      // 5. Initialize Dragging on header
      const header = pipWin.querySelector('.pip-header');
      initPipDrag(pipWin, header, widgetId);

      // 6. Initialize ResizeObserver (and Chart resize)
      const ro = new ResizeObserver(() => {
        if (widgetId === 'stats' && window.productivityChart && typeof window.productivityChart.resize === 'function') {
          try { window.productivityChart.resize(); } catch (e) {}
        }
        debouncedSavePipState(widgetId);
      });
      ro.observe(pipWin);
      pipWin._pipResizeObserver = ro;

      // Bring unpinned windows to front on click
      pipWin.addEventListener('mousedown', () => {
        if (!pipWin.classList.contains('pip-pinned')) {
          document.querySelectorAll('.pip-floating-window:not(.pip-pinned)').forEach(w => {
            w.style.zIndex = '1030';
          });
          pipWin.style.zIndex = '1035';
        }
      });

      // If chart widget, resize chart immediately after move
      if (widgetId === 'stats' && window.productivityChart && typeof window.productivityChart.resize === 'function') {
        setTimeout(() => {
          try { window.productivityChart.resize(); } catch (e) {}
        }, 50);
      }

      // Save state
      savePipState(widgetId);
    }

    function restorePipWidget(widgetId) {
      const pipWin = document.getElementById('pip-win-' + widgetId);
      if (!pipWin) return;

      const widgetCard = pipWin.querySelector('.pip-body > .card-custom');
      const placeholder = document.getElementById('pip-placeholder-' + widgetId);
      const gridItem = document.querySelector(`.grid-stack-item[gs-id="${widgetId}"]`);

      if (gridItem) {
        const itemContent = gridItem.querySelector('.grid-stack-item-content');
        if (placeholder) placeholder.remove();
        if (widgetCard && itemContent) {
          itemContent.appendChild(widgetCard);
        }
      }

      if (pipWin._pipResizeObserver) {
        pipWin._pipResizeObserver.disconnect();
      }
      pipWin.remove();

      // Remove from localStorage
      const storage = getPipStorage();
      delete storage[widgetId];
      setPipStorage(storage);

      // If chart widget, resize
      if (widgetId === 'stats' && window.productivityChart && typeof window.productivityChart.resize === 'function') {
        setTimeout(() => {
          try { window.productivityChart.resize(); } catch (e) {}
        }, 50);
      }

      // If iframe inside, re-send WS_CONTEXT
      if (widgetCard) {
        const iframe = widgetCard.querySelector('iframe.custom-widget-iframe');
        if (iframe) sendWsContextToIframe(iframe);
      }
    }

    function togglePipPin(widgetId) {
      const pipWin = document.getElementById('pip-win-' + widgetId);
      const pinBtn = document.getElementById('pip-pin-btn-' + widgetId);
      if (!pipWin || !pinBtn) return;

      const isPinned = pipWin.classList.toggle('pip-pinned');
      if (isPinned) {
        pipWin.style.zIndex = '1070';
        pinBtn.classList.add('pip-pin-active');
        pinBtn.title = '상단 고정 해제';
        pinBtn.innerHTML = '<i class="bi bi-pin-angle-fill"></i>';
      } else {
        pipWin.style.zIndex = '1030';
        pinBtn.classList.remove('pip-pin-active');
        pinBtn.title = '상단 고정하기';
        pinBtn.innerHTML = '<i class="bi bi-pin-angle"></i>';
      }
      savePipState(widgetId);
    }

    function initPipDrag(pipWin, header, widgetId) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let startLeft = 0, startTop = 0;

      header.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        if (e.target.closest('button')) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        const rect = pipWin.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;

        header.style.cursor = 'grabbing';
        document.body.style.userSelect = 'none';

        function onMouseMove(ev) {
          if (!isDragging) return;
          const dx = ev.clientX - startX;
          const dy = ev.clientY - startY;

          let newLeft = startLeft + dx;
          let newTop = startTop + dy;

          const maxLeft = Math.max(0, window.innerWidth - pipWin.offsetWidth);
          const maxTop = Math.max(0, window.innerHeight - pipWin.offsetHeight);

          newLeft = Math.max(0, Math.min(newLeft, maxLeft));
          newTop = Math.max(0, Math.min(newTop, maxTop));

          pipWin.style.left = `${newLeft}px`;
          pipWin.style.top = `${newTop}px`;
        }

        function onMouseUp() {
          if (isDragging) {
            isDragging = false;
            header.style.cursor = 'grab';
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            savePipState(widgetId);
          }
        }

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });
    }

    function restoreSavedPipWindows() {
      const storage = getPipStorage();
      Object.keys(storage).forEach(widgetId => {
        const item = storage[widgetId];
        if (item && item.isPip) {
          openPipWidget(widgetId, item);
        }
      });
    }

    // ------------------------------------------
    // Timer Controls Logic (Synchronized with Global Persistent Pomodoro Engine)
    // ------------------------------------------
    function updateTimerDisplay() {
      const s = Math.max(0, Math.floor(timerRemainingSeconds));
      const mins = Math.floor(s / 60);
      const secs = s % 60;
      const displayEl = document.getElementById('timerDisplay');
      if (displayEl) {
        displayEl.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      }
    }

    function syncDashboardWithPomodoro(detail) {
      const startBtn = document.getElementById('timerStartBtn');
      const pauseBtn = document.getElementById('timerPauseBtn');
      const statusText = document.getElementById('timerStatusText');

      if (!detail || !detail.state) {
        isRunning = false;
        timerRemainingSeconds = isDemoMode ? 60 : 25 * 60;
        timerTotalSeconds = timerRemainingSeconds;
        updateTimerDisplay();
        if (startBtn) startBtn.disabled = false;
        if (pauseBtn) pauseBtn.disabled = true;
        if (statusText) statusText.textContent = isDemoMode ? '⚡ 1분 시연 모드 준비됨' : '준비 완료 • 지금 바로 몰입을 시작하세요';
        return;
      }

      const state = detail.state;
      const remaining = (detail.remainingSeconds !== undefined) ? detail.remainingSeconds : state.remainingSeconds;

      // Sync demo mode from state
      if (state.durationMinutes === 1 && !isDemoMode) {
        isDemoMode = true;
        timerTotalSeconds = 60;
        const modeLabel = document.getElementById('modeLabel');
        const modeToggleBtn = document.getElementById('modeToggleBtn');
        if (modeLabel) modeLabel.textContent = '25분 정규 모드 전환';
        if (modeToggleBtn) modeToggleBtn.classList.replace('btn-outline-light', 'btn-warning');
      } else if (state.durationMinutes !== 1 && isDemoMode) {
        isDemoMode = false;
        timerTotalSeconds = 25 * 60;
        const modeLabel = document.getElementById('modeLabel');
        const modeToggleBtn = document.getElementById('modeToggleBtn');
        if (modeLabel) modeLabel.textContent = '1분 시연 모드 전환';
        if (modeToggleBtn) modeToggleBtn.classList.replace('btn-warning', 'btn-outline-light');
      }

      // Sync active schedule title/id
      if (state.scheduleTitle) {
        const titleEl = document.getElementById('activeScheduleTitle');
        if (titleEl) titleEl.textContent = state.scheduleTitle;
      }
      if (state.scheduleId !== undefined && state.scheduleId !== null) {
        const idEl = document.getElementById('activeScheduleId');
        if (idEl) idEl.value = state.scheduleId;
      }

      timerRemainingSeconds = remaining;
      isRunning = !!state.isRunning;
      updateTimerDisplay();

      if (isRunning) {
        if (startBtn) startBtn.disabled = true;
        if (pauseBtn) pauseBtn.disabled = false;
        if (statusText) statusText.textContent = '🔥 몰입 집중 중... 끝까지 완수하세요!';
      } else {
        if (startBtn) startBtn.disabled = false;
        if (pauseBtn) pauseBtn.disabled = true;
        if (statusText) statusText.textContent = (remaining < timerTotalSeconds) ? '⏸ 일시 정지됨' : '준비 완료 • 지금 바로 몰입을 시작하세요';
      }
    }

    function initDashboardPomodoro() {
      // 1. Initial sync from localStorage
      try {
        const saved = localStorage.getItem('pomodoroState');
        if (saved) {
          const state = JSON.parse(saved);
          let rem = state.remainingSeconds;
          if (state.isRunning && state.endTime) {
            rem = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
          }
          syncDashboardWithPomodoro({ remainingSeconds: rem, isRunning: state.isRunning, state });
        } else {
          syncDashboardWithPomodoro(null);
        }
      } catch (e) {
        syncDashboardWithPomodoro(null);
      }

      // 2. Listen to custom event from mini-timer engine
      window.addEventListener('pomodoroTick', (e) => {
        syncDashboardWithPomodoro(e.detail);
      });

      window.addEventListener('pomodoroCompleted', (e) => {
        const displayEl = document.getElementById('timerDisplay');
        const statusEl = document.getElementById('timerStatusText');
        const startBtn = document.getElementById('timerStartBtn');
        const pauseBtn = document.getElementById('timerPauseBtn');
        if (displayEl) displayEl.textContent = "완료! 🎉";
        if (statusEl) statusEl.textContent = "축하합니다! 집중을 완수했습니다.";
        if (startBtn) startBtn.disabled = false;
        if (pauseBtn) pauseBtn.disabled = true;
      });

      // 3. Listen to cross-tab storage changes
      window.addEventListener('storage', (e) => {
        if (e.key === 'pomodoroState') {
          if (!e.newValue) {
            syncDashboardWithPomodoro(null);
          } else {
            try {
              const state = JSON.parse(e.newValue);
              let rem = state.remainingSeconds;
              if (state.isRunning && state.endTime) {
                rem = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
              }
              syncDashboardWithPomodoro({ remainingSeconds: rem, isRunning: state.isRunning, state });
            } catch (err) {}
          }
        }
      });
    }

    async function togglePomodoroMode() {
      let state = null;
      try {
        const saved = localStorage.getItem('pomodoroState');
        if (saved) state = JSON.parse(saved);
      } catch (e) {}

      if (state && (state.isRunning || state.remainingSeconds < (state.durationMinutes * 60))) {
        const ok = await showConfirm('타이머가 동작 중이거나 진행 중인 세션이 있습니다. 모드를 변경하면 초기화됩니다. 계속하시겠습니까?');
        if (!ok) return;
      }

      resetTimer();
      isDemoMode = !isDemoMode;
      if (isDemoMode) {
        timerTotalSeconds = 60;
        timerRemainingSeconds = 60;
        document.getElementById('modeLabel').textContent = '25분 정규 모드 전환';
        document.getElementById('modeToggleBtn').classList.replace('btn-outline-light', 'btn-warning');
        document.getElementById('timerStatusText').textContent = '⚡ 1분 시연용 단축 모드 활성화됨';
      } else {
        timerTotalSeconds = 25 * 60;
        timerRemainingSeconds = 25 * 60;
        document.getElementById('modeLabel').textContent = '1분 시연 모드 전환';
        document.getElementById('modeToggleBtn').classList.replace('btn-warning', 'btn-outline-light');
        document.getElementById('timerStatusText').textContent = '준비 완료 • 25분 정규 몰입 모드';
      }
      updateTimerDisplay();
    }

    function selectPomodoroSchedule(id, title) {
      document.getElementById('activeScheduleId').value = id;
      document.getElementById('activeScheduleTitle').textContent = title;
      if (typeof window.startGlobalPomodoro === 'function') {
        window.startGlobalPomodoro(id, title, isDemoMode ? 1 : 25);
      }
      if (window.innerWidth < 992) {
        document.querySelector('.pomodoro-box')?.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function startTimer() {
      getAudioContext();
      let state = null;
      try {
        const saved = localStorage.getItem('pomodoroState');
        if (saved) state = JSON.parse(saved);
      } catch (e) {}

      if (state && !state.isRunning && state.remainingSeconds > 0) {
        // Resume paused session
        if (typeof window.resumeGlobalPomodoro === 'function') {
          window.resumeGlobalPomodoro();
        } else if (typeof window.toggleMiniTimerPlayPause === 'function') {
          window.toggleMiniTimerPlayPause();
        }
      } else {
        // Start new session
        const scheduleId = document.getElementById('activeScheduleId')?.value || null;
        const scheduleTitle = document.getElementById('activeScheduleTitle')?.textContent || '선택된 일정 없음 (자유 집중)';
        if (typeof window.startGlobalPomodoro === 'function') {
          window.startGlobalPomodoro(scheduleId, scheduleTitle, isDemoMode ? 1 : 25);
        }
      }
    }

    function pauseTimer() {
      if (typeof window.pauseGlobalPomodoro === 'function') {
        window.pauseGlobalPomodoro();
      } else if (typeof window.toggleMiniTimerPlayPause === 'function') {
        window.toggleMiniTimerPlayPause();
      }
    }

    function resetTimer() {
      if (typeof window.resetGlobalPomodoro === 'function') {
        window.resetGlobalPomodoro();
      }
      localStorage.removeItem('pomodoroState');
      syncDashboardWithPomodoro(null);
    }

    // ==========================================
    // 3. Edit Modal Populator (stastics.md 3번)
    // ==========================================
    function toggleDueInput(checkbox, inputId) {
      const input = document.getElementById(inputId);
      if (!input) return;
      if (checkbox.checked) {
        input.dataset.oldValue = input.value;
        input.value = '';
        input.disabled = true;
        input.required = false;
      } else {
        input.disabled = false;
        input.required = true;
        if (input.dataset.oldValue) {
          input.value = input.dataset.oldValue;
        }
      }
    }
    window.toggleDueInput = toggleDueInput;

    async function updateUndatedStatus(scheduleId, newStatus) {
      try {
        const res = await fetch(`/schedules/${scheduleId}/status`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();
        if (data.success) {
          if (typeof showAlert === 'function') {
            showAlert('일정 상태가 변경되었습니다.');
          }
          if (typeof userSchedules !== 'undefined') {
            const s = userSchedules.find(x => String(x.id) === String(scheduleId));
            if (s) s.status = newStatus;
          }
          setTimeout(() => location.reload(), 500);
        } else {
          if (typeof showAlert === 'function') {
            showAlert(data.error || '상태 변경에 실패했습니다.');
          }
        }
      } catch (err) {
        if (typeof showAlert === 'function') {
          showAlert('상태 변경 중 통신 오류가 발생했습니다.');
        }
      }
    }
    window.updateUndatedStatus = updateUndatedStatus;

    function openEditModal(id, title, description, dueDateTime, category, isTop3, isImportant, status) {
      const form = document.getElementById('editScheduleForm');
      form.action = `/schedules/${id}/update`;
      form.setAttribute('data-schedule-id', id);
      document.getElementById('editTitle').value = title;
      document.getElementById('editDescription').value = description;

      const noDeadlineCheck = document.getElementById('editNoDeadline');
      const dueInput = document.getElementById('editDueDateTime');
      if (!dueDateTime || dueDateTime === 'null' || dueDateTime.trim() === '') {
        if (noDeadlineCheck) noDeadlineCheck.checked = true;
        if (dueInput) {
          dueInput.value = '';
          dueInput.disabled = true;
          dueInput.required = false;
        }
      } else {
        if (noDeadlineCheck) noDeadlineCheck.checked = false;
        if (dueInput) {
          dueInput.value = dueDateTime.replace(' ', 'T').slice(0, 16);
          dueInput.disabled = false;
          dueInput.required = true;
        }
      }

      document.getElementById('editCategory').value = category || '개인';
      document.getElementById('editIsTop3').checked = (parseInt(isTop3, 10) === 1);
      document.getElementById('editIsImportant').checked = (parseInt(isImportant, 10) === 1);
      
      const statusEl = document.getElementById('editStatus');
      if (statusEl) {
        statusEl.value = status || 'TODO';
      }
      
      const modal = new bootstrap.Modal(document.getElementById('editScheduleModal'));
      modal.show();
    }

    function openEditModalForScheduleId(id) {
      if (typeof userSchedules !== 'undefined') {
        const sched = userSchedules.find(x => String(x.id) === String(id));
        if (sched) {
          openEditModal(sched.id, sched.title, sched.description || '', sched.due_datetime, sched.category, sched.is_top3, sched.is_important, sched.status);
          return;
        }
      }
      const modal = new bootstrap.Modal(document.getElementById('editScheduleModal'));
      modal.show();
    }

    window.openEditModal = openEditModal;
    window.openEditModalForScheduleId = openEditModalForScheduleId;

