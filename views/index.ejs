                            </div>
                            <div class="progress mb-2" style="height: 4px;">
                              <div class="progress-bar bg-success subtask-progress-bar" role="progressbar" style="width: <%= s.percent %>%;"></div>
                            </div>
                            <ul class="subtask-list mb-2">
                              <% (s.subtasks || []).forEach(st => { %>
                                <li class="subtask-item <%= st.is_done ? 'done' : '' %>" data-subtask-id="<%= st.id %>">
                                  <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-1 text-start flex-grow-1" style="font-size: 0.8rem;" onclick="toggleSubtaskAsync(event, <%= st.id %>, <%= s.id %>)">
                                    <i class="bi <%= st.is_done ? 'bi-check-square-fill text-success' : 'bi-square text-secondary' %>"></i>
                                    <span class="text-truncate" style="max-width: 140px;"><%= st.title %></span>
                                  </button>
                                  <button type="button" class="subtask-delete-btn" onclick="deleteSubtaskAsync(event, <%= st.id %>, <%= s.id %>)" title="하위 할 일 삭제">
                                    <i class="bi bi-x"></i>
                                  </button>
                                </li>
                              <% }) %>
                            </ul>
                            <!-- Quick Inline Subtask Form -->
                            <form class="subtask-quick-form mb-2" onsubmit="addSubtaskAsync(event, <%= s.id %>, this)">
                              <input type="text" name="title" class="form-control form-control-sm subtask-quick-input" placeholder="세부 할 일 직접 입력..." required>
                              <button type="submit" class="btn btn-outline-primary btn-sm subtask-quick-btn" title="할 일 추가">추가</button>
                            </form>
                          </div>

                          <!-- Restore Button -->
                          <form action="/schedules/<%= s.id %>/status" method="POST" class="m-0">
                            <input type="hidden" name="status" value="TODO">
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100 py-0" style="font-size: 0.75rem;">
                              <i class="bi bi-arrow-counterclockwise"></i> TODO로 되돌리기
                            </button>
                          </form>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                </div>
              </div>

              <!-- ========================================== -->
              <!-- TAB 2: Monthly Calendar View               -->
              <!-- ========================================== -->
              <div class="tab-pane fade" id="calendarView" role="tabpanel">
                <!-- 기한 미지정 일정 (상시 일정) 접이식 요약 바 (newdawn.md 1번) -->
                <% const undatedSchedules = schedules.filter(s => !s.due_datetime); %>
                <div class="card border mb-3 shadow-sm rounded-3 undated-summary-bar">
                  <div class="card-header bg-light border-0 px-3 py-2 d-flex align-items-center justify-content-between" 
                       data-bs-toggle="collapse" 
                       data-bs-target="#undatedSchedulesCollapse" 
                       aria-expanded="false" 
                       style="cursor: pointer;">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-clock-history text-secondary"></i>
                      <span class="fw-bold small text-dark">
                        [기한 미지정 일정 (<span id="undatedCountBadge"><%= undatedSchedules.length %></span>건)]
                      </span>
                      <span class="badge bg-secondary text-white smaller">상시 일정</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted small">
                      <span class="smaller text-muted d-none d-sm-inline">클릭하여 펼치기/접기</span>
                      <i class="bi bi-chevron-down toggle-collapse-icon"></i>
                    </div>
                  </div>
                  <div class="collapse <%= undatedSchedules.length > 0 ? '' : '' %>" id="undatedSchedulesCollapse">
                    <div class="card-body p-2 border-top bg-white">
                      <% if (undatedSchedules.length === 0) { %>
                        <div class="text-center py-2 text-muted small" id="undatedEmptyNotice">
                          기한이 지정되지 않은 상시 일정이 없습니다.
                        </div>
                      <% } else { %>
                        <div class="d-flex flex-column gap-2" id="undatedSchedulesList">
                          <% undatedSchedules.forEach(s => { %>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded border bg-light flex-wrap gap-2" id="undatedScheduleItem<%= s.id %>">
                              <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                <span class="badge badge-cat-<%= s.category %> border"><%= s.category %></span>
                                <span class="badge bg-secondary text-white smaller">상시 일정</span>
                                <span class="fw-semibold small text-truncate <%= s.status === 'DONE' ? 'text-decoration-line-through text-muted' : 'text-dark' %>" title="<%= s.title %>">
                                  <%= s.title %>
                                </span>
                                <% if (s.linked_notes && s.linked_notes.length > 0) { %>
                                  <% s.linked_notes.forEach(note => { %>
                                    <a href="/notes?noteId=<%= note.id %>" class="badge bg-white text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="연결된 문서: <%= note.title %>">
                                      <i class="bi bi-file-earmark-text"></i> <%= note.title %>
                                    </a>
                                  <% }) %>
                                <% } %>
                              </div>
                              <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm py-0 ps-2 pe-4" style="font-size: 0.78rem; width: auto;" onchange="updateUndatedStatus(<%= s.id %>, this.value)">
                                  <option value="TODO" <%= s.status === 'TODO' ? 'selected' : '' %>>할 일</option>
                                  <option value="IN_PROGRESS" <%= s.status === 'IN_PROGRESS' ? 'selected' : '' %>>진행 중</option>
                                  <option value="DONE" <%= s.status === 'DONE' ? 'selected' : '' %>>완료</option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="openEditModal('<%= s.id %>', '<%= s.title.replace(/'/g, "\\'") %>', '<%= (s.description || '').replace(/'/g, "\\'").replace(/\n/g, '\\n') %>', '', '<%= s.category %>', '<%= s.is_top3 %>', '<%= s.is_important %>', '<%= s.status %>')" title="일정 수정 및 기한 지정">
                                  <i class="bi bi-pencil"></i>
                                </button>
                              </div>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                  <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h6 class="fw-bold mb-0" id="calendarMonthYearTitle">2026년 11월</h6>
                    <!-- Holiday Country Filter Checkboxes -->
                    <div class="d-flex align-items-center gap-2 small bg-light px-2 py-1 rounded border">
                      <span class="text-secondary fw-semibold"><i class="bi bi-flag-fill me-1"></i>공휴일:</span>
                      <div class="form-check form-check-inline m-0">
                        <input class="form-check-input holiday-country-check" type="checkbox" id="holidayKR" value="KR" checked onchange="renderCalendar()">
                        <label class="form-check-label cursor-pointer" for="holidayKR">🇰🇷 한국</label>
                      </div>
                      <div class="form-check form-check-inline m-0">
                        <input class="form-check-input holiday-country-check" type="checkbox" id="holidayJP" value="JP" onchange="renderCalendar()">
                        <label class="form-check-label cursor-pointer" for="holidayJP">🇯🇵 일본</label>
                      </div>
                      <div class="form-check form-check-inline m-0">
                        <input class="form-check-input holiday-country-check" type="checkbox" id="holidayCN" value="CN" onchange="renderCalendar()">
                        <label class="form-check-label cursor-pointer" for="holidayCN">🇨🇳 중국</label>
                      </div>
                      <div class="form-check form-check-inline m-0">
                        <input class="form-check-input holiday-country-check" type="checkbox" id="holidayUS" value="US" onchange="renderCalendar()">
                        <label class="form-check-label cursor-pointer" for="holidayUS">🇺🇸 미국</label>
                      </div>
                    </div>

                    <!-- Status Legend (stastics.md) -->
                    <div class="d-flex align-items-center gap-1 small bg-light px-2 py-1 rounded border">
                      <span class="text-secondary fw-semibold me-1"><i class="bi bi-circle-fill text-muted" style="font-size: 0.5rem;"></i>상태:</span>
                      <span class="badge cal-status-TODO border px-2 py-1" style="font-size: 0.72rem;">할 일</span>
                      <span class="badge cal-status-IN_PROGRESS border px-2 py-1" style="font-size: 0.72rem;">진행 중</span>
                      <span class="badge cal-status-DONE border px-2 py-1" style="font-size: 0.72rem;">완료</span>
                    </div>
                  </div>

                  <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" onclick="changeMonth(-1)"><i class="bi bi-chevron-left"></i></button>
                    <button type="button" class="btn btn-outline-secondary" onclick="resetToCurrentMonth()">오늘</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changeMonth(1)"><i class="bi bi-chevron-right"></i></button>
                  </div>
                </div>

                <!-- Calendar Days Header -->
                <div class="calendar-grid">
                  <div class="calendar-header-day text-danger">일</div>
                  <div class="calendar-header-day">월</div>
                  <div class="calendar-header-day">화</div>
                  <div class="calendar-header-day">수</div>
                  <div class="calendar-header-day">목</div>
                  <div class="calendar-header-day">금</div>
                  <div class="calendar-header-day text-primary">토</div>
                </div>

                <!-- Calendar Cells Container -->
                <div class="calendar-grid" id="calendarCellsContainer">
                  <!-- Rendered dynamically by JavaScript -->
                </div>
              </div>

            </div> <!-- /workspaceTabContent -->
          </div> <!-- /personalScopeView -->

