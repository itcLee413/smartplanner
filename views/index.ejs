                                    style="font-size: 0.75rem; height: 24px;">
                              <option value="TODO" selected>TODO</option>
                              <option value="IN_PROGRESS">진행 중</option>
                              <option value="DONE">완료</option>
                            </select>
                          </form>
                          <a href="/teams?teamId=<%= s.team_id %>" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem; height: 24px;">
                            <i class="bi bi-box-arrow-up-right me-1"></i>팀으로 이동
                          </a>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <!-- Column 2: IN_PROGRESS -->
                <div class="kanban-col kanban-column" data-status="IN_PROGRESS">
                  <div class="kanban-col-header text-primary">
                    <span><i class="bi bi-hourglass-split me-1"></i> 진행 중 (IN_PROGRESS)</span>
                    <span class="badge bg-primary rounded-pill"><%= teamSchedules.filter(s => s.status === 'IN_PROGRESS').length %></span>
                  </div>
                  <div class="kanban-cards">
                    <% teamSchedules.filter(s => s.status === 'IN_PROGRESS').forEach(s => { %>
                      <div class="kanban-card border-primary border-opacity-25" 
                           draggable="true" 
                           data-drag-source="WORKSPACE" 
                           data-drag-type="TEAM" 
                           data-drag-id="<%= s.id %>"
                           data-team-id="<%= s.team_id %>"
                           data-current-status="<%= s.status %>">
                        <div class="team-schedule-card-header mb-1">
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace team-schedule-badge-team" style="font-size: 0.72rem;">
                            <%= s.team_name %>
                          </span>
                          <span class="badge bg-light text-secondary border small team-schedule-badge-author">
                            <i class="bi bi-person me-1"></i><%= s.author_name %> (<%= s.author_position || '팀원' %>)
                          </span>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark"><%= s.title %></h6>
                        <div class="small text-muted mb-2">
                          <% if (s.due_datetime) { %>
                            <i class="bi bi-clock me-1"></i><%= s.due_datetime %>
                          <% } else { %>
                            <span class="badge bg-secondary text-white"><i class="bi bi-infinity me-1"></i>상시 일정</span>
                          <% } %>
                        </div>
                        <% if (s.linked_notes && s.linked_notes.length > 0) { %>
                          <div class="mb-2 d-flex flex-wrap gap-1">
                            <% s.linked_notes.forEach(note => { %>
                              <a href="/notes?noteId=<%= note.id %>" class="badge bg-light text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="연결된 문서: <%= note.title %>">
                                <i class="bi bi-file-earmark-text"></i> <%= note.title %>
                              </a>
                            <% }) %>
                          </div>
                        <% } %>
                        <% if (s.description) { %>
                          <p class="small text-secondary preserve-lines bg-light p-2 rounded mb-2"><%= s.description %></p>
