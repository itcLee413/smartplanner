                <iframe class="custom-widget-iframe w-100 h-100 border-0" sandbox="allow-scripts" srcdoc="<%= buildCustomWidgetSrcdoc(cw.html_code, cw.css_code, cw.js_code) %>" onload="sendWsContextToIframe(this)"></iframe>
              </div>
            </div>
          </div>
