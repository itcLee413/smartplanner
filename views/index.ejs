<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WorkSmarter - 올인원 생산성 & 텔레그램 스마트 비서</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>

  <div class="app-wrapper">
    <!-- ========================================== -->
    <!-- 1. Notion-Style Left Fixed Sidebar         -->
    <!-- ========================================== -->
    <aside class="notion-sidebar" id="appSidebar">
      <!-- Sidebar Brand -->
      <div class="sidebar-brand-box d-flex align-items-center justify-content-between">
        <a href="/" class="navbar-brand-custom text-decoration-none">
          <i class="bi bi-calendar2-check-fill text-primary"></i>
          <span>WorkSmarter</span>
        </a>
        <button class="btn btn-sm btn-light" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- User Profile Box -->
      <div class="sidebar-user-box d-flex align-items-center gap-2">
        <div class="sidebar-avatar">
          <%= user.name.charAt(0) %>
        </div>
        <div class="overflow-hidden">
          <div class="fw-bold small text-truncate"><%= user.name %></div>
          <div class="text-muted smaller text-truncate">@<%= user.username %> · <span class="badge bg-light text-secondary border py-0 px-1"><%= user.role %></span></div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="p-2 flex-grow-1">
        <div class="sidebar-section-title">개인 워크스페이스</div>
        <a href="/" class="sidebar-link <%= activeMenu === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>내 대시보드</span>
        </a>
        <a href="/notes" class="sidebar-link <%= activeMenu === 'notes' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-text"></i>
          <span>세부사항 / 문서함</span>
        </a>
        <a href="/mypage" class="sidebar-link <%= activeMenu === 'mypage' ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span>마이페이지</span>
        </a>

        <div class="sidebar-section-title pt-3">팀 협업 공간</div>
        <a href="/teams" class="sidebar-link <%= activeMenu === 'teams' ? 'active' : '' %>">
          <i class="bi bi-people-fill text-primary"></i>
          <span>팀 워크스페이스</span>
          <span class="badge bg-primary text-white ms-auto rounded-pill px-2">Team</span>
        </a>

        <% if (user.role === 'ADMIN') { %>
          <div class="sidebar-section-title pt-3">시스템 관제</div>
          <a href="/admin" class="sidebar-link <%= activeMenu === 'admin' ? 'active' : '' %>">
            <i class="bi bi-shield-lock-fill text-warning"></i>
            <span>관리자 콘솔</span>
          </a>
        <% } %>
      </div>

      <!-- Sidebar Footer (Logout) -->
      <div class="sidebar-footer">
        <a href="/logout" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
          <i class="bi bi-box-arrow-right"></i>
          <span>로그아웃</span>
        </a>
      </div>
    </aside>

    <!-- Mobile Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarCollapse()"></div>

    <!-- ========================================== -->
    <!-- 2. Main Content Area                       -->
    <!-- ========================================== -->
    <div class="app-main-content">
      <!-- Top Mobile & Status Bar -->
      <header class="d-flex align-items-center justify-content-between px-4 py-2 border-bottom bg-white sticky-top">
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="toggleSidebarCollapse()" title="사이드바 접기/펼치기">
            <i class="bi bi-list fs-5"></i>
          </button>
          <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
            <i class="bi bi-speedometer2 text-primary"></i> 내 대시보드
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="btnToggleEditMode" onclick="toggleDashboardEditMode()" title="대시보드 위젯 위치 및 크기 조절">
            <i class="bi bi-pencil-square"></i>
            <span id="editModeBtnText">레이아웃 편집 모드</span>
          </button>
          <span class="badge bg-light text-dark border px-2 py-1 fw-normal">
            <i class="bi bi-person-fill text-primary me-1"></i>
            <strong><%= user.name %></strong> (<%= user.username %>)
          </span>
        </div>
      </header>

      <!-- Global Toast / Alerts -->
      <div class="container-fluid px-4 mt-3">
        <% if (errorMsg) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><%= errorMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <% if (successMsg) { %>
          <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><%= successMsg %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      </div>

      <!-- Main Container -->
      <main class="container-fluid px-4 py-2 flex-grow-1">

    <% 
      const layoutMap = {};
      if (typeof dashboardLayout !== 'undefined' && Array.isArray(dashboardLayout)) {
        dashboardLayout.forEach(item => { layoutMap[item.id] = item; });
      }
      const top3Conf = layoutMap['top3'] || { id: 'top3', x: 0, y: 0, w: 12, h: 3, enabled: true };
      const workspaceConf = layoutMap['workspace'] || { id: 'workspace', x: 0, y: 3, w: 8, h: 7, enabled: true };
      const statsConf = layoutMap['stats'] || { id: 'stats', x: 8, y: 3, w: 4, h: 4, enabled: true };
      const quickAddConf = layoutMap['quick_add'] || { id: 'quick_add', x: 8, y: 7, w: 4, h: 3, enabled: true };
      const clockConf = layoutMap['clock'] || { id: 'clock', x: 0, y: 10, w: 4, h: 2, enabled: false };
      const memoConf = layoutMap['memo'] || { id: 'memo', x: 4, y: 10, w: 4, h: 3, enabled: false };
      const curTop3 = (typeof top3List !== 'undefined' ? top3List : (typeof top3Schedules !== 'undefined' ? top3Schedules : []));
    %>

    <!-- Modular Dashboard Grid (GridStack v10) -->
    <div class="grid-stack mb-4" id="dashboardGrid">

      <!-- 1. Top 3 Widget (MIT) -->
      <% if (top3Conf && top3Conf.enabled !== false) { %>
      <div class="grid-stack-item" gs-id="top3" gs-x="<%= top3Conf.x %>" gs-y="<%= top3Conf.y %>" gs-w="<%= top3Conf.w %>" gs-h="<%= top3Conf.h %>" data-title="오늘의 핵심 목표 Top 3">
        <div class="grid-stack-item-content">
          <div class="card card-custom h-100 top3-container d-flex flex-column" id="top3-dropzone" data-widget-card="top3">
            <!-- Drag Handle Bar -->
            <div class="widget-drag-handle">
              <div class="handle-title">
                <i class="bi bi-grip-horizontal text-secondary"></i>
                <i class="bi bi-trophy-fill text-warning ms-1"></i>
                <span>오늘의 핵심 목표 Top 3</span>
              </div>
              <div class="handle-actions d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill smaller">진행 중: <%= curTop3.length %> / 3</span>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-pip-toggle" onclick="event.stopPropagation(); togglePipWidget('top3')" title="팝업(PIP) 모드로 분리">
                  <i class="bi bi-pip"></i> <span class="d-none d-sm-inline ms-1 smaller">팝업 띄우기</span>
                </button>
              </div>
            </div>
          <div class="card-body p-3 top3-dropzone-body">
            <% if (!curTop3 || curTop3.length === 0) { %>
              <div class="text-center py-5 text-muted">
                <i class="bi bi-stars fs-1 text-secondary opacity-50 mb-2 d-block"></i>
                <p class="mb-1 fw-semibold">설정된 Top 3 핵심 목표가 없습니다.</p>
                <p class="small text-secondary mb-0">하단의 개인 일정 또는 소속 팀 일정을 이곳으로 드래그 앤 드롭하여 오늘의 핵심 목표로 등록하세요!</p>
              </div>
            <% } else { %>
              <div class="row g-3">
                <% curTop3.forEach((sched, idx) => { %>
                  <div class="col-md-4">
                    <div class="card card-custom top3-card h-100 p-3 shadow-sm d-flex flex-column justify-content-between"
                         draggable="true"
                         data-drag-source="TOP3"
                         data-drag-type="<%= sched.itemType || 'PERSONAL' %>"
                         data-drag-id="<%= sched.id %>">
                      <div>
                        <!-- Header & Badges -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                          <span class="top3-badge">Top <%= idx + 1 %></span>
                          <div class="d-flex align-items-center gap-1">
                            <% if (sched.itemType === 'TEAM') { %>
                              <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.72rem;">
                                <%= sched.team_name %>
                              </span>
                            <% } else { %>
                              <span class="badge badge-cat-<%= sched.category %> border"><%= sched.category %></span>
                            <% } %>
                            <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1 top3-remove-btn" 
                                    onclick="removeTop3Schedule(event, '<%= sched.itemType || 'PERSONAL' %>', <%= sched.id %>)" 
                                    title="Top 3에서 해제 (바깥으로 끌어서 놓아도 해제됩니다)">
                              <i class="bi bi-x-lg"></i>
                            </button>
                          </div>
                        </div>
                        
                        <!-- Title & Time -->
                        <h6 class="fw-bold mb-1 text-dark text-truncate" title="<%= sched.title %>"><%= sched.title %></h6>
                        <div class="small text-muted mb-2">
                          <% if (sched.due_datetime) { %>
                            <i class="bi bi-clock me-1"></i><%= sched.due_datetime %>
                          <% } else { %>
                            <span class="badge bg-secondary text-white"><i class="bi bi-infinity me-1"></i>상시 일정</span>
                          <% } %>
                        </div>

                        <% if (sched.linked_notes && sched.linked_notes.length > 0) { %>
                          <div class="mb-2 d-flex flex-wrap gap-1">
                            <% sched.linked_notes.forEach(note => { %>
                              <a href="/notes?noteId=<%= note.id %>" class="badge bg-light text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="연결된 문서: <%= note.title %>">
                                <i class="bi bi-file-earmark-text"></i> <%= note.title %>
                              </a>
                            <% }) %>
                          </div>
                        <% } %>

                        <!-- Description Preview -->
                        <% if (sched.description) { %>
                          <div class="bg-light p-2 rounded small text-secondary preserve-lines mb-2" style="max-height: 80px; overflow-y: auto;">
                            <%= sched.description %>
                          </div>
                        <% } %>

                        <!-- Progress Bar & Subtasks Container -->
                        <div class="subtasks-container" data-schedule-id="<%= sched.id %>">
                          <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                            <span><%= sched.itemType === 'TEAM' ? '진행 상태' : '체크리스트 진행률' %></span>
                            <span class="fw-bold text-primary subtask-percent-text"><%= sched.percent %>%</span>
                          </div>
                          <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-primary subtask-progress-bar" role="progressbar" style="width: <%= sched.percent %>%;"></div>
                          </div>

                          <!-- Subtask Checklist List -->
                          <div class="mb-2" style="max-height: 120px; overflow-y: auto;">
                            <ul class="subtask-list">
                              <% if (sched.subtasks && sched.subtasks.length > 0) { %>
                                <% sched.subtasks.forEach(st => { %>
                                  <li class="subtask-item <%= st.is_done ? 'done' : '' %>" data-subtask-id="<%= st.id %>">
                                    <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-1 text-start flex-grow-1" style="font-size: 0.82rem;" onclick="toggleSubtaskAsync(event, <%= st.id %>, <%= sched.id %>)">
                                      <i class="bi <%= st.is_done ? 'bi-check-square-fill text-success' : 'bi-square text-secondary' %>"></i>
                                      <span class="text-truncate" style="max-width: 150px;"><%= st.title %></span>
                                    </button>
                                    <% if (sched.itemType === 'PERSONAL') { %>
                                      <button type="button" class="subtask-delete-btn" onclick="deleteSubtaskAsync(event, <%= st.id %>, <%= sched.id %>)" title="하위 할 일 삭제">
                                        <i class="bi bi-x"></i>
                                      </button>
                                    <% } %>
                                  </li>
                                <% }) %>
                              <% } %>
                            </ul>
                          </div>

                          <% if (sched.itemType === 'PERSONAL') { %>
                            <!-- Quick Inline Subtask Form -->
                            <form class="subtask-quick-form mb-2" onsubmit="addSubtaskAsync(event, <%= sched.id %>, this)">
                              <input type="text" name="title" class="form-control form-control-sm subtask-quick-input" placeholder="세부 할 일 직접 입력..." required>
                              <button type="submit" class="btn btn-outline-primary btn-sm subtask-quick-btn" title="할 일 추가">추가</button>
                            </form>
                          <% } %>
                        </div>
                      </div>

                      <!-- Action Buttons -->
                      <div class="pt-2 border-top mt-2">
                        <div class="d-flex gap-1 flex-wrap">
                          <!-- Select for Pomodoro -->
                          <button type="button" class="btn btn-sm btn-outline-primary flex-fill" onclick="selectPomodoroSchedule('<%= sched.id %>', '<%= sched.title.replace(/'/g, ' ') %>')">
                            <i class="bi bi-stopwatch"></i> 집중
                          </button>
                          <% if (sched.itemType === 'PERSONAL') { %>
                            <!-- Test Briefing Alert -->
                            <form action="/telegram/test-alert" method="POST" class="m-0">
                              <input type="hidden" name="schedule_id" value="<%= sched.id %>">
                              <button type="submit" class="btn btn-sm btn-outline-info text-dark" title="지금 이 일정 리치 브리핑 텔레그램 발송">
                                <i class="bi bi-send"></i> 알림
                              </button>
                            </form>
                          <% } else { %>
                            <a href="/teams?teamId=<%= sched.team_id %>" class="btn btn-sm btn-outline-secondary" title="팀 워크스페이스로 이동">
                              <i class="bi bi-box-arrow-up-right me-1"></i>팀
                            </a>
                          <% } %>
                        </div>
                      </div>

                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- 4. Quick Add Widget -->
      <% if (quickAddConf && quickAddConf.enabled !== false) { %>
      <div class="grid-stack-item" gs-id="quick_add" gs-x="<%= quickAddConf.x %>" gs-y="<%= quickAddConf.y %>" gs-w="<%= quickAddConf.w %>" gs-h="<%= quickAddConf.h %>" data-title="새 일정 빠른 등록 폼">
        <div class="grid-stack-item-content">
          <div class="card card-custom h-100 d-flex flex-column" id="widget-card-quick_add">
            <!-- Drag Handle Bar -->
            <div class="widget-drag-handle">
              <div class="handle-title">
                <i class="bi bi-grip-horizontal text-secondary"></i>
                <i class="bi bi-plus-circle-fill text-success ms-1"></i>
                <span>새 일정 빠른 등록</span>
              </div>
              <div class="handle-actions d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border smaller">Fast Add</span>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-pip-toggle" onclick="event.stopPropagation(); togglePipWidget('quick_add')" title="팝업(PIP) 모드로 분리">
                  <i class="bi bi-pip"></i> <span class="d-none d-sm-inline ms-1 smaller">팝업 띄우기</span>
                </button>
              </div>
            </div>
            <div class="card-body p-3 overflow-y-auto flex-grow-1">
              <form action="/schedules" method="POST">
              <div class="mb-2">
                <label class="form-label small fw-semibold text-secondary mb-1">
                  <i class="bi bi-folder2-open text-primary me-1"></i>등록 대상 (워크스페이스)
                </label>
                <select name="target_workspace" class="form-select form-select-sm">
                  <option value="personal" selected>개인 일정 (나만 보기)</option>
                  <% if (typeof myTeams !== 'undefined' && myTeams && myTeams.length > 0) { %>
                    <optgroup label="소속 팀 워크스페이스">
                      <% myTeams.forEach(t => { %>
                        <option value="team_<%= t.id %>">[팀] <%= t.name %> (<%= t.position || '팀원' %>)</option>
                      <% }); %>
                    </optgroup>
                  <% } %>
                </select>
              </div>

              <div class="mb-2">
                <label class="form-label small fw-semibold text-secondary mb-1">일정 제목 *</label>
                <input type="text" name="title" class="form-control form-control-sm" placeholder="예: 프로젝트 보고서 초안 완성" required>
              </div>

              <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label small fw-semibold text-secondary mb-0">마감 날짜 및 시각</label>
                  <div class="form-check form-check-inline m-0">
                    <input class="form-check-input" type="checkbox" id="personal_no_deadline" name="no_deadline" onchange="toggleDueInput(this, 'personal_due_datetime')">
                    <label class="form-check-label smaller text-secondary cursor-pointer" for="personal_no_deadline">기한 없음 (상시 일정)</label>
                  </div>
                </div>
                <input type="datetime-local" id="personal_due_datetime" name="due_datetime" class="form-control form-control-sm" required value="<%= currentKSTDate %>T18:00">
              </div>

              <div class="mb-2">
                <label class="form-label small fw-semibold text-secondary mb-1">카테고리</label>
                <select name="category" class="form-select form-select-sm">
                  <option value="업무">업무</option>
                  <option value="개인" selected>개인</option>
                  <option value="팀프로젝트">팀프로젝트</option>
                  <option value="자기계발">자기계발</option>
                </select>
              </div>

              <div class="mb-2">
                <label class="form-label small fw-semibold text-secondary mb-1">세부 메모 & 진행 순서</label>
                <textarea name="description" rows="3" class="form-control form-control-sm" placeholder="1. 자료조사&#10;2. 목차 작성&#10;3. 초안 완성"></textarea>
              </div>

              <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="is_top3" id="isTop3Input" value="1">
                <label class="form-check-label small fw-semibold text-dark" for="isTop3Input">
                  <i class="bi bi-star-fill text-warning me-1"></i>오늘의 Top 3 핵심 목표로 설정
                </label>
              </div>

              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="is_important" id="isImportantInput" value="1" checked>
                <label class="form-check-label small fw-semibold text-dark" for="isImportantInput">
                  <i class="bi bi-bell-fill text-danger me-1"></i>중요 일정 (시간 도래 시 텔레그램 알림)
                </label>
              </div>

              <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                <i class="bi bi-calendar-plus me-1"></i> 일정 추가
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- 3. Productivity Stats Widget -->
    <% if (statsConf && statsConf.enabled !== false) { %>
    <div class="grid-stack-item" gs-id="stats" gs-x="<%= statsConf.x %>" gs-y="<%= statsConf.y %>" gs-w="<%= statsConf.w %>" gs-h="<%= statsConf.h %>" data-title="카테고리별 생산성 통계 차트">
      <div class="grid-stack-item-content">
        <div class="card card-custom h-100 d-flex flex-column" id="widget-card-stats">
          <!-- Drag Handle Bar -->
          <div class="widget-drag-handle">
            <div class="handle-title">
              <i class="bi bi-grip-horizontal text-secondary"></i>
              <i class="bi bi-pie-chart-fill text-info ms-1"></i>
              <span>카테고리별 생산성 통계</span>
            </div>
            <div class="handle-actions d-flex align-items-center gap-2">
              <span class="badge bg-light text-secondary border smaller">Chart.js</span>
              <button type="button" class="btn btn-sm btn-outline-secondary btn-pip-toggle" onclick="event.stopPropagation(); togglePipWidget('stats')" title="팝업(PIP) 모드로 분리">
                <i class="bi bi-pip"></i> <span class="d-none d-sm-inline ms-1 smaller">팝업 띄우기</span>
              </button>
            </div>
          </div>
          <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1">
            <div style="min-height: 170px; height: 180px; position: relative;" class="flex-grow-1">
              <canvas id="categoryChart"></canvas>
            </div>
            <div class="row g-2 mt-2 pt-2 border-top text-center small">
              <div class="col-4">
                <div class="bg-light p-1 rounded">
